// ============================================================
// DEAR MAN CONTENT v2 — Enrichment on top of dear-man-content.cypher
// GENERATED by scripts/dear-man/build.py from scripts/dear-man/content.py. Edit content.py, not this file.
//
//   1. Feeling groups (color-coded clusters for the Express step)
//   2. New feeling chips
//   3. Mirroring text ("how this might typically make someone feel")
//      on describe options + situation types, for alexithymia support
//   4. Per-assert-option elaboration prompts
//   5. Anchor needs + a richer, tagged anchor phrase set
//      (powers the "help me find my phrase" generator)
//
// All operations use MERGE — safe to re-run.
// Chunked per Aura requirement (no variable persistence).
// Load AFTER dear-man-content.cypher.
// ============================================================


// --- CONSTRAINTS ---
CREATE CONSTRAINT dearman_feeling_group_id IF NOT EXISTS
FOR (g:DearManFeelingGroup) REQUIRE g.id IS UNIQUE;

CREATE CONSTRAINT dearman_anchor_need_id IF NOT EXISTS
FOR (n:DearManAnchorNeed) REQUIRE n.id IS UNIQUE;

// ============================================================
// 1. FEELING GROUPS
//    colorKey is a presentation hint the frontend maps to a theme token.
// ============================================================
UNWIND [
  {id: 'fgroup_hurt',    label: 'Hurt & unseen',     colorKey: 'pink',   sort: 1},
  {id: 'fgroup_angry',   label: 'Angry & fed up',    colorKey: 'rose',   sort: 2},
  {id: 'fgroup_afraid',  label: 'Anxious & on edge', colorKey: 'orange', sort: 3},
  {id: 'fgroup_sad',     label: 'Sad & alone',       colorKey: 'blue',   sort: 4},
  {id: 'fgroup_drained', label: 'Worn down',         colorKey: 'purple', sort: 5},
  {id: 'fgroup_guilt',   label: 'Guilty & small',    colorKey: 'teal',   sort: 6}
] AS g
MERGE (grp:DearManFeelingGroup {id: g.id})
SET grp.label = g.label, grp.colorKey = g.colorKey, grp.sortOrder = g.sort;

// ============================================================
// 2. NEW FEELING CHIPS (existing 18 are in dear-man-content.cypher)
// ============================================================
UNWIND [
  {id: 'feel_dismissed', label: 'Dismissed', sort: 19},
  {id: 'feel_guilty',    label: 'Guilty',    sort: 20},
  {id: 'feel_small',     label: 'Small',     sort: 21},
  {id: 'feel_nervous',   label: 'Nervous',   sort: 22}
] AS f
MERGE (chip:DearManFeelingChip {id: f.id})
SET chip.label = f.label, chip.sortOrder = f.sort;


// --- Chip → group membership ---
UNWIND [
  {chip: 'feel_hurt',         grp: 'fgroup_hurt'},
  {chip: 'feel_disappointed', grp: 'fgroup_hurt'},
  {chip: 'feel_unheard',      grp: 'fgroup_hurt'},
  {chip: 'feel_invisible',    grp: 'fgroup_hurt'},
  {chip: 'feel_disrespected', grp: 'fgroup_hurt'},
  {chip: 'feel_dismissed',    grp: 'fgroup_hurt'},
  {chip: 'feel_frustrated',   grp: 'fgroup_angry'},
  {chip: 'feel_angry',        grp: 'fgroup_angry'},
  {chip: 'feel_resentful',    grp: 'fgroup_angry'},
  {chip: 'feel_anxious',      grp: 'fgroup_afraid'},
  {chip: 'feel_scared',       grp: 'fgroup_afraid'},
  {chip: 'feel_overwhelmed',  grp: 'fgroup_afraid'},
  {chip: 'feel_confused',     grp: 'fgroup_afraid'},
  {chip: 'feel_nervous',      grp: 'fgroup_afraid'},
  {chip: 'feel_sad',          grp: 'fgroup_sad'},
  {chip: 'feel_lonely',       grp: 'fgroup_sad'},
  {chip: 'feel_helpless',     grp: 'fgroup_sad'},
  {chip: 'feel_exhausted',    grp: 'fgroup_drained'},
  {chip: 'feel_trapped',      grp: 'fgroup_drained'},
  {chip: 'feel_guilty',       grp: 'fgroup_guilt'},
  {chip: 'feel_embarrassed',  grp: 'fgroup_guilt'},
  {chip: 'feel_small',        grp: 'fgroup_guilt'}
] AS m
MATCH (chip:DearManFeelingChip {id: m.chip})
MATCH (grp:DearManFeelingGroup {id: m.grp})
MERGE (chip)-[:IN_GROUP]->(grp);

// ============================================================
// 3. MIRRORING — "how this might typically make someone feel"
//    Per describe option (specific), with a per-situation-type fallback
//    used when the user wrote their own description.
// ============================================================
UNWIND [
  {id: 'ask_need_help',
   text: "When you need help and haven't asked yet, it's common to feel overwhelmed and a little anxious about being a burden. Some people also notice resentment building — even though the other person doesn't know yet.",
   feelings: ['feel_overwhelmed', 'feel_anxious', 'feel_resentful', 'feel_exhausted']},
  {id: 'ask_not_working',
   text: "When something about how you do things together isn't working, people often feel frustrated and unheard — and sometimes trapped by a routine they didn't choose.",
   feelings: ['feel_frustrated', 'feel_unheard', 'feel_trapped']},
  {id: 'ask_time_space',
   text: 'Needing time or space and not having it tends to leave people exhausted and overwhelmed, often with some guilt about wanting it at all.',
   feelings: ['feel_exhausted', 'feel_overwhelmed', 'feel_guilty', 'feel_trapped']},
  {id: 'ask_support',
   text: 'Going through something hard and needing support often comes with loneliness and sadness — and sometimes fear that asking will push the other person away.',
   feelings: ['feel_lonely', 'feel_sad', 'feel_scared', 'feel_overwhelmed']},
  {id: 'bound_unnamed_line',
   text: "When someone keeps crossing a line you haven't named out loud, resentment usually builds quietly. Many people also feel disrespected, and a bit trapped by having let it go this long.",
   feelings: ['feel_resentful', 'feel_disrespected', 'feel_trapped', 'feel_frustrated']},
  {id: 'bound_new_thing',
   text: "When something new happens that isn't okay with you, it's common to feel hurt or disrespected, and nervous about how to respond.",
   feelings: ['feel_hurt', 'feel_disrespected', 'feel_nervous', 'feel_angry']},
  {id: 'bound_pressure',
   text: "Being pressured to do something you don't want to do often feels like being cornered. Frustration and anxiety tend to show up, along with resentment if it keeps happening.",
   feelings: ['feel_trapped', 'feel_frustrated', 'feel_anxious', 'feel_resentful']},
  {id: 'bound_overcommit',
   text: "Needing to take back a yes usually brings guilt and anxiety about letting someone down — and often exhaustion from carrying something you couldn't.",
   feelings: ['feel_guilty', 'feel_anxious', 'feel_exhausted', 'feel_overwhelmed']},
  {id: 'addr_broke_promise',
   text: "When someone doesn't follow through, people typically feel disappointed first, then frustrated — and sometimes hurt, because it can feel like you didn't matter enough.",
   feelings: ['feel_disappointed', 'feel_frustrated', 'feel_hurt']},
  {id: 'addr_hurtful',
   text: "When someone hurts you and doesn't notice, the hurt is usually right at the surface. Feeling invisible often follows, and sometimes anger that they didn't catch it.",
   feelings: ['feel_hurt', 'feel_invisible', 'feel_angry', 'feel_sad']},
  {id: 'addr_dismissed',
   text: "Telling someone how you feel and being dismissed often leaves people feeling unheard and disrespected. It's common to feel hurt, and then angry that you opened up at all.",
   feelings: ['feel_unheard', 'feel_dismissed', 'feel_hurt', 'feel_angry']},
  {id: 'addr_no_consult',
   text: 'When a decision that affects you is made without you, people often feel disrespected and invisible — and sometimes helpless, like it was already out of your hands.',
   feelings: ['feel_disrespected', 'feel_invisible', 'feel_helpless', 'feel_frustrated']},
  {id: 'patt_keeps_doing',
   text: "When someone keeps doing something you've asked them to stop, frustration and resentment are almost universal. Underneath is often the sense of not being heard.",
   feelings: ['feel_frustrated', 'feel_resentful', 'feel_unheard', 'feel_disrespected']},
  {id: 'patt_shuts_down',
   text: "When they shut down or blow up every time, it's common to feel helpless and exhausted before the conversation even starts — and anxious about trying again.",
   feelings: ['feel_helpless', 'feel_exhausted', 'feel_anxious', 'feel_frustrated']},
  {id: 'patt_avoids',
   text: 'When the conversation keeps getting avoided, people often feel unheard and invisible, then frustrated — and lonely inside the relationship.',
   feelings: ['feel_unheard', 'feel_invisible', 'feel_frustrated', 'feel_lonely']},
  {id: 'patt_one_sided',
   text: "When effort feels one-sided, resentment and exhaustion tend to build. Many people also feel lonely and, underneath, sad about wanting more than they're getting.",
   feelings: ['feel_resentful', 'feel_exhausted', 'feel_lonely', 'feel_sad']}
] AS m
MATCH (opt:DearManDescribeOption {id: m.id})
SET opt.mirrorText = m.text, opt.typicalFeelingIds = m.feelings;

// --- Situation-type fallback (used when the description is custom) ---
UNWIND [
  {id: 'ask',
   text: "Asking for something you need usually brings up a mix: some anxiety about how it'll land, sometimes guilt for needing it at all, and often relief once it's finally out.",
   feelings: ['feel_anxious', 'feel_guilty', 'feel_overwhelmed']},
  {id: 'boundary',
   text: "Setting a boundary often comes with guilt and anxiety about the other person's reaction, on top of the frustration or resentment that made the boundary necessary in the first place.",
   feelings: ['feel_anxious', 'feel_guilty', 'feel_resentful', 'feel_trapped']},
  {id: 'address',
   text: "Bringing up something that happened usually means there's hurt underneath, along with frustration or anger about it, and some nervousness about reopening it.",
   feelings: ['feel_hurt', 'feel_frustrated', 'feel_nervous']},
  {id: 'pattern',
   text: "Addressing a pattern that keeps repeating often means feeling exhausted and unheard, with resentment that's built up over time.",
   feelings: ['feel_exhausted', 'feel_unheard', 'feel_resentful']}
] AS m
MATCH (s:DearManSituationType {id: m.id})
SET s.mirrorText = m.text, s.typicalFeelingIds = m.feelings;

// ============================================================
// 4. ASSERT ELABORATION PROMPTS
// ============================================================
UNWIND [
  {id: 'ask_specific_help',   prompt: 'What kind of help, and by when?'},
  {id: 'ask_flexibility',     prompt: 'What would that look like in practice?'},
  {id: 'ask_change_how',      prompt: 'What would you like to be different?'},
  {id: 'ask_just_listen',     prompt: "Anything you want them to know about what you don't need right now (advice, fixing)?"},
  {id: 'bound_stop_behavior', prompt: 'When does it usually happen?'},
  {id: 'bound_respect_no',    prompt: 'What does respecting it look like — no follow-up questions, no guilt trips?'},
  {id: 'bound_cant_do',       prompt: 'Is there anything you can offer instead?'},
  {id: 'bound_need_space',    prompt: 'How much space, and how will you let them know?'},
  {id: 'addr_follow_through', prompt: 'Which commitment, and by when?'},
  {id: 'addr_acknowledge',    prompt: 'What specifically do you want acknowledged?'},
  {id: 'addr_check_first',    prompt: 'Which kinds of decisions?'},
  {id: 'addr_hear_me',        prompt: 'What does listening look like to you — no interrupting, no explaining?'},
  {id: 'patt_actually_stop',  prompt: "What would 'actually changed' look like a month from now?"},
  {id: 'patt_stay_in_it',     prompt: 'What could they do instead of leaving or shutting down?'},
  {id: 'patt_more_effort',    prompt: 'What would more effort look like, concretely?'},
  {id: 'patt_new_approach',   prompt: 'Any ideas for what the new way could be?'}
] AS a
MATCH (opt:DearManAssertOption {id: a.id})
SET opt.elaboratePrompt = a.prompt;

// ============================================================
// 5. ANCHOR NEEDS — "What do you most need to hear when it gets hard?"
//    Each need is linked to the barriers it most often answers.
// ============================================================
UNWIND [
  {id: 'need_permission', label: "That I'm allowed to ask",               sort: 1, barriers: ['barrier_guilty', 'barrier_no_right', 'myth_deserve', 'myth_weak', 'myth_last']},
  {id: 'need_reaction',   label: "That their reaction isn't mine to fix", sort: 2, barriers: ['barrier_angry', 'myth_matter']},
  {id: 'need_steady',     label: 'That I can stay steady',                sort: 3, barriers: ['barrier_emotional']},
  {id: 'need_imperfect',  label: "That I don't have to say it perfectly", sort: 4, barriers: ['barrier_dont_know']},
  {id: 'need_different',  label: 'That this time can be different',       sort: 5, barriers: ['barrier_tried_before']},
  {id: 'need_matters',    label: 'That this is worth saying',             sort: 6, barriers: ['myth_know']}
] AS n
MERGE (need:DearManAnchorNeed {id: n.id})
SET need.label = n.label, need.sortOrder = n.sort, need.barrierIds = n.barriers;

// ============================================================
// 6. ANCHOR PHRASES — tagged by need + barrier
//    (retags the original four, adds the rest)
// ============================================================
UNWIND [
  {id: 'anchor_needs_valid',       label: 'My needs are valid',                                 sort: 1,  needs: ['need_permission'],                   barriers: ['barrier_guilty', 'barrier_no_right', 'myth_deserve', 'myth_last']},
  {id: 'anchor_allowed',           label: "I'm allowed to want this",                           sort: 2,  needs: ['need_permission'],                   barriers: ['barrier_guilty', 'barrier_no_right', 'myth_deserve']},
  {id: 'anchor_burden',            label: "Asking isn't a burden. Guessing is.",                sort: 3,  needs: ['need_permission'],                   barriers: ['barrier_guilty']},
  {id: 'anchor_clear_is_kind',     label: 'Clear is kind',                                      sort: 4,  needs: ['need_permission', 'need_imperfect'], barriers: ['barrier_guilty', 'barrier_no_right']},
  {id: 'anchor_their_feelings',    label: 'Their feelings are theirs to hold',                  sort: 5,  needs: ['need_reaction'],                     barriers: ['barrier_angry']},
  {id: 'anchor_anger_not_verdict', label: "Their anger isn't a verdict on me",                  sort: 6,  needs: ['need_reaction'],                     barriers: ['barrier_angry']},
  {id: 'anchor_hear_no',           label: 'I can hear a no and still be okay',                  sort: 7,  needs: ['need_reaction', 'need_different'],   barriers: ['barrier_angry', 'barrier_tried_before', 'myth_matter']},
  {id: 'anchor_stay_kind_firm',    label: 'I can be kind and still not back down',              sort: 8,  needs: ['need_reaction', 'need_steady'],      barriers: ['barrier_angry', 'barrier_guilty']},
  {id: 'anchor_stay_with',         label: 'I can stay with this',                               sort: 9,  needs: ['need_steady'],                       barriers: ['barrier_emotional']},
  {id: 'anchor_tears_ok',          label: "Tears don't cancel the point",                       sort: 10, needs: ['need_steady'],                       barriers: ['barrier_emotional']},
  {id: 'anchor_breathe_return',    label: 'Breathe, then come back to the ask',                 sort: 11, needs: ['need_steady'],                       barriers: ['barrier_emotional', 'barrier_angry']},
  {id: 'anchor_feet',              label: 'Feet on the floor. Say the thing.',                  sort: 12, needs: ['need_steady', 'need_imperfect'],     barriers: ['barrier_emotional', 'barrier_dont_know']},
  {id: 'anchor_slow',              label: "I can go slow. I don't have to rush.",               sort: 13, needs: ['need_steady', 'need_imperfect'],     barriers: ['barrier_emotional', 'barrier_dont_know']},
  {id: 'anchor_one_sentence',      label: 'One clear sentence is enough',                       sort: 14, needs: ['need_imperfect'],                    barriers: ['barrier_dont_know']},
  {id: 'anchor_messy_ok',          label: 'Messy and honest beats polished and silent',         sort: 15, needs: ['need_imperfect'],                    barriers: ['barrier_dont_know', 'barrier_emotional']},
  {id: 'anchor_wrote_it_down',     label: 'I wrote it down because it matters',                 sort: 16, needs: ['need_imperfect', 'need_matters'],    barriers: ['barrier_dont_know']},
  {id: 'anchor_this_time',         label: "This time, I'm asking differently",                  sort: 17, needs: ['need_different'],                    barriers: ['barrier_tried_before']},
  {id: 'anchor_not_the_past',      label: "I'm here for this conversation, not the last five",  sort: 18, needs: ['need_different'],                    barriers: ['barrier_tried_before']},
  {id: 'anchor_one_ask',           label: 'One ask. This one.',                                 sort: 19, needs: ['need_different', 'need_imperfect'],  barriers: ['barrier_tried_before', 'barrier_dont_know']},
  {id: 'anchor_worth_saying',      label: 'This is worth saying',                               sort: 20, needs: ['need_matters'],                      barriers: []},
  {id: 'anchor_matters_to_me',     label: "This matters to me, and that's reason enough",       sort: 21, needs: ['need_matters', 'need_permission'],   barriers: ['barrier_no_right']},
  {id: 'anchor_future_me',         label: 'Future me will be glad I said it',                   sort: 22, needs: ['need_matters'],                      barriers: []},
  {id: 'anchor_human',             label: 'Needing things is human, not weak',                  sort: 23, needs: ['need_permission'],                   barriers: ['myth_weak', 'myth_last']},
  {id: 'anchor_this_ask',          label: 'Their no is about this ask, not about me',           sort: 24, needs: ['need_reaction'],                     barriers: ['myth_matter']},
  {id: 'anchor_kinder_than_guess', label: 'Saying it clearly is kinder than hoping they guess', sort: 25, needs: ['need_permission', 'need_matters'],   barriers: ['myth_know']}
] AS a
MERGE (p:DearManAnchorPhrase {id: a.id})
SET p.label = a.label, p.sortOrder = a.sort, p.needIds = a.needs, p.barrierIds = a.barriers;

// --- Phrase → need relationships (for traversal) ---
MATCH (p:DearManAnchorPhrase)
WHERE p.needIds IS NOT NULL
UNWIND p.needIds AS needId
MATCH (n:DearManAnchorNeed {id: needId})
MERGE (p)-[:ANSWERS_NEED]->(n);

// --- Phrase → barrier relationships ---
MATCH (p:DearManAnchorPhrase)
WHERE p.barrierIds IS NOT NULL
UNWIND p.barrierIds AS barrierId
MATCH (b:DearManBarrier {id: barrierId})
MERGE (p)-[:HELPS_WITH]->(b);

// --- Generator intro text (stored on the TherapyConcept) ---
MATCH (tc:TherapyConcept {id: 'dbt_dear_man'})
SET tc.anchorGeneratorIntro = 'An anchor phrase is one short line you can say to yourself when the conversation gets hard. The best ones answer the specific thing your brain will try to tell you in that moment.',
    tc.anchorGeneratorMakeItYours = "Edit the words until it sounds like something you'd actually say to yourself. Shorter is better — you want it to fit in one breath.";
