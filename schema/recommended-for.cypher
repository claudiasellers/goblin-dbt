UNWIND [{c: "dbt_tipp", side: "both", kind: "body", dir: "down"}, {c: "dbt_stop", side: "both", kind: "hold", dir: "down"}, {c: "se_orienting", side: "acceptance", kind: "orient", dir: "orient"}, {c: "urge_surfing", side: "acceptance", kind: "hold", dir: "neutral"}, {c: "dbt_opposite_action", side: "change", kind: "change", dir: "neutral"}, {c: "dbt_find_the_feeling", side: "acceptance", kind: "naming", dir: "neutral"}, {c: "dbt_problem_solving", side: "change", kind: "change", dir: "neutral"}, {c: "dbt_dear_man", side: "change", kind: "relational", dir: "neutral"}, {c: "dbt_recovering_from_invalidation", side: "both", kind: "relational", dir: "neutral"}, {c: "dbt_wise_mind", side: "both", kind: "naming", dir: "neutral"}, {c: "dbt_cope_ahead", side: "change", kind: "change", dir: "neutral"}, {c: "dbt_check_facts", side: "change", kind: "change", dir: "neutral"}, {c: "dbt_alternate_rebellion", side: "acceptance", kind: "redirect", dir: "neutral"}, {c: "dbt_fast", side: "both", kind: "values", dir: "neutral"}, {c: "dbt_saying_no", side: "change", kind: "relational", dir: "neutral"}, {c: "dbt_radical_acceptance", side: "acceptance", kind: "hold", dir: "neutral"}, {c: "dbt_please", side: "both", kind: "body", dir: "neutral"}, {c: "dbt_accepts", side: "acceptance", kind: "hold", dir: "neutral"}, {c: "dbt_give", side: "change", kind: "relational", dir: "neutral"}] AS row
MATCH (tc:TherapyConcept {id: row.c})
SET tc.side = row.side, tc.skillKind = row.kind, tc.direction = row.dir;

// --- 2. Blank patterns (never calmed) ---
UNWIND [{p: "conservation_freeze", blank: true}, {p: "dissociation_overmodulation", blank: true}, {p: "reward_drive_low", blank: true}, {p: "acute_alarm", blank: false}, {p: "chronic_vigilance", blank: false}, {p: "emotional_flooding", blank: false}, {p: "social_threat_shame", blank: false}, {p: "rumination_loop", blank: false}, {p: "reactive_aggression", blank: false}, {p: "grief_yearning", blank: false}] AS row
