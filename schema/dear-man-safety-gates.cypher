// ============================================================
// DEAR MAN SAFETY GATES — copy for the band gate in DEAR MAN
// GENERATED by scripts/dear-man/build.py from scripts/dear-man/content.py. Edit content.py, not this file.
//
//   dear-man-safety-v3 (A4-4): DEAR MAN no longer asks a 0–10 rating
//   and no longer reads Recover's numeric thresholds. It gates on the
//   capacity band (schema/capacity.cypher: BandRule dear-man:steady
//   full · stirred full + summary heads-up · flooded P2 hand-off),
//   carried from a check-in within 20 minutes (the probe is out since
//   30 Sep). This file holds only the DEAR MAN-specific lines: the
//   carried-over context card, the one-message note and the "still
//   loud" heads-up on the finished plan (shown when the band isn't
//   steady).
//
//   The plan is never locked. Someone who worked through the whole
//   plan while stirred gets a heads-up that it won't land the way they
//   mean it, and an optional 30-second breath to take the edge off.
//   (v1 locked the plan for 20 minutes; that punished the effort and
//   pushed people to send without the plan.)
//
//   handoffSituationId names the DearManSituationType a handoff from
//   "Recover from a hurtful moment" preselects ('address' is defined
//   in dear-man-content.cypher).
//
// All operations use MERGE + SET — safe to re-run.
// Chunked per Aura requirement (no variable persistence).
// Load AFTER dear-man-content.cypher and invalidation-recovery.cypher.
// ============================================================


// --- CONSTRAINTS ---
CREATE CONSTRAINT dearman_safety_copy_id IF NOT EXISTS
FOR (c:DearManSafetyCopy) REQUIRE c.id IS UNIQUE;


// ============================================================
// 1. SAFETY COPY
//    {emotion} / {need} / {minutes} are filled by the frontend.
// ============================================================

MERGE (c:DearManSafetyCopy {id: 'dear_man_safety_copy'})
SET c.version = 'dear-man-safety-v3',
    c.handoffSituationId = 'address',
    c.carriedOver = 'Carried over: {emotion} · you needed {need}',
    c.carriedOverDismiss = 'Hide',
    c.oneMessageOnly = 'One message only. Say it once, then give them room to answer.',
    c.hotHeading = "Your plan is ready. Heads up: it's still loud in there.",
    c.hotBody = "When you're this angry or worked up, even a good plan comes out sharper than you mean it, and they'll hear the anger before they hear the ask. Taking the edge off first makes it more likely you get what you're asking for.",
    c.hotCoolDown = 'Take the edge off (about 30 seconds)',
    c.hotReady = "I'm good to go",
    c.hotBodyCue = 'Unclench your jaw and drop your shoulders while you read it through.',
    c.hotCooled = "That's the edge off. Read your plan once more, out loud if you can, then go when it feels right.",
    c.personWho = 'Who is this conversation with?',
    c.personNew = 'Someone new',
    c.personNameLabel = 'What do you call them?',
    c.personNameHint = 'A nickname is fine. No real names needed.',
    c.personRoleLabel = 'Who are they to you?',
    c.personKeepLine = 'The app will remember {who} for next time: the name you gave, who they are to you, and your answer about safety. Nothing else.',
    c.personNoNameLine = 'Without a name, nothing about them is kept.',
    c.personSignedOutLine = 'This stays on this screen only.',
    c.personGoOn = 'Go on',
    c.personChanged = 'Things changed with someone?',
    c.personChangedHint = "Pick who it is, and you'll be asked about them again.",
    c.safeQuestion = 'Is it safe to bring hard things up with {who}?',
    c.safeYes = 'Yes, mostly',
    c.safeNo = 'No',
    c.safeUnsure = 'Not sure',
    c.riskQuestion = 'Is it more that they might hurt or control you, or that it tends to go badly?',
    c.riskHarm = 'They might hurt or control me',
    c.riskBadly = 'It tends to go badly',
    c.riskUnsaid = "I'd rather not say",
    c.safetyRouteHeading = 'Planning a hard talk with {who} can wait. Your safety comes first.',
    c.safetyRouteBody = "The people below can help you think it through, any time, and you don't have to be sure.",
    c.safetyRouteEnding = 'Thinking about ending the relationship',
    c.safetyRouteBack = 'This is about someone else',
    c.badlyHeadsUp = 'When talks with them tend to go badly, it can help to keep it short, about one thing, and in writing if that suits.'
REMOVE c.planLocked, c.planUnlocked, c.planLockedHeading;
// The old number-scale copy (intensityQuestion, intensityHint, intensityLow, intensityHigh,
// downshiftLead, rerateQuestion, rerateHint) is no longer set, but stays on the live node for one
// release: a tab still running the pre-M3 page skips DEAR MAN's arousal check without it (Codex,
// PR #17). Remove it in the next content release.


// ============================================================
// 2. LINK TO THE DEAR MAN THERAPY CONCEPT (traceability)
// ============================================================

MATCH (c:DearManSafetyCopy {id: 'dear_man_safety_copy'}), (tc:TherapyConcept {id: 'dbt_dear_man'})
MERGE (tc)-[:HAS_SAFETY_COPY]->(c);
