// @corpus-json [{"id": "ci_disgust_l4_1", "text": "You took a hit like this before. Pulling away is survival.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 60, "underneath": []}, {"id": "ci_disgust_l4_2", "text": "This left a mark last time. Disgust is guarding you.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 61, "underneath": []}, {"id": "ci_disgust_l4_3", "text": "Your boundaries are being pushed. Disgust is the wall.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 62, "underneath": []}, {"id": "ci_disgust_l5_1", "text": "Disgust is the body saying no. Listen to it.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 63, "underneath": []}, {"id": "ci_disgust_l5_2", "text": "Anyone looking at this would want to walk away.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 64, "underneath": []}, {"id": "ci_disgust_l5_3", "text": "Of course you want distance. It is toxic.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 65, "underneath": []}, {"id": "ci_shame_l4_1", "text": "You were judged harshly before. The shame is an echo.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 66, "underneath": []}, {"id": "ci_shame_l4_2", "text": "Mistakes used to cost you everything. Shame is bracing for impact.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 67, "underneath": []}, {"id": "ci_shame_l4_3", "text": "Hiding kept you safe in the past. It makes sense you want to run.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 68, "underneath": []}, {"id": "ci_shame_l5_1", "text": "You feel exposed. Shame is the natural result.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 69, "underneath": []}, {"id": "ci_shame_l5_2", "text": "Anyone under this spotlight would want to disappear.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 70, "underneath": []}, {"id": "ci_shame_l5_3", "text": "You feel exposed, and shame is the alarm. It makes complete sense.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 71, "underneath": []}, {"id": "ci_guilt_l4_1", "text": "You actually care about doing right. That is why this hurts.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 72, "underneath": []}, {"id": "ci_guilt_l4_2", "text": "You hold yourself to a standard. The guilt is the gap.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 73, "underneath": []}, {"id": "ci_guilt_l4_3", "text": "You protect people. When you can't, guilt is what you feel.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 74, "underneath": []}, {"id": "ci_guilt_l5_1", "text": "You crossed your own line. The guilt is doing its job.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 75, "underneath": []}, {"id": "ci_guilt_l5_2", "text": "Anyone with a conscience would feel this right now.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 76, "underneath": []}, {"id": "ci_guilt_l5_3", "text": "Of course this stopped you in your tracks. You care about the impact.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 77, "underneath": []}, {"id": "ci_envy_l4_1", "text": "You have gone without for a long time. Envy is the bill.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 78, "underneath": []}, {"id": "ci_envy_l4_2", "text": "You wanted this, and they got it. The sting is real.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 79, "underneath": []}, {"id": "ci_envy_l4_3", "text": "A need has been starved. Envy is entirely logical.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 80, "underneath": []}, {"id": "ci_envy_l5_1", "text": "They have what you want. Envy is the math of that.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 81, "underneath": []}, {"id": "ci_envy_l5_2", "text": "Anyone looking at what they have would want it too.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 82, "underneath": []}, {"id": "ci_envy_l5_3", "text": "Of course it hurts to watch someone else get it.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 83, "underneath": []}, {"id": "ci_jealousy_l4_1", "text": "You have been dropped before. Jealousy is guarding the door.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 84, "underneath": []}, {"id": "ci_jealousy_l4_2", "text": "Trust has cost you in the past. Your guard is up.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 85, "underneath": []}, {"id": "ci_jealousy_l4_3", "text": "You lost a connection once. Fearing it now makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 86, "underneath": []}, {"id": "ci_jealousy_l5_1", "text": "This relationship is at risk. Jealousy is the alarm.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 87, "underneath": []}, {"id": "ci_jealousy_l5_2", "text": "Anyone facing this loss would want to hold on.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 88, "underneath": []}, {"id": "ci_jealousy_l5_3", "text": "Of course you want to hold on. They matter to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 89, "underneath": []}]
