// @corpus-json [{"id": "ci_love_l4_1", "text": "If this person has meant a lot to you, the pull toward them makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 90, "underneath": []}, {"id": "ci_love_l4_2", "text": "When someone has been part of your life, love doesn't switch off.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 91, "underneath": []}, {"id": "ci_love_l4_3", "text": "If this love goes back a long way, it makes sense that it runs deep.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 92, "underneath": []}, {"id": "ci_love_l5_1", "text": "Love makes sense. This person matters to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 93, "underneath": []}, {"id": "ci_love_l5_2", "text": "Anyone who cares this much could feel this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 94, "underneath": []}, {"id": "ci_love_l5_3", "text": "Of course you feel pulled toward them.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 95, "underneath": []}, {"id": "ci_l3_anger_hurt", "text": "Maybe some of this anger is hurt underneath.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 96, "underneath": ["hurt"]}, {"id": "ci_l3_anger_fear", "text": "There might be some fear under the anger too.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 97, "underneath": ["fear"]}, {"id": "ci_l3_shame_rejection", "text": "Maybe part of this is a fear of being pushed away.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 98, "underneath": ["rejection"]}, {"id": "ci_l3_numb_overwhelm", "text": "Maybe numb is what too much at once feels like.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 99, "underneath": ["overwhelm"]}, {"id": "ci_l3_jealousy_fear", "text": "Maybe under the jealousy is a fear of losing them.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 100, "underneath": ["fear"]}, {"id": "ci_l3_envy_sadness", "text": "Maybe some of this is sadness about what's been missing.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 101, "underneath": ["sadness"]}, {"id": "ci_l6_1", "text": "You can feel this and still choose your next step.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 102, "underneath": []}, {"id": "ci_l6_2", "text": "You can let this be here for a few minutes.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 103, "underneath": []}, {"id": "ci_l6_3", "text": "You know yourself. You can pick what helps from here.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 104, "underneath": []}, {"id": "ci_l6_4", "text": "You get to decide what this moment needs.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 105, "underneath": []}, {"id": "ci_l6_5", "text": "You can take this one small step at a time.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 106, "underneath": []}, {"id": "ci_l6_6", "text": "This is hard, and you can meet it your own way.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 107, "underneath": []}, {"id": "ci_flooded_1", "text": "A lot, right now.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 108, "underneath": []}, {"id": "ci_flooded_2", "text": "This is a lot.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 109, "underneath": []}, {"id": "ci_flooded_3", "text": "No rush here.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 110, "underneath": []}, {"id": "ci_flooded_4", "text": "Nothing to figure out yet.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 111, "underneath": []}, {"id": "ci_flooded_5", "text": "It can be loud for a moment.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 112, "underneath": []}, {"id": "ci_flooded_6", "text": "Slow is fine here.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 113, "underneath": []}, {"id": "ci_flooded_7", "text": "It feels like too much.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 114, "underneath": []}, {"id": "ci_flooded_8", "text": "Big and fast, all at once.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 115, "underneath": []}, {"id": "ci_flooded_9", "text": "Hard to think right now.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 116, "underneath": []}, {"id": "ci_flooded_10", "text": "Everything is turned up right now.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 117, "underneath": []}, {"id": "ci_flooded_11", "text": "So much, so fast.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 118, "underneath": []}, {"id": "ci_flooded_12", "text": "Loud inside, right now.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 119, "underneath": []}]
