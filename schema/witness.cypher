// constraints.cypher. Lines dropped from the source are retired, never deleted.
// ============================================================

// --- Tool moments ---
UNWIND [{id: "checkin_result", hostToolId: "checkin", label: "Check-in result"}, {id: "recover_validate", hostToolId: "recovering-from-invalidation", label: "Recover: this makes sense"}, {id: "oa_start", hostToolId: "opposite-action", label: "Opposite Action: before the urge"}, {id: "ps_define", hostToolId: "problem-solve", label: "Problem Solve: before defining the problem"}, {id: "dearman_describe", hostToolId: "dear-man", label: "DEAR MAN: before Describe"}, {id: "debrief_turning_point", hostToolId: "dear-man", label: "DEAR MAN debrief: the turning point"}, {id: "missed_followup", hostToolId: "today", label: "A follow-up that didn't happen"}, {id: "urge_louder", hostToolId: "opposite-action", label: "The urge went up"}, {id: "crisis", hostToolId: "checkin", label: "Crisis banner (level 1 only; CORE-01)"}] AS row
MERGE (m:ToolMoment {id: row.id})
SET m.hostToolId = row.hostToolId, m.label = row.label;

// --- Voice rules (traceability; the lint reads scripts/witness/voice-rules.json) ---
UNWIND [{id: "no_interpretation", pattern: "\\byou're right\\b|\\bthey were wrong\\b|\\bit was (unkind|wrong)\\b|\\bthis was wrong\\b|\\bthey don't care\\b|\\bthey meant\\b", flags: "i", severityJson: "{\"validation\": \"report\"}", message: "Validate the feeling, never an interpretation or another person's intent.", ruleVersion: "voice-v1"}, {id: "no_cheer", pattern: "great job|amazing|proud of you|awesome|well done|!", flags: "i", severityJson: "{\"validation\": \"warn\", \"feeling_copy\": \"error\", \"user_copy\": \"warn\"}", message: "No cheer on feelings, no exclamation marks.", ruleVersion: "voice-v1"}, {id: "no_emoji", pattern: "[\\u{1F000}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B50}\\u{2728}]", flags: "u", severityJson: "{\"validation\": \"warn\", \"feeling_copy\": \"error\"}", message: "No emoji in validation or feeling copy.", ruleVersion: "voice-v1"}, {id: "and_not_but", pattern: "[,.;:] but\\b", flags: "i", severityJson: "{\"validation\": \"report\"}", message: "And, not but: a second clause never takes the first one back.", ruleVersion: "voice-v1"}, {id: "no_should", pattern: "\\bshould\\b", flags: "i", severityJson: "{\"validation\": \"warn\", \"feeling_copy\": \"warn\", \"user_copy\": \"warn\"}", message: "No shoulds.", ruleVersion: "voice-v1"}, {id: "no_diagnosis", pattern: "\\boverreact\\w*|\\boversensitiv\\w*", flags: "i", severityJson: "{\"validation\": \"error\"}", message: "No diagnosis words.", ruleVersion: "voice-v1"}, {id: "voice_distance", pattern: "\\bI\\b|\\b[Mm]y\\b|\\b[Mm]e\\b|\\bI'(m|ve|ll|d)\\b", flags: "", severityJson: "{\"validation\": \"warn\"}", message: "App lines speak as a witness (you, or the user's name); first person only in lines the user writes.", ruleVersion: "voice-v1"}, {id: "no_magnitude", pattern: "\\b(crush(ing|ed)?|heav(y|ier|iness)|weigh(t|ts|s|ing|ed)|furious|fury|massive|extreme(ly)?|enormous|huge|immense|unbearabl[ey]|devastat\\w*|overpowering|intens(e|ely|ity)|tremendous|excruciating|agoni[sz]\\w*|deep(ly)? (hurt|pain|sad\\w*|shame|grief)|(too|so|very|really) loud|loud(er|est)?( inside| in there)?|turned up|spik(ed|ing))\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"feeling_copy\": \"report\", \"user_copy\": \"report\"}", message: "Never validate the intensity or volume of a feeling (crushing, heavy, furious, massive, extreme, loud…). Validate the trigger and that the feeling is there (Claudia's rule 4).", ruleVersion: "voice-v1"}, {id: "slots", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "Only {N} {word} {phrase} {need}; textNamed has {N} exactly when voice is name; text never has {N}.", ruleVersion: "voice-v1"}, {id: "level3_tentative", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "Level 3 is a guess: tentative, with at least one UNDERNEATH emotion.", ruleVersion: "voice-v1"}, {id: "reviewed_live", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "A live line has been reviewed (reviewStatus reviewed, reviewedAt set).", ruleVersion: "voice-v1"}, {id: "receive_before_change", pattern: null, flags: null, severityJson: "{\"flow\": \"error\"}", message: "In a flow that declares step kinds, a receive step precedes any change step.", ruleVersion: "voice-v1"}, {id: "skip_always", pattern: null, flags: null, severityJson: "{\"component\": \"error\"}", message: "The receive beat always renders skip, none of these fit and say it my way.", ruleVersion: "voice-v1"}] AS row
MERGE (v:VoiceRule {id: row.id})
SET v.pattern = row.pattern, v.flags = row.flags, v.severityJson = row.severityJson, v.message = row.message, v.ruleVersion = row.ruleVersion;

// --- Lines (batches; each preceded by its corpus JSON for the lint) ---
// @corpus-json [{"id": "rv_not_received_1", "text": "Of course that stung. You tried to speak and hit a wall.", "textNamed": "{N}, of course that stung. You tried to speak and hit a wall.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 0, "underneath": []}, {"id": "rv_not_received_2", "text": "It hurts to be ignored. Anyone would feel this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 1, "underneath": []}, {"id": "rv_not_received_3", "text": "The hurt is real. The story you are spinning about it might not be.", "textNamed": "The hurt is real. The story {N} is spinning about it might not be.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 2, "underneath": []}, {"id": "rv_not_received_4", "text": "They didn't hear you. You can accept that without turning them into a monster.", "textNamed": "They didn't hear {N}. {N} can accept that without turning them into a monster.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 3, "underneath": []}, {"id": "rv_diminished_self_1", "text": "That landed on you. It is normal to feel rattled.", "textNamed": "{N}, that landed on you. It is normal to feel rattled.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 4, "underneath": []}, {"id": "rv_diminished_self_2", "text": "The hit was real. It doesn't mean you are broken.", "textNamed": "The hit was real. It doesn't mean {N} is broken.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 5, "underneath": []}, {"id": "rv_diminished_self_3", "text": "Feeling small right now does not make you small.", "textNamed": "Feeling small right now does not make {N} small.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 6, "underneath": []}, {"id": "rv_diminished_self_4", "text": "You are sensitive to this, and it actually hurt. Both are true.", "textNamed": "{N} is sensitive to this, and it actually hurt. Both are true.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 7, "underneath": []}, {"id": "rv_blocked_wronged_1", "text": "Something mattered and it got blocked. The anger makes complete sense.", "textNamed": "{N}, something mattered and it got blocked. The anger makes complete sense.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 8, "underneath": []}, {"id": "rv_blocked_wronged_2", "text": "You know this was unfair. You do not need to replay it all night to prove it.", "textNamed": "{N} knows this was unfair. {N} does not need to replay it all night to prove it.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 9, "underneath": []}, {"id": "rv_blocked_wronged_3", "text": "The anger is justified. You still have to decide the next move.", "textNamed": "The anger is justified. {N} still has to decide the next move.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 10, "underneath": []}, {"id": "rv_blocked_wronged_4", "text": "That felt unfair. You still get to choose the next move.", "textNamed": "That felt unfair. {N} still gets to choose the next move.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 11, "underneath": []}, {"id": "rv_attachment_alarm_1", "text": "Of course you are scared. Losing connection trips a survival wire.", "textNamed": "{N}, of course you are scared. Losing connection trips a survival wire.", "level": 4, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 12, "underneath": []}, {"id": "rv_attachment_alarm_2", "text": "This is real pain. Being pushed away hurts everyone.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 13, "underneath": []}, {"id": "rv_attachment_alarm_3", "text": "You can feel this fear without chasing them down.", "textNamed": "{N} can feel this fear without chasing them down.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 14, "underneath": []}, {"id": "rv_attachment_alarm_4", "text": "You are scared of losing them. That does not mean the relationship is over.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 15, "underneath": []}, {"id": "oa_fear_function", "text": "Fear wants you to run. It thinks it is keeping you alive.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 16, "underneath": []}, {"id": "oa_anger_function", "text": "Anger is arming you for a fight because a boundary got crossed.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 17, "underneath": []}, {"id": "oa_sadness_function", "text": "Sadness is shutting you down. Something real is gone.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 18, "underneath": []}, {"id": "oa_disgust_function", "text": "Disgust is physically rejecting this. It says this is toxic.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 19, "underneath": []}, {"id": "oa_shame_function", "text": "Shame wants you to hide so you survive the group. It makes sense.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 20, "underneath": []}, {"id": "oa_guilt_function", "text": "Guilt is a compass. It says you violated your own rules.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 21, "underneath": []}, {"id": "oa_jealousy_function", "text": "Jealousy is trying to grip a connection that feels threatened.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 22, "underneath": []}, {"id": "oa_envy_function", "text": "Envy is pointing at what you do not have. Wanting it is normal.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 23, "underneath": []}, {"id": "oa_love_function", "text": "Love is a magnet. Of course you feel pulled toward them.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 24, "underneath": []}, {"id": "ps_fear_receive", "text": "The threat is real. Your fear is pointing at it.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 25, "underneath": []}, {"id": "ps_anger_receive", "text": "A boundary got crossed. The anger is just math.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 26, "underneath": []}, {"id": "ps_sadness_receive", "text": "You lost something. The sadness fits the facts.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 27, "underneath": []}, {"id": "ps_guilt_receive", "text": "You broke a rule you actually care about. Listen to the guilt.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 28, "underneath": []}, {"id": "ps_shame_receive", "text": "Shame says you are defective. You feel it, but it is not a fact.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 29, "underneath": []}]
UNWIND [{id: "rv_not_received_1", text: "Of course that stung. You tried to speak and hit a wall.", textNamed: "{N}, of course that stung. You tried to speak and hit a wall.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 0}, {id: "rv_not_received_2", text: "It hurts to be ignored. Anyone would feel this.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 1}, {id: "rv_not_received_3", text: "The hurt is real. The story you are spinning about it might not be.", textNamed: "The hurt is real. The story {N} is spinning about it might not be.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 2}, {id: "rv_not_received_4", text: "They didn't hear you. You can accept that without turning them into a monster.", textNamed: "They didn't hear {N}. {N} can accept that without turning them into a monster.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 3}, {id: "rv_diminished_self_1", text: "That landed on you. It is normal to feel rattled.", textNamed: "{N}, that landed on you. It is normal to feel rattled.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 4}, {id: "rv_diminished_self_2", text: "The hit was real. It doesn't mean you are broken.", textNamed: "The hit was real. It doesn't mean {N} is broken.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 5}, {id: "rv_diminished_self_3", text: "Feeling small right now does not make you small.", textNamed: "Feeling small right now does not make {N} small.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 6}, {id: "rv_diminished_self_4", text: "You are sensitive to this, and it actually hurt. Both are true.", textNamed: "{N} is sensitive to this, and it actually hurt. Both are true.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 7}, {id: "rv_blocked_wronged_1", text: "Something mattered and it got blocked. The anger makes complete sense.", textNamed: "{N}, something mattered and it got blocked. The anger makes complete sense.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 8}, {id: "rv_blocked_wronged_2", text: "You know this was unfair. You do not need to replay it all night to prove it.", textNamed: "{N} knows this was unfair. {N} does not need to replay it all night to prove it.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 9}, {id: "rv_blocked_wronged_3", text: "The anger is justified. You still have to decide the next move.", textNamed: "The anger is justified. {N} still has to decide the next move.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 10}, {id: "rv_blocked_wronged_4", text: "That felt unfair. You still get to choose the next move.", textNamed: "That felt unfair. {N} still gets to choose the next move.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 11}, {id: "rv_attachment_alarm_1", text: "Of course you are scared. Losing connection trips a survival wire.", textNamed: "{N}, of course you are scared. Losing connection trips a survival wire.", level: 4, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 12}, {id: "rv_attachment_alarm_2", text: "This is real pain. Being pushed away hurts everyone.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 13}, {id: "rv_attachment_alarm_3", text: "You can feel this fear without chasing them down.", textNamed: "{N} can feel this fear without chasing them down.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 14}, {id: "rv_attachment_alarm_4", text: "You are scared of losing them. That does not mean the relationship is over.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 15}, {id: "oa_fear_function", text: "Fear wants you to run. It thinks it is keeping you alive.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 16}, {id: "oa_anger_function", text: "Anger is arming you for a fight because a boundary got crossed.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 17}, {id: "oa_sadness_function", text: "Sadness is shutting you down. Something real is gone.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 18}, {id: "oa_disgust_function", text: "Disgust is physically rejecting this. It says this is toxic.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 19}, {id: "oa_shame_function", text: "Shame wants you to hide so you survive the group. It makes sense.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 20}, {id: "oa_guilt_function", text: "Guilt is a compass. It says you violated your own rules.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 21}, {id: "oa_jealousy_function", text: "Jealousy is trying to grip a connection that feels threatened.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 22}, {id: "oa_envy_function", text: "Envy is pointing at what you do not have. Wanting it is normal.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 23}, {id: "oa_love_function", text: "Love is a magnet. Of course you feel pulled toward them.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 24}, {id: "ps_fear_receive", text: "The threat is real. Your fear is pointing at it.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 25}, {id: "ps_anger_receive", text: "A boundary got crossed. The anger is just math.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 26}, {id: "ps_sadness_receive", text: "You lost something. The sadness fits the facts.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 27}, {id: "ps_guilt_receive", text: "You broke a rule you actually care about. Listen to the guilt.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 28}, {id: "ps_shame_receive", text: "Shame says you are defective. You feel it, but it is not a fact.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 29}] AS row
MERGE (l:ValidationLine {id: row.id})
SET l.text = row.text, l.textNamed = row.textNamed, l.level = row.level, l.voice = row.voice, l.bands = row.bands,
    l.kind = row.kind, l.forOther = row.forOther, l.tentative = row.tentative, l.order = row.order,
    l.status = row.status, l.reviewStatus = row.reviewStatus, l.reviewedAt = row.reviewedAt, l.corpusVersion = "witness-v1";
// @corpus-json [{"id": "ps_disgust_receive", "text": "Something crossed a hard line. Disgust is the correct alarm.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 30, "underneath": []}, {"id": "ps_envy_receive", "text": "You want what they have. That is entirely human.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 31, "underneath": []}, {"id": "ps_jealousy_receive", "text": "This connection matters. The jealousy is trying to guard it.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 32, "underneath": []}, {"id": "ps_love_receive", "text": "The love is real. The obstacle is also real.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 33, "underneath": []}, {"id": "dm_tp_defensive", "text": "They got defensive. Let them. You do not have to fix their feelings.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 34, "underneath": []}, {"id": "dm_tp_crying_shutdown", "text": "Your nervous system hit the brakes to protect you. That is not a failure.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 35, "underneath": []}, {"id": "dm_tp_apologized", "text": "Guilt showed up, and you held your ground anyway. That is how the muscle is built.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 36, "underneath": []}, {"id": "dm_tp_no_words", "text": "You lost your words. It happens. The boundary still stands.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 37, "underneath": []}, {"id": "dm_tp_gave_in", "text": "You folded because your brain prioritized immediate safety. It makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 38, "underneath": []}, {"id": "dm_tp_escalated", "text": "It got hot. You survived it. Now walk away and reset your nervous system.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 39, "underneath": []}, {"id": "dm_tp_went_okay", "text": "It went okay. You executed the behavior and proved the math.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 40, "underneath": []}, {"id": "dm_tp_something_else", "text": "The script didn't survive contact. What matters is that you tried it.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 41, "underneath": []}, {"id": "ci_fear_l4_1", "text": "You have been burned before. Of course you are bracing.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 42, "underneath": []}, {"id": "ci_fear_l4_2", "text": "Your system remembers this. The fear makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 43, "underneath": []}, {"id": "ci_fear_l4_3", "text": "Uncertainty is a threat response. You are reacting normally.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 44, "underneath": []}, {"id": "ci_fear_l5_1", "text": "It makes sense to be scared when you have no control.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 45, "underneath": []}, {"id": "ci_fear_l5_2", "text": "Anyone in the dark here would be on edge.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 46, "underneath": []}, {"id": "ci_fear_l5_3", "text": "You don't know what is next. That is terrifying.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 47, "underneath": []}, {"id": "ci_anger_l4_1", "text": "You had to fight before. The anger is muscle memory.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 48, "underneath": []}, {"id": "ci_anger_l4_2", "text": "When things are unfair, anger is the correct alarm.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 49, "underneath": []}, {"id": "ci_anger_l4_3", "text": "You are protecting yourself. That makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 50, "underneath": []}, {"id": "ci_anger_l5_1", "text": "Something you care about got blocked. Anger is the math.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 51, "underneath": []}, {"id": "ci_anger_l5_2", "text": "Anyone taking this hit would be angry.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 52, "underneath": []}, {"id": "ci_anger_l5_3", "text": "Of course you are mad. Something mattered here.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 53, "underneath": []}, {"id": "ci_sadness_l4_1", "text": "You have carried this a long time. The fatigue makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 54, "underneath": []}, {"id": "ci_sadness_l4_2", "text": "Old losses attach to new ones. This reaction is normal.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 55, "underneath": []}, {"id": "ci_sadness_l4_3", "text": "Hope got dropped. Sadness is what follows.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 56, "underneath": []}, {"id": "ci_sadness_l5_1", "text": "Something real is gone. The grief fits the facts.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 57, "underneath": []}, {"id": "ci_sadness_l5_2", "text": "Anyone missing this would feel exactly like this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 58, "underneath": []}, {"id": "ci_sadness_l5_3", "text": "Of course it hurts. It actually mattered.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 59, "underneath": []}]
