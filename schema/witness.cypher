// --- Tool moments ---
UNWIND [{id: "checkin_result", hostToolId: "checkin", label: "Check-in result"}, {id: "recover_validate", hostToolId: "recovering-from-invalidation", label: "Recover: this makes sense"}, {id: "oa_start", hostToolId: "opposite-action", label: "Opposite Action: before the urge"}, {id: "ps_define", hostToolId: "problem-solve", label: "Problem Solve: before defining the problem"}, {id: "dearman_describe", hostToolId: "dear-man", label: "DEAR MAN: before Describe"}, {id: "debrief_turning_point", hostToolId: "dear-man", label: "DEAR MAN debrief: the turning point"}, {id: "missed_followup", hostToolId: "today", label: "A follow-up that didn't happen"}, {id: "urge_louder", hostToolId: "opposite-action", label: "The urge went up"}, {id: "crisis", hostToolId: "checkin", label: "Crisis banner (level 1 only; CORE-01)"}] AS row
MERGE (m:ToolMoment {id: row.id})
SET m.hostToolId = row.hostToolId, m.label = row.label;

// --- Voice rules (traceability; the lint reads scripts/witness/voice-rules.json) ---
UNWIND [{id: "no_interpretation", pattern: "\\byou're right\\b|\\bthey were wrong\\b|\\bit was (unkind|wrong)\\b|\\bthis was wrong\\b|\\bthey don't care\\b|\\bthey meant\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\"}", message: "Validate the feeling, never an interpretation or another person's intent.", ruleVersion: "voice-v1"}, {id: "no_cheer", pattern: "great job|amazing|proud of you|awesome|well done|!", flags: "i", severityJson: "{\"validation\": \"error\", \"feeling_copy\": \"error\", \"user_copy\": \"warn\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\"}", message: "Flat, warm witness: no cheer on feelings, no exclamation marks.", ruleVersion: "voice-v1"}, {id: "no_emoji", pattern: "[\\u{1F000}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B50}\\u{2728}]", flags: "u", severityJson: "{\"validation\": \"error\", \"feeling_copy\": \"error\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\"}", message: "No emoji in validation or feeling copy.", ruleVersion: "voice-v1"}, {id: "and_not_but", pattern: "[,.;:] but\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\"}", message: "And, not but: a second clause never takes the first one back.", ruleVersion: "voice-v1"}, {id: "no_minimising", pattern: "\\bat least\\b|\\bdon't worry\\b|\\bjust\\b|\\beverything happens\\b|\\bit'll be fine\\b|\\bcalm down\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\"}", message: "No minimising or reassurance.", ruleVersion: "voice-v1"}, {id: "no_should", pattern: "\\bshould\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"feeling_copy\": \"warn\", \"user_copy\": \"warn\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\"}", message: "No shoulds.", ruleVersion: "voice-v1"}, {id: "no_diagnosis", pattern: "\\boverreact\\w*|\\boversensitiv\\w*", flags: "i", severityJson: "{\"validation\": \"error\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\"}", message: "No diagnosis words.", ruleVersion: "voice-v1"}, {id: "no_physiology", pattern: "\\bvag(us|al)\\b|\\bventral\\b|\\bdorsal\\b|\\boffline\\b|\\bhijack\\w*|\\bamygdala\\b|\\bcortex\\b|\\bnervous system\\b|\\bneuroscience\\b|\\blanguage cent(er|re)s\\b|\\balarm systems?\\b", flags: "i", severityJson: "{\"validation\": \"error\", \"feeling_copy\": \"report\", \"user_copy\": \"report\", \"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"report\"}", message: "No physiology claims in validation lines (D-04: report-only elsewhere).", ruleVersion: "voice-v1"}, {id: "voice_distance", pattern: "\\bI\\b|\\b[Mm]y\\b|\\b[Mm]e\\b|\\bI'(m|ve|ll|d)\\b", flags: "", severityJson: "{\"validation\": \"error\", \"parts_prompt\": \"error\"}", message: "App lines speak as a witness (you, or the user's name); first person only in lines the user writes.", ruleVersion: "voice-v1"}, {id: "no_role_labels", pattern: "\\b(exiles?|firefighters?|unburden\\w*|legacy burdens?|self-energy|trailheads?)\\b", flags: "i", severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\", \"validation\": \"error\", \"user_copy\": \"warn\"}", message: "Parts are known by what they do, in the person's words; the model's role words stay internal.", ruleVersion: "voice-v1"}, {id: "no_role_manager", pattern: "\\bmanagers?\\b", flags: "i", severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\"}", message: "\"Manager\" is a role label in parts copy (and a boss everywhere else, so only parts scopes).", ruleVersion: "voice-v1"}, {id: "no_part_blame", pattern: "\\bparts?( of (you|me))? (made|makes|forced|forces) (you|me)\\b", flags: "i", severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\", \"validation\": \"error\"}", message: "A part wanted something; the person acted. Never 'the part made you'.", ruleVersion: "voice-v1"}, {id: "no_ideation_echo", pattern: "\\b(disappear\\w*|vanish\\w*|die|dies|died|dying|dead|kill\\w*|suicid\\w*|end it all|end (my|your) life|not be here|not (wake|waking) up|better off without me)\\b", flags: "i", severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\", \"validation\": \"error\", \"user_copy\": \"report\"}", message: "Never put death or disappearing words in the app's mouth or the person's chips. Crisis copy goes through the crisis seam.", ruleVersion: "voice-v1"}, {id: "max_length", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "At most 90 characters (slots count as 8).", ruleVersion: "voice-v1"}, {id: "flooded_short", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "A line allowed at flooded is level 1-2 and at most 8 words.", ruleVersion: "voice-v1"}, {id: "slots", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "Only {N} {word} {phrase} {need}; textNamed has {N} exactly when voice is name; text never has {N}.", ruleVersion: "voice-v1"}, {id: "level3_tentative", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "Level 3 is a guess: tentative, with at least one UNDERNEATH emotion.", ruleVersion: "voice-v1"}, {id: "level6_capacity", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "Level 6 is about capacity, never worth or flattery.", ruleVersion: "voice-v1"}, {id: "reviewed_live", pattern: null, flags: null, severityJson: "{\"validation\": \"error\"}", message: "A live line has been reviewed (reviewStatus reviewed, reviewedAt set).", ruleVersion: "voice-v1"}, {id: "receive_before_change", pattern: null, flags: null, severityJson: "{\"flow\": \"error\"}", message: "In a flow that declares step kinds, a receive step precedes any change step.", ruleVersion: "voice-v1"}, {id: "skip_always", pattern: null, flags: null, severityJson: "{\"component\": \"error\"}", message: "The receive beat always renders skip, none of these fit and say it my way.", ruleVersion: "voice-v1"}, {id: "parts_max_length", pattern: null, flags: null, severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\"}", message: "Prompts and keepsakes ≤ 90 characters, chips ≤ 60, part voices ≤ 40; slots count at their width.", ruleVersion: "voice-v1"}, {id: "parts_slots", pattern: null, flags: null, severityJson: "{\"parts_prompt\": \"error\", \"parts_chip\": \"error\", \"parts_voice\": \"error\"}", message: "Only the parts slots, only in prompts (all) and keepsakes ({A} {B} {want}).", ruleVersion: "voice-v1"}] AS row
MERGE (v:VoiceRule {id: row.id})
SET v.pattern = row.pattern, v.flags = row.flags, v.severityJson = row.severityJson, v.message = row.message, v.ruleVersion = row.ruleVersion;

// --- Lines (batches; each preceded by its corpus JSON for the lint) ---
// @corpus-json [{"id": "rv_not_received_1", "text": "Of course that stung. You were trying to be heard and got {phrase}.", "textNamed": "{N}, of course that stung. You were trying to be heard and got {phrase}.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 0, "underneath": []}, {"id": "rv_not_received_2", "text": "Anyone who wanted to be understood would feel this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 1, "underneath": []}, {"id": "rv_not_received_3", "text": "Your hurt makes sense. The story about it might not.", "textNamed": "{N}'s hurt makes sense. The story about it might not.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 2, "underneath": []}, {"id": "rv_not_received_4", "text": "You can know this hurt without needing them to be the villain.", "textNamed": "{N} can know this hurt without needing them to be the villain.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 3, "underneath": []}, {"id": "rv_diminished_self_1", "text": "This is a moment of hurt. Being {phrase} hurts anyone.", "textNamed": "{N}, this is a moment of hurt. Being {phrase} hurts anyone.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 4, "underneath": []}, {"id": "rv_diminished_self_2", "text": "Your feeling is real. It isn't a verdict on you.", "textNamed": "{N}'s feeling is real. It isn't a verdict on {N}.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 5, "underneath": []}, {"id": "rv_diminished_self_3", "text": "Feeling small right now doesn't make you small.", "textNamed": "Feeling small right now doesn't make {N} small.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 6, "underneath": []}, {"id": "rv_diminished_self_4", "text": "Both can be true: you are sensitive to this, and it hurt.", "textNamed": "Both can be true: {N} is sensitive to this, and it hurt.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 7, "underneath": []}, {"id": "rv_blocked_wronged_1", "text": "It makes sense you're furious. Something mattered and got {phrase}.", "textNamed": "{N}, it makes sense you're furious. Something mattered and got {phrase}.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 8, "underneath": []}, {"id": "rv_blocked_wronged_2", "text": "You can know this was unfair without replaying it all night.", "textNamed": "{N} can know this was unfair without replaying it all night.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 9, "underneath": []}, {"id": "rv_blocked_wronged_3", "text": "It's understandable you are angry. You choose the next move.", "textNamed": "It's understandable {N} is angry. {N} chooses the next move.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 10, "underneath": []}, {"id": "rv_blocked_wronged_4", "text": "Both can be true: this felt wrong, and you get to decide what happens next.", "textNamed": "Both can be true: this felt wrong, and {N} gets to decide what happens next.", "level": 5, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 11, "underneath": []}, {"id": "rv_attachment_alarm_1", "text": "Of course you're scared. Losing connection sets off a real alarm.", "textNamed": "{N}, of course you're scared. Losing connection sets off a real alarm.", "level": 4, "voice": "name", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 12, "underneath": []}, {"id": "rv_attachment_alarm_2", "text": "This is real pain. Being pushed away hurts anyone.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 13, "underneath": []}, {"id": "rv_attachment_alarm_3", "text": "You can hold this fear without chasing.", "textNamed": "{N} can hold this fear without chasing.", "level": 6, "voice": "name", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 14, "underneath": []}, {"id": "rv_attachment_alarm_4", "text": "The alarm is loud. That doesn't mean the relationship is over.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "both", "forOther": false, "tentative": false, "status": "live", "reviewStatus": "reviewed", "reviewedAt": "2026-09-30", "order": 15, "underneath": []}, {"id": "oa_fear_function", "text": "Fear is trying to keep you safe. It pulls you away from what feels like a threat.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 16, "underneath": []}, {"id": "oa_anger_function", "text": "Anger showed up because something felt wrong. It's getting you ready to push back.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 17, "underneath": []}, {"id": "oa_sadness_function", "text": "Sadness pulls you inward. That's what it does after something that mattered.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 18, "underneath": []}, {"id": "oa_disgust_function", "text": "Disgust is pushing you away from something that feels wrong to take in.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 19, "underneath": []}, {"id": "oa_shame_function", "text": "Shame wants you to hide so you don't get pushed out. The pull makes sense.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 20, "underneath": []}, {"id": "oa_guilt_function", "text": "Guilt is pointing at your values. It wants you to put something right.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 21, "underneath": []}, {"id": "oa_jealousy_function", "text": "Jealousy is trying to hold on to a connection that matters to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 22, "underneath": []}, {"id": "oa_envy_function", "text": "Envy is pointing at something you want. Wanting it makes sense.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 23, "underneath": []}, {"id": "oa_love_function", "text": "Love keeps pulling you toward someone who matters. Of course it does.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "function", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 24, "underneath": []}, {"id": "ps_fear_receive", "text": "Your fear is pointing at something real.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 25, "underneath": []}, {"id": "ps_anger_receive", "text": "Something that mattered got crossed. Your anger makes sense.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 26, "underneath": []}, {"id": "ps_sadness_receive", "text": "You lost something real, or it didn't go the way you needed. The sadness fits.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 27, "underneath": []}, {"id": "ps_guilt_receive", "text": "This doesn't sit right with your values. The guilt is worth listening to.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 28, "underneath": []}, {"id": "ps_shame_receive", "text": "Shame says something is wrong with you. Feeling it doesn't make it true.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 29, "underneath": []}]
UNWIND [{id: "rv_not_received_1", text: "Of course that stung. You were trying to be heard and got {phrase}.", textNamed: "{N}, of course that stung. You were trying to be heard and got {phrase}.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 0}, {id: "rv_not_received_2", text: "Anyone who wanted to be understood would feel this.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 1}, {id: "rv_not_received_3", text: "Your hurt makes sense. The story about it might not.", textNamed: "{N}'s hurt makes sense. The story about it might not.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 2}, {id: "rv_not_received_4", text: "You can know this hurt without needing them to be the villain.", textNamed: "{N} can know this hurt without needing them to be the villain.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 3}, {id: "rv_diminished_self_1", text: "This is a moment of hurt. Being {phrase} hurts anyone.", textNamed: "{N}, this is a moment of hurt. Being {phrase} hurts anyone.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 4}, {id: "rv_diminished_self_2", text: "Your feeling is real. It isn't a verdict on you.", textNamed: "{N}'s feeling is real. It isn't a verdict on {N}.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 5}, {id: "rv_diminished_self_3", text: "Feeling small right now doesn't make you small.", textNamed: "Feeling small right now doesn't make {N} small.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 6}, {id: "rv_diminished_self_4", text: "Both can be true: you are sensitive to this, and it hurt.", textNamed: "Both can be true: {N} is sensitive to this, and it hurt.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 7}, {id: "rv_blocked_wronged_1", text: "It makes sense you're furious. Something mattered and got {phrase}.", textNamed: "{N}, it makes sense you're furious. Something mattered and got {phrase}.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 8}, {id: "rv_blocked_wronged_2", text: "You can know this was unfair without replaying it all night.", textNamed: "{N} can know this was unfair without replaying it all night.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 9}, {id: "rv_blocked_wronged_3", text: "It's understandable you are angry. You choose the next move.", textNamed: "It's understandable {N} is angry. {N} chooses the next move.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 10}, {id: "rv_blocked_wronged_4", text: "Both can be true: this felt wrong, and you get to decide what happens next.", textNamed: "Both can be true: this felt wrong, and {N} gets to decide what happens next.", level: 5, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 11}, {id: "rv_attachment_alarm_1", text: "Of course you're scared. Losing connection sets off a real alarm.", textNamed: "{N}, of course you're scared. Losing connection sets off a real alarm.", level: 4, voice: "name", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 12}, {id: "rv_attachment_alarm_2", text: "This is real pain. Being pushed away hurts anyone.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 13}, {id: "rv_attachment_alarm_3", text: "You can hold this fear without chasing.", textNamed: "{N} can hold this fear without chasing.", level: 6, voice: "name", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 14}, {id: "rv_attachment_alarm_4", text: "The alarm is loud. That doesn't mean the relationship is over.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "both", forOther: false, tentative: false, status: "live", reviewStatus: "reviewed", reviewedAt: "2026-09-30", order: 15}, {id: "oa_fear_function", text: "Fear is trying to keep you safe. It pulls you away from what feels like a threat.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 16}, {id: "oa_anger_function", text: "Anger showed up because something felt wrong. It's getting you ready to push back.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 17}, {id: "oa_sadness_function", text: "Sadness pulls you inward. That's what it does after something that mattered.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 18}, {id: "oa_disgust_function", text: "Disgust is pushing you away from something that feels wrong to take in.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 19}, {id: "oa_shame_function", text: "Shame wants you to hide so you don't get pushed out. The pull makes sense.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 20}, {id: "oa_guilt_function", text: "Guilt is pointing at your values. It wants you to put something right.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 21}, {id: "oa_jealousy_function", text: "Jealousy is trying to hold on to a connection that matters to you.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 22}, {id: "oa_envy_function", text: "Envy is pointing at something you want. Wanting it makes sense.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 23}, {id: "oa_love_function", text: "Love keeps pulling you toward someone who matters. Of course it does.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "function", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 24}, {id: "ps_fear_receive", text: "Your fear is pointing at something real.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 25}, {id: "ps_anger_receive", text: "Something that mattered got crossed. Your anger makes sense.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 26}, {id: "ps_sadness_receive", text: "You lost something real, or it didn't go the way you needed. The sadness fits.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 27}, {id: "ps_guilt_receive", text: "This doesn't sit right with your values. The guilt is worth listening to.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 28}, {id: "ps_shame_receive", text: "Shame says something is wrong with you. Feeling it doesn't make it true.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 29}] AS row
MERGE (l:ValidationLine {id: row.id})
SET l.text = row.text, l.textNamed = row.textNamed, l.level = row.level, l.voice = row.voice, l.bands = row.bands,
    l.kind = row.kind, l.forOther = row.forOther, l.tentative = row.tentative, l.order = row.order,
    l.status = row.status, l.reviewStatus = row.reviewStatus, l.reviewedAt = row.reviewedAt, l.corpusVersion = "witness-v1";
// @corpus-json [{"id": "ps_disgust_receive", "text": "Something crossed a line for you. Your disgust is saying this isn't okay.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 30, "underneath": []}, {"id": "ps_envy_receive", "text": "Your envy is pointing at something you want. There's nothing wrong with wanting it.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 31, "underneath": []}, {"id": "ps_jealousy_receive", "text": "This relationship matters to you. Your jealousy is trying to protect it.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 32, "underneath": []}, {"id": "ps_love_receive", "text": "The love is real. Something is getting in its way.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 33, "underneath": []}, {"id": "dm_tp_defensive", "text": "They got defensive. That's one of the hardest things to stay steady through.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 34, "underneath": []}, {"id": "dm_tp_crying_shutdown", "text": "Your body was trying to protect you. That isn't weakness.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 35, "underneath": []}, {"id": "dm_tp_apologized", "text": "Holding your ground is hard when guilt shows up. Lots of people fold there.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 36, "underneath": []}, {"id": "dm_tp_no_words", "text": "When feelings run this high, words get hard to find. That isn't failure.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 37, "underneath": []}, {"id": "dm_tp_gave_in", "text": "Giving in made sense in that moment. Part of you was keeping things safe.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 38, "underneath": []}, {"id": "dm_tp_escalated", "text": "It got heated. That usually means something mattered a lot.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "after_miss", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 39, "underneath": []}, {"id": "dm_tp_went_okay", "text": "It went okay. You did a hard thing.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 40, "underneath": []}, {"id": "dm_tp_something_else", "text": "Every conversation has its own shape. What happened for you counts.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 41, "underneath": []}, {"id": "ci_fear_l4_1", "text": "If things have gone wrong before, of course you're bracing now.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 42, "underneath": []}, {"id": "ci_fear_l4_2", "text": "If you've been caught off guard before, fear can show up early.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 43, "underneath": []}, {"id": "ci_fear_l4_3", "text": "Some people pick up on danger faster than others. Fear showing up makes sense.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 44, "underneath": []}, {"id": "ci_fear_l5_1", "text": "Anyone facing something this uncertain could feel scared.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 45, "underneath": []}, {"id": "ci_fear_l5_2", "text": "Fear makes sense when something matters and you can't control it.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 46, "underneath": []}, {"id": "ci_fear_l5_3", "text": "Of course you're on edge. Something feels unsafe or unsure.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 47, "underneath": []}, {"id": "ci_anger_l4_1", "text": "If you've had to fight to be heard before, this anger makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 48, "underneath": []}, {"id": "ci_anger_l4_2", "text": "If things have felt unfair for a while, anger can come fast.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 49, "underneath": []}, {"id": "ci_anger_l4_3", "text": "If you've had to protect yourself before, this anger makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 50, "underneath": []}, {"id": "ci_anger_l5_1", "text": "Anger makes sense when something you care about gets blocked.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 51, "underneath": []}, {"id": "ci_anger_l5_2", "text": "Anyone in your spot could feel this angry.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 52, "underneath": []}, {"id": "ci_anger_l5_3", "text": "Of course you're angry. Something mattered to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 53, "underneath": []}, {"id": "ci_sadness_l4_1", "text": "If you've been carrying a lot, sadness makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 54, "underneath": []}, {"id": "ci_sadness_l4_2", "text": "If you've lost things before, a new loss can bring the old ones with it.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 55, "underneath": []}, {"id": "ci_sadness_l4_3", "text": "If hope has been let down before, sadness can come on heavy.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 56, "underneath": []}, {"id": "ci_sadness_l5_1", "text": "Sadness makes sense when something that mattered is gone or out of reach.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 57, "underneath": []}, {"id": "ci_sadness_l5_2", "text": "Anyone missing something important could feel this sad.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 58, "underneath": []}, {"id": "ci_sadness_l5_3", "text": "Of course this hurts. It mattered to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 59, "underneath": []}]
UNWIND [{id: "ps_disgust_receive", text: "Something crossed a line for you. Your disgust is saying this isn't okay.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 30}, {id: "ps_envy_receive", text: "Your envy is pointing at something you want. There's nothing wrong with wanting it.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 31}, {id: "ps_jealousy_receive", text: "This relationship matters to you. Your jealousy is trying to protect it.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 32}, {id: "ps_love_receive", text: "The love is real. Something is getting in its way.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 33}, {id: "dm_tp_defensive", text: "They got defensive. That's one of the hardest things to stay steady through.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 34}, {id: "dm_tp_crying_shutdown", text: "Your body was trying to protect you. That isn't weakness.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 35}, {id: "dm_tp_apologized", text: "Holding your ground is hard when guilt shows up. Lots of people fold there.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 36}, {id: "dm_tp_no_words", text: "When feelings run this high, words get hard to find. That isn't failure.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 37}, {id: "dm_tp_gave_in", text: "Giving in made sense in that moment. Part of you was keeping things safe.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 38}, {id: "dm_tp_escalated", text: "It got heated. That usually means something mattered a lot.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "after_miss", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 39}, {id: "dm_tp_went_okay", text: "It went okay. You did a hard thing.", textNamed: null, level: 6, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 40}, {id: "dm_tp_something_else", text: "Every conversation has its own shape. What happened for you counts.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 41}, {id: "ci_fear_l4_1", text: "If things have gone wrong before, of course you're bracing now.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 42}, {id: "ci_fear_l4_2", text: "If you've been caught off guard before, fear can show up early.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 43}, {id: "ci_fear_l4_3", text: "Some people pick up on danger faster than others. Fear showing up makes sense.", textNamed: null, level: 4, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 44}, {id: "ci_fear_l5_1", text: "Anyone facing something this uncertain could feel scared.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 45}, {id: "ci_fear_l5_2", text: "Fear makes sense when something matters and you can't control it.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 46}, {id: "ci_fear_l5_3", text: "Of course you're on edge. Something feels unsafe or unsure.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 47}, {id: "ci_anger_l4_1", text: "If you've had to fight to be heard before, this anger makes sense.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 48}, {id: "ci_anger_l4_2", text: "If things have felt unfair for a while, anger can come fast.", textNamed: null, level: 4, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 49}, {id: "ci_anger_l4_3", text: "If you've had to protect yourself before, this anger makes sense.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 50}, {id: "ci_anger_l5_1", text: "Anger makes sense when something you care about gets blocked.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 51}, {id: "ci_anger_l5_2", text: "Anyone in your spot could feel this angry.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 52}, {id: "ci_anger_l5_3", text: "Of course you're angry. Something mattered to you.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 53}, {id: "ci_sadness_l4_1", text: "If you've been carrying a lot, sadness makes sense.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 54}, {id: "ci_sadness_l4_2", text: "If you've lost things before, a new loss can bring the old ones with it.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 55}, {id: "ci_sadness_l4_3", text: "If hope has been let down before, sadness can come on heavy.", textNamed: null, level: 4, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 56}, {id: "ci_sadness_l5_1", text: "Sadness makes sense when something that mattered is gone or out of reach.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 57}, {id: "ci_sadness_l5_2", text: "Anyone missing something important could feel this sad.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 58}, {id: "ci_sadness_l5_3", text: "Of course this hurts. It mattered to you.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 59}] AS row
MERGE (l:ValidationLine {id: row.id})
SET l.text = row.text, l.textNamed = row.textNamed, l.level = row.level, l.voice = row.voice, l.bands = row.bands,
    l.kind = row.kind, l.forOther = row.forOther, l.tentative = row.tentative, l.order = row.order,
    l.status = row.status, l.reviewStatus = row.reviewStatus, l.reviewedAt = row.reviewedAt, l.corpusVersion = "witness-v1";
// @corpus-json [{"id": "ci_disgust_l4_1", "text": "If something like this has hurt you before, pulling away makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 60, "underneath": []}, {"id": "ci_disgust_l4_2", "text": "If something like this has left a bad taste before, the disgust makes sense.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 61, "underneath": []}, {"id": "ci_disgust_l4_3", "text": "If your values have been pushed on before, disgust can come up fast.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 62, "underneath": []}, {"id": "ci_disgust_l5_1", "text": "Disgust makes sense when something feels wrong to take in.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 63, "underneath": []}, {"id": "ci_disgust_l5_2", "text": "Anyone who ran into this could want to pull back.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 64, "underneath": []}, {"id": "ci_disgust_l5_3", "text": "Of course you want some distance from this.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 65, "underneath": []}, {"id": "ci_shame_l4_1", "text": "If you've been judged harshly before, shame can show up fast.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 66, "underneath": []}, {"id": "ci_shame_l4_2", "text": "If mistakes used to cost you a lot, shame can come on fast.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 67, "underneath": []}, {"id": "ci_shame_l4_3", "text": "If hiding kept you safe before, wanting to hide now makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 68, "underneath": []}, {"id": "ci_shame_l5_1", "text": "Wanting to hide makes sense when you feel exposed.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 69, "underneath": []}, {"id": "ci_shame_l5_2", "text": "Anyone who felt this exposed could feel shame.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 70, "underneath": []}, {"id": "ci_shame_l5_3", "text": "Shame is a painful feeling. It makes sense that it's this heavy.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 71, "underneath": []}, {"id": "ci_guilt_l4_1", "text": "You care about doing right. That's part of why this guilt shows up.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 72, "underneath": []}, {"id": "ci_guilt_l4_2", "text": "If you've worked hard to be good to people, guilt can hit hard.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 73, "underneath": []}, {"id": "ci_guilt_l4_3", "text": "If you hold yourself to a high standard, guilt can come easily.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 74, "underneath": []}, {"id": "ci_guilt_l5_1", "text": "Guilt makes sense when something doesn't sit right with your values.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 75, "underneath": []}, {"id": "ci_guilt_l5_2", "text": "Anyone who cares about the people around them could feel this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 76, "underneath": []}, {"id": "ci_guilt_l5_3", "text": "Of course this weighs on you. It matters to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 77, "underneath": []}, {"id": "ci_envy_l4_1", "text": "If you've gone without for a while, envy makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 78, "underneath": []}, {"id": "ci_envy_l4_2", "text": "If you've wanted something for a long time, seeing it elsewhere stings.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 79, "underneath": []}, {"id": "ci_envy_l4_3", "text": "If a want has gone unmet for a while, envy makes sense.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 80, "underneath": []}, {"id": "ci_envy_l5_1", "text": "Envy makes sense when someone has something you want.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 81, "underneath": []}, {"id": "ci_envy_l5_2", "text": "Anyone who wants this could feel envy.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 82, "underneath": []}, {"id": "ci_envy_l5_3", "text": "Of course it stings to see someone else have it.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 83, "underneath": []}, {"id": "ci_jealousy_l4_1", "text": "If you've been left or let down before, jealousy makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 84, "underneath": []}, {"id": "ci_jealousy_l4_2", "text": "If you've lost a connection before, fearing that again makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 85, "underneath": []}, {"id": "ci_jealousy_l4_3", "text": "If trust has been hurt before, jealousy can come on strong.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 86, "underneath": []}, {"id": "ci_jealousy_l5_1", "text": "Jealousy makes sense when a relationship matters and feels at risk.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 87, "underneath": []}, {"id": "ci_jealousy_l5_2", "text": "Anyone who could lose someone important could feel this.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 88, "underneath": []}, {"id": "ci_jealousy_l5_3", "text": "Of course you want to hold on. They matter to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 89, "underneath": []}]
