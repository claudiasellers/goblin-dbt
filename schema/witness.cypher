 80}, {id: "ci_envy_l5_1", text: "Envy makes sense when someone has something you want.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 81}, {id: "ci_envy_l5_2", text: "Anyone who wants this could feel envy.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 82}, {id: "ci_envy_l5_3", text: "Of course it stings to see someone else have it.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 83}, {id: "ci_jealousy_l4_1", text: "If you've been left or let down before, jealousy makes sense.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 84}, {id: "ci_jealousy_l4_2", text: "If you've lost a connection before, fearing that again makes sense.", textNamed: null, level: 4, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 85}, {id: "ci_jealousy_l4_3", text: "If trust has been hurt before, jealousy can come on strong.", textNamed: null, level: 4, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 86}, {id: "ci_jealousy_l5_1", text: "Jealousy makes sense when a relationship matters and feels at risk.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 87}, {id: "ci_jealousy_l5_2", text: "Anyone who could lose someone important could feel this.", textNamed: null, level: 5, voice: "none", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 88}, {id: "ci_jealousy_l5_3", text: "Of course you want to hold on. They matter to you.", textNamed: null, level: 5, voice: "you", bands: ["steady", "stirred"], kind: "receive", forOther: false, tentative: false, status: "draft", reviewStatus: "draft", reviewedAt: null, order: 89}] AS row
