// @corpus-json [{"id": "ci_love_l4_1", "text": "They have been a fixture for you. Love doesn't just turn off.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 90, "underneath": []}, {"id": "ci_love_l4_2", "text": "This goes back a long way. Of course it still pulls.", "textNamed": null, "level": 4, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 91, "underneath": []}, {"id": "ci_love_l4_3", "text": "You have history here. It makes sense that you still care.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 92, "underneath": []}, {"id": "ci_love_l5_1", "text": "The love is a fact. This person matters to you.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 93, "underneath": []}, {"id": "ci_love_l5_2", "text": "Anyone who cares this much would feel the pull.", "textNamed": null, "level": 5, "voice": "none", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 94, "underneath": []}, {"id": "ci_love_l5_3", "text": "Of course you are drawn to them. The bond is real.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 95, "underneath": []}, {"id": "ci_l3_anger_hurt", "text": "Maybe some of this anger is hurt.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 96, "underneath": ["hurt"]}, {"id": "ci_l3_anger_fear", "text": "Anger is the armor. Fear is the thing wearing it.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 97, "underneath": ["fear"]}, {"id": "ci_l3_shame_rejection", "text": "You want to hide. That usually means you feel exposed.", "textNamed": null, "level": 3, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 98, "underneath": ["rejection"]}, {"id": "ci_l3_numb_overwhelm", "text": "The circuit broke. Numb is just what overload feels like.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 99, "underneath": ["overwhelm"]}, {"id": "ci_l3_jealousy_fear", "text": "Jealousy is the grip. The fear of losing them is the fuel.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 100, "underneath": ["fear"]}, {"id": "ci_l3_envy_sadness", "text": "Maybe there is sadness under the envy.", "textNamed": null, "level": 3, "voice": "none", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": true, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 101, "underneath": ["sadness"]}, {"id": "ci_l6_1", "text": "Your track record for surviving days like this is 100%. The math is on your side.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 102, "underneath": []}, {"id": "ci_l6_2", "text": "You do not have to feel brave. You just have to execute the behavior.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 103, "underneath": []}, {"id": "ci_l6_3", "text": "Your hands can shake while you do this. Just take the literal next step.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 104, "underneath": []}, {"id": "ci_l6_4", "text": "You survived the initial hit. You know the mechanics from here.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 105, "underneath": []}, {"id": "ci_l6_5", "text": "The feeling does not have to clear for you to make the right move.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 106, "underneath": []}, {"id": "ci_l6_6", "text": "You have executed this before. You do not have to like it to do it.", "textNamed": null, "level": 6, "voice": "you", "bands": ["steady"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 107, "underneath": []}, {"id": "ci_flooded_1", "text": "Brain is offline. Feet flat on the floor.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 108, "underneath": []}, {"id": "ci_flooded_2", "text": "Drop the story. We aren't solving this today.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 109, "underneath": []}, {"id": "ci_flooded_3", "text": "No thinking needed. Not yet.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 110, "underneath": []}, {"id": "ci_flooded_4", "text": "Breathe out longer than you breathe in.", "textNamed": null, "level": 1, "voice": "you", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 111, "underneath": []}, {"id": "ci_flooded_5", "text": "Stand up. Change your hand temperature.", "textNamed": null, "level": 1, "voice": "you", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 112, "underneath": []}, {"id": "ci_flooded_6", "text": "Eyes up. Find a corner of the room.", "textNamed": null, "level": 1, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 113, "underneath": []}, {"id": "ci_flooded_7", "text": "Your body is reacting. Just breathe right now.", "textNamed": null, "level": 2, "voice": "you", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 114, "underneath": []}, {"id": "ci_flooded_8", "text": "Step back. Reset. Nothing to solve.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 115, "underneath": []}, {"id": "ci_flooded_9", "text": "Hold steady. You do not have to act.", "textNamed": null, "level": 2, "voice": "you", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 116, "underneath": []}, {"id": "ci_flooded_10", "text": "A feeling is not an order. Do not answer it.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 117, "underneath": []}, {"id": "ci_flooded_11", "text": "No decisions today. Just stay in the room.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 118, "underneath": []}, {"id": "ci_flooded_12", "text": "Wait. This part passes.", "textNamed": null, "level": 2, "voice": "none", "bands": ["flooded"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 119, "underneath": []}]
