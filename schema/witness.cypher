// @corpus-json [{"id": "ci_generic_l4_1", "text": "You have been through a lot. The reaction is normal.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 120, "underneath": []}, {"id": "ci_generic_l4_2", "text": "This is a fast trigger for you. The reaction makes sense.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 121, "underneath": []}, {"id": "ci_generic_l4_3", "text": "This is an old groove. It makes sense you fell into it.", "textNamed": null, "level": 4, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 122, "underneath": []}, {"id": "ci_generic_l5_1", "text": "What you are feeling is exactly right for the facts.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 123, "underneath": []}, {"id": "ci_generic_l5_2", "text": "Anyone standing where you are would feel this.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 124, "underneath": []}, {"id": "ci_generic_l5_3", "text": "You are feeling three things at once. That is normal.", "textNamed": null, "level": 5, "voice": "you", "bands": ["steady", "stirred"], "kind": "receive", "forOther": false, "tentative": false, "status": "draft", "reviewStatus": "draft", "reviewedAt": null, "order": 125, "underneath": []}]
