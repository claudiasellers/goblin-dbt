// ============================================================
// FIND THE FEELING ("Shape it" / "Tune it") — find-v1
// GENERATED by scripts/find-the-feeling/build.py from content.py. Edit content.py, not this file.
// Emotion identification for alexithymia without rating scales: match the feeling to a shape or a
// sound, then accept or refuse an offered word. Word signatures hang off existing Emotion nodes.
// Run AFTER invalidation-recovery.cypher (reuses ClinicalSource linehan_skills_2015 and
// TherapyConcept affect_labeling). Idempotent: MERGE + SET only, constraints IF NOT EXISTS.
// See docs/design/find-the-feeling.md.
// ============================================================

CREATE CONSTRAINT feeling_signature_id IF NOT EXISTS
FOR (n:FeelingSignature) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT feeling_family_id IF NOT EXISTS
FOR (n:FeelingFamily) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT feeling_urge_id IF NOT EXISTS
FOR (n:FeelingUrge) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT find_the_feeling_session_key IF NOT EXISTS
FOR (s:FindTheFeelingSession) REQUIRE s.key IS UNIQUE;

// --- Therapy concepts ---
MERGE (c:TherapyConcept {id: "dbt_find_the_feeling"})
SET c.name = "Find the Feeling", c.description = "Identify and name an emotion without introspective rating: match it to a shape or a sound, then accept or refuse an offered word", c.modality = "DBT", c.module = "Emotion Regulation";
MATCH (c:TherapyConcept {id: "dbt_find_the_feeling"}), (m:TherapyConcept {id: "dbt_emotion_regulation_module"})
MERGE (c)-[:PART_OF]->(m);
MERGE (c:TherapyConcept {id: "urge_surfing"})
SET c.name = "Urge Surfing", c.description = "Watching an urge rise, peak and fall without acting on it", c.modality = "Mindfulness-based relapse prevention";
MATCH (c:TherapyConcept {id: "urge_surfing"}), (m:TherapyConcept {id: "dbt_opposite_action"})
MERGE (c)-[:RELATED_TO]->(m);
MERGE (c:TherapyConcept {id: "cross_modal_matching"})
SET c.name = "Cross-Modal Emotion Matching", c.description = "Describing a feeling through shape, temperature, weight, motion or sound instead of words", c.modality = "Affective science";
MATCH (c:TherapyConcept {id: "cross_modal_matching"}), (m:TherapyConcept {id: "dbt_describe"})
MERGE (c)-[:RELATED_TO]->(m);
MERGE (c:TherapyConcept {id: "affective_touch"})
SET c.name = "Affective Touch", c.description = "Slow, gentle stroking (about 1 to 10 cm per second) that engages C-tactile afferents and settles arousal", c.modality = "Physiological";
MATCH (c:TherapyConcept {id: "affective_touch"}), (m:TherapyConcept {id: "dbt_tipp"})
MERGE (c)-[:RELATED_TO]->(m);
MERGE (c:TherapyConcept {id: "resonance_breathing"})
SET c.name = "Resonance Breathing", c.description = "Slow paced breathing near six breaths per minute", c.modality = "Physiological";
MATCH (c:TherapyConcept {id: "resonance_breathing"}), (m:TherapyConcept {id: "dbt_tipp"})
MERGE (c)-[:RELATED_TO]->(m);
MATCH (t:TherapyConcept {id: 'dbt_find_the_feeling'})
SET t.whenToUse = "When you can tell something's there but not what it is", t.dbtBasis = 'Emotion Regulation: observing, describing and naming emotions (with Mindfulness Describe), without numeric rating';
MATCH (:TherapyConcept {id: 'dbt_find_the_feeling'})-[r:USES|ADDRESSES]->() DELETE r;
UNWIND ["dbt_describe", "affect_labeling", "cross_modal_matching", "affective_touch", "resonance_breathing", "se_orienting"] AS cid
MATCH (t:TherapyConcept {id: 'dbt_find_the_feeling'}), (c:TherapyConcept {id: cid})
MERGE (t)-[:USES]->(c);
UNWIND ["confused", "perplexed", "indifferent", "apathetic"] AS eid
MATCH (t:TherapyConcept {id: 'dbt_find_the_feeling'}), (e:Emotion {id: eid})
MERGE (t)-[:ADDRESSES]->(e);

// --- App tool ids (join key for the frontend; replaces guessing via normalizeToolId) ---
UNWIND [{c: "dbt_tipp", t: "cool-down"}, {c: "dbt_stop", t: "pause"}, {c: "se_orienting", t: "five-senses"}, {c: "urge_surfing", t: "urge-surfing"}, {c: "dbt_opposite_action", t: "opposite-action"}, {c: "dbt_problem_solving", t: "problem-solve"}, {c: "dbt_dear_man", t: "dear-man"}, {c: "dbt_recovering_from_invalidation", t: "recovering-from-invalidation"}, {c: "dbt_find_the_feeling", t: "find-the-feeling"}] AS row
MATCH (c:TherapyConcept {id: row.c})
SET c.appToolId = row.t;

// --- Clinical sources ---
MERGE (s:ClinicalSource {id: "nummenmaa_2014"})
SET s.title = "Nummenmaa, Glerean, Hari & Hietanen (2014), PNAS — bodily maps of emotions", s.url = "https://doi.org/10.1073/pnas.1321664111";
MERGE (s:ClinicalSource {id: "juslin_laukka_2003"})
SET s.title = "Juslin & Laukka (2003), Psychological Bulletin — emotion in vocal expression and music performance share acoustic codes", s.url = "https://doi.org/10.1037/0033-2909.129.5.770";
MERGE (s:ClinicalSource {id: "palmer_2013"})
SET s.title = "Palmer et al. (2013), PNAS — music–colour associations are mediated by emotion", s.url = "https://doi.org/10.1073/pnas.1212562110";
MERGE (s:ClinicalSource {id: "lieberman_2007"})
SET s.title = "Lieberman et al. (2007), Psychological Science — putting feelings into words (affect labelling)", s.url = "https://doi.org/10.1111/j.1467-9280.2007.01916.x";
MERGE (s:ClinicalSource {id: "kashdan_2015"})
SET s.title = "Kashdan, Barrett & McKnight (2015), Current Directions in Psychological Science — emotion differentiation", s.url = "https://doi.org/10.1177/0963721414550708";
MERGE (s:ClinicalSource {id: "brewer_2016"})
SET s.title = "Brewer, Cook & Bird (2016), Royal Society Open Science — alexithymia as a general deficit of interoception", s.url = "https://doi.org/10.1098/rsos.150664";
MERGE (s:ClinicalSource {id: "loken_2009"})
SET s.title = "Löken et al. (2009), Nature Neuroscience — pleasant touch coded by unmyelinated (C-tactile) afferents", s.url = "https://doi.org/10.1038/nn.2312";
MERGE (s:ClinicalSource {id: "bernardi_2006"})
SET s.title = "Bernardi, Porta & Sleight (2006), Heart — breathing and cardiovascular measures follow musical tempo; slow music and pauses lower arousal", s.url = "https://doi.org/10.1136/hrt.2005.064600";
MERGE (s:ClinicalSource {id: "lehrer_gevirtz_2014"})
SET s.title = "Lehrer & Gevirtz (2014), Frontiers in Psychology — heart rate variability biofeedback", s.url = "https://doi.org/10.3389/fpsyg.2014.00756";

