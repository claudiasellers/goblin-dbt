MATCH (e:Emotion {id: "excited"})
MERGE (g:FeelingSignature {id: "sig_excited"})
SET g.shape = [0.1, 0.6, -0.7, 0.8, 0.0], g.sound = [0.2, 0.2, 0.8, 0.8], g.shapeDims = ["sharp", "heat", "weight", "buzz", "clench"], g.soundDims = ["rough", "grit", "register", "pulse"],
    g.evidenceGrade = 'Preliminary', g.reviewStatus = 'needs_clinical_review'
MERGE (e)-[:HAS_FEELING_SIGNATURE]->(g)
WITH g
MATCH (f:FeelingFamily {id: "warm_light"})
MERGE (f)-[r:INCLUDES]->(g) SET r.offer = 3;

// --- Urges and where they route ---
MATCH (:FeelingUrge)-[r:ROUTES_TO]->() DELETE r;
MERGE (u:FeelingUrge {id: "fight"})
SET u.label = "Say something sharp", u.sub = "prove them wrong, snap", u.order = 0;
UNWIND [{c: "dbt_stop", rank: 0}, {c: "dbt_opposite_action", rank: 1}] AS row
MATCH (u:FeelingUrge {id: "fight"}), (c:TherapyConcept {id: row.c})
MERGE (u)-[r:ROUTES_TO]->(c) SET r.rank = row.rank;
MERGE (u:FeelingUrge {id: "chase"})
SET u.label = "Text someone a lot", u.sub = "explain, fix it, now", u.order = 1;
UNWIND [{c: "urge_surfing", rank: 0}, {c: "dbt_stop", rank: 1}] AS row
MATCH (u:FeelingUrge {id: "chase"}), (c:TherapyConcept {id: row.c})
MERGE (u)-[r:ROUTES_TO]->(c) SET r.rank = row.rank;
MERGE (u:FeelingUrge {id: "hide"})
SET u.label = "Disappear", u.sub = "cancel, go quiet", u.order = 2;
UNWIND [{c: "dbt_opposite_action", rank: 0}] AS row
MATCH (u:FeelingUrge {id: "hide"}), (c:TherapyConcept {id: row.c})
MERGE (u)-[r:ROUTES_TO]->(c) SET r.rank = row.rank;
MERGE (u:FeelingUrge {id: "blank"})
SET u.label = "Nothing. I'm blank", u.sub = "numb, heavy, far away", u.order = 3;
UNWIND [{c: "se_orienting", rank: 0}] AS row
MATCH (u:FeelingUrge {id: "blank"}), (c:TherapyConcept {id: row.c})
MERGE (u)-[r:ROUTES_TO]->(c) SET r.rank = row.rank;

// --- Flow document (copy + gates), versioned like InvalidationRecoveryFlow ---
MERGE (f:FindTheFeelingFlow {id: 'find_the_feeling_flow'})
SET f.version = "find-v1", f.contentJson = "{\"version\": \"find-v1\", \"ways\": [\"shape\", \"tune\"], \"defaultWay\": \"shape\", \"gates\": {\"regulateBands\": [\"flooded\"], \"activateUrges\": [\"blank\"], \"floodedBlank\": \"regulate_then_orient_no_label\", \"maxWordsOffered\": 3, \"slowStrokePxPerSec\": [45, 380], \"fastStrokePxPerSec\": 600, \"breathHoldMs\": 2800, \"breathsToSettle\": 5, \"plucksToWake\": 6, \"regulationEscapeSeconds\": 20, \"ambientDescent\": {\"perStep\": 0.08, \"maxTotal\": 0.45, \"startAfter\": \"capacity\", \"blankDirection\": \"brighten\", \"floodedBlankDirection\": \"calm\"}}, \"bandIntensity\": {\"steady\": 0.35, \"stirred\": 0.6, \"flooded\": 0.85}, \"copy\": {\"entry\": {\"checkInLabel\": \"I can't tell what I'm feeling\", \"title\": \"Find the feeling\", \"sub\": \"No words needed yet.\", \"shape\": \"By shape\", \"tune\": \"By ear\", \"tuneHint\": \"Headphones help. It works silently too.\", \"switchToTune\": \"Try it by ear instead\", \"switchToShape\": \"Try it by shape instead\"}, \"shape\": {\"intro\": \"Something's there. Before words, let's give it a shape.\", \"round\": \"Which is closer to what's inside?\", \"cantTell\": \"can't tell\", \"rounds\": [[\"sharp\", \"soft\"], [\"hot\", \"cool\"], [\"heavy\", \"light\"], [\"buzzing\", \"still\"], [\"clenched\", \"hollow\"]], \"smooth\": {\"title\": \"Smooth it down. Slowly.\", \"tooFast\": \"Slower, like stroking a sleeping cat.\", \"hold\": \"Or press and hold here\", \"enough\": \"That's enough for now\"}, \"warm\": {\"title\": \"Warm it up.\", \"sub\": \"Rub it briskly, like cold hands.\", \"hold\": \"Or press and hold here\"}, \"wordLead\": \"Things shaped like this are often called\", \"shelf\": \"Your shelf\"}, \"tune\": {\"intro\": \"Something's there. Let's find how it sounds in there.\", \"search\": \"Is this closer to how it feels, or further?\", \"closer\": \"Closer\", \"further\": \"Further\", \"thatsIt\": \"That's it\", \"breathe\": {\"title\": \"Breathe them back into tune.\", \"sub\": \"Hold anywhere while you breathe in. Let go to breathe out.\", \"tooQuick\": \"A little slower. Let the breath fill up.\", \"done\": \"Hear it? The throb is slow and soft now.\"}, \"wake\": {\"title\": \"Wake the strings.\", \"sub\": \"Pluck them. Each one a bit brighter.\"}, \"wordLead\": \"Sounds like this often get called…\", \"harp\": \"Your strings\"}, \"capacity\": {\"prompt\": \"If someone asked you for a favour right now, you'd…\", \"incoming\": \"hey, could you help me with something?\", \"options\": {\"steady\": \"Say yes like normal\", \"stirred\": \"Say yes, but with an edge\", \"flooded\": \"Couldn't answer, or would regret it\"}}, \"pull\": {\"title\": \"What does it want to do?\"}, \"word\": {\"yes\": \"Yes\", \"close\": \"Close\", \"no\": \"Not that\", \"none\": \"Not knowing the word is fine. You found its shape, and that counts.\", \"floodedBlank\": \"Let's skip the word today. Getting back into the room is the whole job right now.\"}, \"setOff\": {\"title\": \"Do you know what set it off?\", \"optional\": true, \"notSure\": \"Not sure\", \"someone\": \"Something with someone\", \"situation\": \"A situation\", \"body\": \"Tired, hungry or sore\", \"nothing\": \"Nothing I can see\"}, \"close\": {\"prompt\": \"Which is closer to how you feel right now?\", \"options\": {\"louder\": \"Then\", \"same\": \"Somewhere between\", \"quieter\": \"Now\", \"much\": \"Now, and even calmer\"}}, \"next\": {\"title\": \"Where to next\", \"sub\": \"Based on what you found.\", \"none\": \"Nothing else needed. Finding it was the work.\"}, \"collection\": {\"title\": \"Your collection\", \"new\": \"“{word}” joins the others. Naming a feeling is a skill, and you just used it.\", \"rooms\": {\"shelf\": \"Shelf\", \"harp\": \"Strings\", \"scenes\": \"Scenes\"}}}, \"sourceIds\": [\"linehan_skills_2015\", \"nummenmaa_2014\", \"juslin_laukka_2003\", \"palmer_2013\", \"lieberman_2007\", \"kashdan_2015\", \"brewer_2016\", \"loken_2009\", \"lehrer_gevirtz_2014\", \"bernardi_2006\"]}";
MATCH (f:FindTheFeelingFlow {id: 'find_the_feeling_flow'}), (s:ClinicalSource)
WHERE s.id IN ["linehan_skills_2015", "nummenmaa_2014", "juslin_laukka_2003", "palmer_2013", "lieberman_2007", "kashdan_2015", "brewer_2016", "loken_2009", "lehrer_gevirtz_2014", "bernardi_2006"]
MERGE (f)-[:GROUNDED_IN]->(s);
MATCH (f:FindTheFeelingFlow {id: 'find_the_feeling_flow'}), (t:TherapyConcept {id: 'dbt_find_the_feeling'})
MERGE (t)-[:IMPLEMENTED_BY_FLOW]->(f);
MATCH (f:FindTheFeelingFlow {id: 'find_the_feeling_flow'}), (u:FeelingUrge)
MERGE (f)-[:INCLUDES_URGE]->(u);
MATCH (f:FindTheFeelingFlow {id: 'find_the_feeling_flow'}), (fam:FeelingFamily)
MERGE (f)-[:INCLUDES_FAMILY]->(fam);

CREATE INDEX find_the_feeling_session_created IF NOT EXISTS
FOR (s:FindTheFeelingSession) ON (s.createdAt);
