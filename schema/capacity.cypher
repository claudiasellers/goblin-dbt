// ============================================================
// CAPACITY BAND (ER-01) — capacity-v1 (plan A4-1)
// GENERATED by scripts/capacity/build.py from content.py. Edit content.py, not this file.
// The relational capacity probe (steady · stirred · flooded) that replaces 0–10 scales, the
// breakdown hand-off primitives (interim: Recover's sigh, FTF's orient) and the band rules
// Phase A reads (DEAR MAN). A reading is a value object stored on the log record that asked
// (CheckIn / ToolSession), never a node (ruling R1).
// Run AFTER invalidation-recovery.cypher (cyclic_sighing, linehan_skills_2015). Idempotent:
// MERGE + SET only; constraints live in constraints.cypher. Copy is reviewStatus "draft".
// ============================================================

// --- Clinical sources ---
MERGE (s:ClinicalSource {id: "arnsten_2009"})
SET s.title = "Arnsten (2009), Nature Reviews Neuroscience — stress signalling pathways that impair prefrontal cortex structure and function", s.url = "https://doi.org/10.1038/nrn2648";
MERGE (s:ClinicalSource {id: "suvak_2011"})
SET s.title = "Suvak et al. (2011), Journal of Abnormal Psychology — emotional granularity and borderline personality disorder", s.url = "https://doi.org/10.1037/a0021808";

// --- The probe (+ hand-off copy and band → intensity compatibility) ---
MERGE (p:CapacityProbe {id: 'capacity_probe'})
SET p.version = "capacity-v1", p.freshMinutes = 20, p.reviewStatus = "draft", p.contentJson = "{\"version\": \"capacity-v1\", \"freshMinutes\": 20, \"bandIntensity\": {\"steady\": 0.35, \"stirred\": 0.6, \"flooded\": 0.85}, \"bandLabels\": {\"steady\": \"Steady\", \"stirred\": \"Stirred\", \"flooded\": \"Flooded\"}, \"probe\": {\"wordings\": {\"default\": {\"prompt\": \"If someone asked you for a favour right now, you'd…\", \"incoming\": \"hey, could you help me with something?\", \"options\": {\"steady\": \"Say yes like normal\", \"stirred\": \"Say yes, but with an edge\", \"flooded\": \"Couldn't answer, or would regret it\"}}, \"relational\": {\"prompt\": \"If {label} texted you right now, you'd…\", \"someone\": \"If they texted you right now, you'd…\", \"incoming\": \"hey, can we talk?\", \"options\": {\"steady\": \"Reply like normal\", \"stirred\": \"Reply with an edge\", \"flooded\": \"Couldn't reply, or would regret it\"}}}, \"cantTell\": \"I can't tell\"}, \"handoff\": {\"card\": {\"body\": \"This is a body moment, not a thinking moment. That's not you failing.\", \"start\": \"Start\", \"keepGoing\": \"Keep going anyway\", \"keepGoingHeadsUp\": \"Thinking may feel slippery right now. Short answers are fine.\"}, \"reread\": {\"prompt\": \"Compared to a minute ago, it's…\", \"options\": {\"worse\": \"Louder\", \"same\": \"About the same\", \"better\": \"Quieter\", \"much_better\": \"Much quieter\"}}, \"resumeLine\": \"Picking up where we were.\", \"secondLead\": \"One more, a different way.\", \"resumeStale\": \"You were in the middle of something earlier.\", \"later\": {\"offer\": \"Come back to this later\", \"options\": [{\"id\": \"1h\", \"label\": \"In an hour\"}, {\"id\": \"evening\", \"label\": \"This evening\"}, {\"id\": \"tomorrow\", \"label\": \"Tomorrow\"}], \"scheduled\": \"Saved for later. It will keep.\", \"holding\": \"You can stop here. Nothing is lost.\"}, \"tooMuchLink\": \"This is too much right now\"}}";
MATCH (p:CapacityProbe {id: 'capacity_probe'}), (m:StateModulator {id: 'acute_stress_catecholamine'})
MERGE (m)-[:INFORMS]->(p);
MATCH (p:CapacityProbe {id: 'capacity_probe'}), (s:ClinicalSource)
WHERE s.id IN ["arnsten_2009", "suvak_2011", "linehan_skills_2015"]
MERGE (p)-[:GROUNDED_IN]->(s);

// --- Hand-off primitives (interim; DT-01 adds dt.regulate rows without a contract change) ---
MATCH (:HandoffPrimitive)-[r:IMPLEMENTS]->() DELETE r;
MERGE (h:HandoffPrimitive {id: "sigh"})
SET h.component = "breath_orb", h.direction = "calm", h.bands = ["steady", "stirred", "flooded"], h.blank = "any", h.rank = 0, h.conceptId = "cyclic_sighing", h.copyJson = "{\"title\": \"Let the air out slowly\", \"sub\": \"Two breaths in through the nose, then a long exhale through the mouth. Three rounds.\", \"phases\": [{\"key\": \"in\", \"label\": \"In through your nose\", \"ms\": 2200}, {\"key\": \"sip\", \"label\": \"Sip a little more\", \"ms\": 900}, {\"key\": \"out\", \"label\": \"Long, slow exhale\", \"ms\": 5600}], \"cycles\": 3, \"start\": \"Start · about {seconds} seconds\", \"skip\": \"I'm calmer, skip ahead\", \"done\": \"Good.\"}";
MATCH (h:HandoffPrimitive {id: "sigh"}), (c:TherapyConcept {id: "cyclic_sighing"})
MERGE (h)-[:IMPLEMENTS]->(c);
MERGE (h:HandoffPrimitive {id: "orient"})
SET h.component = "orient", h.direction = "orient", h.bands = ["steady", "stirred", "flooded"], h.blank = "any", h.rank = 1, h.conceptId = "se_orienting", h.copyJson = "{\"title\": \"Come back into the room\", \"sub\": \"Before any words. Just get your bearings.\", \"look\": \"Look around slowly. Each time something catches your eye, tap a circle.\", \"move\": \"Stand up and shake out your hands\", \"moveSeconds\": 20, \"startMove\": \"Start\", \"skip\": \"Skip this\", \"seen\": \"{n} of 3 found\"}";
MATCH (h:HandoffPrimitive {id: "orient"}), (c:TherapyConcept {id: "se_orienting"})
MERGE (h)-[:IMPLEMENTS]->(c);

// --- Band rules (Phase A: DEAR MAN only) ---
MATCH (:BandRule)-[r:FOR_SKILL]->() DELETE r;
MERGE (r:BandRule {id: "dear-man:steady"})
SET r.skillId = "dear-man", r.band = "steady", r.mode = "full", r.copyJson = "{}";
MATCH (r:BandRule {id: "dear-man:steady"}), (tc:TherapyConcept {id: "dbt_dear_man"})
MERGE (r)-[:FOR_SKILL]->(tc);
MERGE (r:BandRule {id: "dear-man:stirred"})
SET r.skillId = "dear-man", r.band = "stirred", r.mode = "full", r.copyJson = "{\"headsUp\": \"summary\"}";
MATCH (r:BandRule {id: "dear-man:stirred"}), (tc:TherapyConcept {id: "dbt_dear_man"})
MERGE (r)-[:FOR_SKILL]->(tc);
MERGE (r:BandRule {id: "dear-man:flooded"})
SET r.skillId = "dear-man", r.band = "flooded", r.mode = "handoff", r.copyJson = "{}";
MATCH (r:BandRule {id: "dear-man:flooded"}), (tc:TherapyConcept {id: "dbt_dear_man"})
MERGE (r)-[:FOR_SKILL]->(tc);
MATCH (m:StateModulator {id: 'acute_stress_catecholamine'}), (r:BandRule)
MERGE (m)-[:INFORMS]->(r);
