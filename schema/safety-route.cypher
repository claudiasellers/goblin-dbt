SET l.name = "Tele-MANAS", l.kind = "crisis", l.phone = "14416", l.sms = null, l.smsBody = null, l.chatUrl = null, l.hours = "24/7", l.languages = ["en", "hi"], l.source = "https://telemanas.mohfw.gov.in", l.checkedAt = "2026-11-12", l.verifiedAt = null, l.order = 0;
MATCH (l:CrisisLine {id: "in_tele_manas"}), (c:Country {id: "IN"})
MERGE (l)-[:COVERS]->(c);
