// ============================================================
// SAFETY ROUTE (CORE-01) — safety-v1
// GENERATED by scripts/safety/build.py from content.py. Edit content.py, not this file.
// SafetyScreenFlow (the question and every screen of the route), Country / CrisisLine (COVERS),
// ASKS_SAFETY (which patterns ask), Emotion.safetyScreen, the SafetyFlag rewrite (userCopy apart
// from the clinician action), core_safety_route / core_means_safety and SafetyPolicy, the switch.
// Off, the check-in behaves exactly as before. Run AFTER knowledge-graph (SafetyFlag, ActivationPattern)
// and emotion-wheel-sync (Emotion). Idempotent: MERGE + SET only. Copy is reviewStatus "draft".
// ============================================================

// --- Clinical sources ---
MERGE (s:ClinicalSource {id: "stanley_brown_2012"})
SET s.title = "Stanley & Brown (2012). Safety Planning Intervention: a brief intervention to mitigate suicide risk. Cognitive and Behavioral Practice 19(2).", s.url = "https://doi.org/10.1016/j.cbpra.2011.01.001";
MERGE (s:ClinicalSource {id: "barber_miller_2014"})
SET s.title = "Barber & Miller (2014). Reducing a suicidal person's access to lethal means of suicide. American Journal of Preventive Medicine 47(3S2).", s.url = "https://doi.org/10.1016/j.amepre.2014.05.028";
MERGE (s:ClinicalSource {id: "dazzi_2014"})
SET s.title = "Dazzi et al. (2014). Does asking about suicide and related behaviours induce suicidal ideation? Psychological Medicine 44(16).", s.url = "https://doi.org/10.1017/S0033291714001299";
MERGE (s:ClinicalSource {id: "law_2015"})
SET s.title = "Law et al. (2015). A randomized controlled trial of asking about suicidal ideation. (Moderate evidence, KB §6.)", s.url = "";

// --- Concepts ---
MERGE (c:TherapyConcept {id: "core_safety_route"})
SET c.name = "Safety route", c.description = "Ask plainly once, people first, the person's own plan, a safer space, a check-in the next morning.", c.module = 'core';
MATCH (c:TherapyConcept {id: "core_safety_route"}), (s:ClinicalSource)
WHERE s.id IN ["stanley_brown_2012", "dazzi_2014", "law_2015"]
MERGE (c)-[:SUPPORTED_BY]->(s);
MERGE (c:TherapyConcept {id: "core_means_safety"})
SET c.name = "Means safety", c.description = "Putting time and distance between a person and the means on a hard night.", c.module = 'core';
MATCH (c:TherapyConcept {id: "core_means_safety"}), (s:ClinicalSource)
WHERE s.id IN ["barber_miller_2014"]
MERGE (c)-[:SUPPORTED_BY]->(s);
MATCH (a:TherapyConcept {id: 'core_means_safety'}), (b:TherapyConcept {id: 'core_safety_route'})
MERGE (a)-[:PART_OF]->(b);

// --- The flow ---
MERGE (f:SafetyScreenFlow {id: 'safety_screen'})
SET f.version = "safety-v1", f.reviewStatus = "draft", f.repeatAfterNoHours = 12, f.repeatAfterOtherHours = 72, f.contentJson = "{\"act\": {\"choices\": [{\"id\": \"yes\", \"label\": \"Yes\"}, {\"id\": \"no\", \"label\": \"No\"}, {\"id\": \"not_sure\", \"label\": \"Not sure\"}], \"firstAid\": \"Rinse it under cool running water and cover it with something clean. Press firmly on a cut until it stops. If it's deep or gaping, still bleeding after ten minutes of pressure, a burn bigger than your palm, or you feel faint, call the emergency number.\", \"kindTitle\": \"Was it something you took, or an injury?\", \"kinds\": [{\"id\": \"took\", \"label\": \"Something I took or swallowed\"}, {\"id\": \"injury\", \"label\": \"An injury\"}, {\"id\": \"not_sure\", \"label\": \"Not sure\"}], \"medicalChoices\": [{\"id\": \"got_help\", \"label\": \"I've got help\"}, {\"id\": \"getting_help\", \"label\": \"I'm getting help\"}, {\"id\": \"not_that_kind\", \"label\": \"It's not that kind of hurt\", \"showWhen\": {\"act\": \"yes\", \"kind\": \"injury\"}}], \"medicalLine\": \"Don't wait to see if it gets better.\", \"medicalTitle\": \"If you're hurt or you've taken something, the emergency number is the right call, even if it feels like too much.\", \"nextDay\": \"Tomorrow, when it's quieter, a look at what led up to this can help next time.\", \"nextDayChoices\": [{\"id\": \"yes\", \"label\": \"Remind me tomorrow\"}, {\"id\": \"no\", \"label\": \"No thanks\"}], \"poison\": \"Poison information\", \"title\": \"Have you already done something to hurt yourself, or taken something?\", \"tookLine\": \"Some things you take don't hurt at first and do harm hours later. Call now, even if you feel all right. Keep the packaging or the name of what you took.\"}, \"answerRank\": {\"act\": 4, \"declined\": 1, \"no\": 0, \"passing\": 1, \"plan\": 3, \"strong\": 2}, \"cantTell\": \"Goblin can't judge how safe you are right now. The people on these lines are trained to help with that.\", \"checkin\": {\"choices\": [{\"id\": \"yes\", \"label\": \"Yes\"}, {\"id\": \"no\", \"label\": \"No thanks\"}], \"title\": \"Can I check in with you tomorrow morning?\"}, \"declined\": {\"line\": \"That's okay. These are here if you want them.\"}, \"exit\": {\"back\": \"Back to where I was\", \"button\": \"I'm okay for now\", \"choices\": [{\"id\": \"plan\", \"label\": \"I'll use my plan\"}, {\"id\": \"contacted\", \"label\": \"I've contacted someone\"}, {\"id\": \"stop\", \"label\": \"I need to stop here\"}], \"title\": \"Before you go, which is closest?\"}, \"findAHelpline\": {\"label\": \"Find A Helpline\", \"url\": \"https://findahelpline.com\"}, \"header\": {\"label\": \"Help & safety\", \"makePlan\": \"Make a safety plan\", \"people\": \"People you can talk to\", \"plan\": \"My safety plan\", \"say\": \"I'm thinking about hurting myself\"}, \"means\": {\"actions\": [{\"id\": \"other_room\", \"label\": \"Put it in another room\"}, {\"id\": \"give_someone\", \"label\": \"Give it to someone\"}, {\"id\": \"lock_away\", \"label\": \"Lock it away\"}, {\"id\": \"leave_room\", \"label\": \"Leave the room myself\"}, {\"id\": \"cant_now\", \"label\": \"I can't right now\"}], \"actionsTitle\": \"Which of these could you do?\", \"calmTitle\": \"On a hard night, what would be safer out of reach? Who could keep it for you?\", \"choices\": [{\"id\": \"yes\", \"label\": \"Yes\"}, {\"id\": \"not_sure\", \"label\": \"Not sure\"}, {\"id\": \"no\", \"label\": \"No\"}], \"did\": \"I did it\", \"firearm\": \"If there's a gun in the home, could someone else hold it for now, or could it be locked with the key kept elsewhere?\", \"medsLine\": \"Keeping only a small amount of medicine at home, and the rest with someone you trust, makes a hard night safer.\", \"title\": \"Is there anything nearby you might use to hurt yourself?\"}, \"morning\": {\"choices\": [{\"id\": \"okay\", \"label\": \"Doing okay\"}, {\"id\": \"hard\", \"label\": \"Still hard\"}, {\"id\": \"not_safe\", \"label\": \"I'm not safe\"}], \"hard\": \"Thanks for saying. Your plan, or something for the next few minutes.\", \"okay\": \"Glad you're here.\", \"title\": \"How are you this morning?\", \"twiceHard\": \"Two hard mornings in a row. A doctor, therapist or a non-crisis support line can help with this, and you don't have to be in crisis to call.\"}, \"passing\": {\"continue\": \"Carry on\", \"line\": \"Thanks for telling me. That's worth taking seriously, even when it's passing.\", \"makePlan\": \"Make a safety plan\", \"makePlanSub\": \"Five minutes, whenever you're ready\", \"people\": \"People you can talk to\", \"plan\": \"Your safety plan\"}, \"people\": {\"allDay\": \"Any time, day or night\", \"call\": \"Call\", \"chat\": \"Chat\", \"emergency\": \"Emergency: {number}\", \"emergencyOr\": \"Emergency: {number} or {alt}\", \"findLine\": \"Find a line near you\", \"fromPlan\": \"Someone from your plan\", \"heading\": \"People you can talk to\", \"noLine\": \"We don't have a checked line for {country} yet. Find A Helpline lists the ones near you.\", \"notIn\": \"Not in {country}?\", \"pickCountry\": \"Where are you?\", \"text\": \"Text\", \"textBody\": \"Text {body} to {number}\", \"unknownCountry\": \"Your local emergency number\"}, \"question\": {\"choices\": [{\"id\": \"no\", \"label\": \"No\"}, {\"id\": \"passing\", \"label\": \"Some passing thoughts\"}, {\"id\": \"strong\", \"label\": \"Yes, strong thoughts\"}, {\"id\": \"plan\", \"label\": \"I have a plan, or I've already done something\"}, {\"id\": \"declined\", \"label\": \"I'd rather not say\"}], \"helpNowTitle\": \"Let's get you to people first. Which is closest right now?\", \"saidChoices\": [{\"id\": \"passing\", \"label\": \"Some passing thoughts\"}, {\"id\": \"strong\", \"label\": \"Strong thoughts\"}, {\"id\": \"plan\", \"label\": \"I have a plan, or I've already done something\"}, {\"id\": \"declined\", \"label\": \"I'd rather not say\"}], \"saidTitle\": \"Thanks for saying it. Which is closest right now?\", \"title\": \"Sometimes feelings like this come with thoughts of hurting yourself or not wanting to be alive. Is that part of it right now?\"}, \"quickPlan\": {\"deviceSaved\": \"It's kept on this device.\", \"ownMax\": 120, \"save\": \"Keep this\", \"saved\": \"It's kept. It opens from Help & safety.\", \"steps\": [{\"id\": \"sign\", \"placeholder\": \"In your words\", \"title\": \"One thing you're noticing right now that tells you it's a hard time\"}, {\"id\": \"do\", \"placeholder\": \"In your words\", \"title\": \"One thing you can do for the next ten minutes\"}, {\"id\": \"contact\", \"placeholder\": \"A name, or a line\", \"title\": \"One person or line you'll contact\"}]}, \"repeat\": {\"afterNoHours\": 12, \"afterOtherHours\": 72}, \"signedOut\": {\"notNow\": \"Not now\", \"save\": \"Save it\", \"saveToAccount\": \"Save this plan to your account so it's there next time?\"}, \"strong\": {\"fromYourPlan\": \"From your plan\", \"meansFirst\": \"First, one thing to make right now a bit safer.\", \"plan\": \"Open your plan\", \"quickPlan\": \"Make a quick plan\", \"quickPlanSub\": \"Three screens, about a minute\", \"title\": \"You don't have to hold this on your own right now.\", \"whileYouDecide\": \"While you decide\"}, \"version\": \"safety-v1\"}";
MATCH (f:SafetyScreenFlow {id: 'safety_screen'}), (c:TherapyConcept {id: 'core_safety_route'})
MERGE (c)-[:HAS_FLOW]->(f);

// --- Which patterns ask (replaces 'TRIGGERS_SAFETY shows the crisis banner' while the policy is on) ---
MATCH (:ActivationPattern)-[r:ASKS_SAFETY]->(:SafetyScreenFlow) DELETE r;
MATCH (p:ActivationPattern), (f:SafetyScreenFlow {id: 'safety_screen'})
WHERE p.id IN ["emotional_flooding", "dissociation_overmodulation", "rumination_loop", "conservation_freeze", "reward_drive_low"]
MERGE (p)-[:ASKS_SAFETY]->(f);

// --- Emotion.safetyScreen (a word that asks on its own) ---
MATCH (e:Emotion) WHERE e.safetyScreen = true AND NOT e.id IN ["worthless", "empty", "despair", "numb", "helpless", "powerless"]
SET e.safetyScreen = false;
MATCH (e:Emotion) WHERE e.id IN ["worthless", "empty", "despair", "numb", "helpless", "powerless"]
SET e.safetyScreen = true;

// --- SafetyFlag rewrite (userCopy is the only text a screen may show) ---
MATCH (f:SafetyFlag {id: "crisis_suicidal"})
SET f.doNot = "Show coping instead of, or before, people and crisis lines", f.userCopy = "People you can talk to are here, any time.";
MATCH (f:SafetyFlag {id: "crisis_self_harm"})
SET f.doNot = "Show coping instead of, or before, people and crisis lines", f.userCopy = "People you can talk to are here, any time.";
MATCH (f:SafetyFlag {id: "clinical_referral_shutdown"})
SET f.userCopy = "If this has gone on for a while, a doctor or therapist can help with it too.";
MATCH (f:SafetyFlag {id: "clinical_referral_psychosis"})
SET f.userCopy = "What you're going through sounds hard. A doctor or therapist can help make sense of it with you.";
MATCH (f:SafetyFlag {id: "clinical_referral_severe_dissociation"})
SET f.userCopy = "If feeling far away keeps happening, a doctor or therapist can help with it too.";

