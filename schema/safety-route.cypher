SET l.name = "TelefonSeelsorge", l.kind = "crisis", l.phone = "0800 111 0 111", l.sms = null, l.smsBody = null, l.chatUrl = "https://online.telefonseelsorge.de", l.hours = "24/7", l.languages = ["de"], l.source = "https://www.telefonseelsorge.de", l.checkedAt = "2026-11-12", l.verifiedAt = null, l.order = 0;
