// ============================================================
// BODY MAP — body-map-v2 (docs/design/body-map.md)
// GENERATED by scripts/body-map/build.py from content.py. Edit content.py, not this file.
//   BodyRegion        the 15 places the body step uses.
//   SensationType     + padLabel / zones / regions / energy (the sensation chips).
//   FELT_AS           (Emotion)-[:FELT_AS {region, weight, status}]->(SensationType): where each emotion
//                     is felt. The ONE source of that knowledge; rows not in content.py are removed.
//   BodyMap           a family of feelings: -[:GROUPS]-> the emotions whose FELT_AS give its places
//                     (computed by getBodyMapContent, never stored) and -[:MIRRORS]-> the grid words
//                     (Emotion nodes from emotion-wheel-sync) it answers.
// Only status "live" is served; drafts are loaded but never served.
// Run AFTER knowledge-graph.cypher (SensationType, Emotion) and emotion-wheel-sync.cypher (grid
// words). Idempotent: MERGE + SET, removed rows pruned by id; constraints live in constraints.cypher.
// ============================================================

MERGE (c:BodyMapContent {id: 'body_map'})
SET c.version = "body-map-v2", c.regions = ["head", "face", "jaw", "throat", "neck", "shoulders", "chest", "upper_back", "stomach", "lower_back", "arms", "hands", "legs", "feet", "body"];

// --- Body regions (the 15 places) ---
MERGE (r:BodyRegion {id: "head"})
SET r += {name: "Head", includes: ["forehead", "temples", "scalp"], rank: 0};
MERGE (r:BodyRegion {id: "face"})
SET r += {name: "Face", includes: ["eyes", "cheeks", "mouth"], rank: 1};
MERGE (r:BodyRegion {id: "jaw"})
SET r += {name: "Jaw", includes: ["jaw", "teeth"], rank: 2};
MERGE (r:BodyRegion {id: "throat"})
SET r += {name: "Throat", includes: ["throat"], rank: 3};
MERGE (r:BodyRegion {id: "neck"})
SET r += {name: "Neck", includes: ["back of the neck"], rank: 4};
MERGE (r:BodyRegion {id: "shoulders"})
SET r += {name: "Shoulders", includes: ["shoulders"], rank: 5};
MERGE (r:BodyRegion {id: "chest"})
SET r += {name: "Chest", includes: ["heart area", "lungs", "sternum"], rank: 6};
MERGE (r:BodyRegion {id: "upper_back"})
SET r += {name: "Upper back", includes: ["between the shoulder blades", "upper spine"], rank: 7};
MERGE (r:BodyRegion {id: "stomach"})
SET r += {name: "Stomach", includes: ["stomach", "solar plexus", "abdomen", "gut"], rank: 8};
MERGE (r:BodyRegion {id: "lower_back"})
SET r += {name: "Lower back", includes: ["lower back", "hips"], rank: 9};
MERGE (r:BodyRegion {id: "arms"})
SET r += {name: "Arms", includes: ["upper arms", "forearms"], rank: 10};
MERGE (r:BodyRegion {id: "hands"})
SET r += {name: "Hands", includes: ["hands", "fingers"], rank: 11};
MERGE (r:BodyRegion {id: "legs"})
SET r += {name: "Legs", includes: ["thighs", "knees", "calves"], rank: 12};
MERGE (r:BodyRegion {id: "feet"})
SET r += {name: "Feet", includes: ["feet", "toes"], rank: 13};
MERGE (r:BodyRegion {id: "body"})
SET r += {name: "Whole body", includes: ["all over"], rank: 14};
MATCH (r:BodyRegion) WHERE NOT r.id IN ["head", "face", "jaw", "throat", "neck", "shoulders", "chest", "upper_back", "stomach", "lower_back", "arms", "hands", "legs", "feet", "body"]
DETACH DELETE r;

// --- Pad words (SensationType) ---
MERGE (s:SensationType {id: "tension"})
SET s += {padLabel: "Tight", zones: ["hu"], regions: [], energy: "more", padRank: 0, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
MERGE (s:SensationType {id: "pressure"})
SET s += {padLabel: "Pressure", zones: ["hu"], regions: [], energy: "more", padRank: 1, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
MERGE (s:SensationType {id: "raised_up"})
SET s += {padLabel: "Raised up", zones: ["hu"], regions: ["shoulders"], energy: "more", padRank: 2, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null, name: "Raised up"};
MERGE (s:SensationType {id: "clenched"})
SET s += {padLabel: "Clenched", zones: ["hu"], regions: ["jaw", "hands", "stomach"], energy: "more", padRank: 3, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null, name: "Clenched"};
MERGE (s:SensationType {id: "racing_heart"})
SET s += {padLabel: "Racing", zones: ["hu", "hp"], regions: ["chest"], energy: "more", padRank: 4, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
MERGE (s:SensationType {id: "pounding"})
SET s += {padLabel: "Pounding", zones: ["hu"], regions: ["chest", "head"], energy: "more", padRank: 5, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null, name: "Pounding"};
MERGE (s:SensationType {id: "heat"})
SET s += {padLabel: "Hot", zones: ["hu"], regions: ["head", "face", "chest", "body"], energy: "more", padRank: 6, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
MERGE (s:SensationType {id: "burning"})
SET s += {padLabel: "Burning", zones: ["hu"], regions: ["face", "throat", "chest", "stomach"], energy: "more", padRank: 7, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null, name: "Burning"};
MERGE (s:SensationType {id: "constriction"})
SET s += {padLabel: "Closing up", zones: ["hu"], regions: ["throat", "chest"], energy: "more", padRank: 8, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
MERGE (s:SensationType {id: "shaking"})
SET s += {padLabel: "Shaky", zones: ["hu"], regions: ["hands", "arms", "legs", "body"], energy: "more", padRank: 9, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null};
