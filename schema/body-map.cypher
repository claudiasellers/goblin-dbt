SET s += {padLabel: "Knotted", zones: ["hu"], regions: ["stomach", "upper_back", "lower_back"], energy: "more", padRank: 11, padStatus: "draft", padReviewStatus: "draft", padReviewedAt: null, name: "Knotted"};
MERGE (s:SensationType {id: "churning"})
