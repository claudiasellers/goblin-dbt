// --- Retire pad words removed from content.py (the SensationType stays; it's shared with FELT_AS) ---
MATCH (s:SensationType) WHERE s.padStatus IS NOT NULL AND NOT s.id IN ["tension", "pressure", "raised_up", "clenched", "racing_heart", "pounding", "heat", "burning", "constriction", "shaking", "restlessness", "knotted", "churning", "buzzing", "achy", "heaviness", "numbness_sensation", "drained", "weakness", "cold_sensation", "hollow", "sinking", "foggy", "lump", "slumped", "butterflies", "tingly", "lightness", "warmth", "expansion", "fizzy", "bouncy", "smiling", "energised", "settled", "loose", "soft", "groundedness", "easy_breathing", "rested"]
SET s.padStatus = 'retired';

// --- Prune places and maps removed from content.py ---
MATCH (p:BodyMapPlace) WHERE NOT p.id IN ["fear:chest:racing_heart", "fear:throat:constriction", "fear:stomach:butterflies", "fear:shoulders:raised_up", "fear:hands:shaking", "fear:legs:weakness", "anger:head:heat", "anger:face:heat", "anger:jaw:clenched", "anger:hands:clenched", "anger:chest:pressure", "anger:arms:tension", "sadness:chest:heaviness", "sadness:throat:lump", "sadness:arms:heaviness", "sadness:legs:heaviness", "sadness:head:pressure", "shame:face:heat", "shame:chest:sinking", "shame:stomach:sinking", "shame:shoulders:slumped", "guilt:chest:heaviness", "guilt:stomach:knotted", "guilt:shoulders:heaviness", "guilt:head:pressure", "disgust:stomach:churning", "disgust:throat:constriction", "disgust:face:tension", "depleted:body:drained", "depleted:head:foggy", "depleted:arms:heaviness", "depleted:legs:heaviness", "depleted:chest:hollow", "love:chest:warmth", "love:face:warmth", "love:stomach:butterflies", "love:body:warmth", "love:hands:tingly", "joy:chest:lightness", "joy:face:smiling", "joy:body:lightness", "joy:arms:energised", "joy:legs:bouncy", "excitement:stomach:fizzy", "excitement:chest:racing_heart", "excitement:hands:tingly", "excitement:legs:bouncy", "excitement:body:energised", "surprise:chest:racing_heart", "surprise:head:buzzing", "surprise:stomach:butterflies", "calm:shoulders:loose", "calm:chest:easy_breathing", "calm:stomach:settled", "calm:jaw:loose", "calm:feet:groundedness"]
DETACH DELETE p;
MATCH (m:BodyMap) WHERE NOT m.id IN ["fear", "anger", "sadness", "shame", "guilt", "disgust", "depleted", "love", "joy", "excitement", "surprise", "calm"]
DETACH DELETE m;
