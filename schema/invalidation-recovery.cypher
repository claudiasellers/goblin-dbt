// ============================================================
// INVALIDATION RECOVERY ("Recover from a hurtful moment") — recovery-v1
// GENERATED by scripts/invalidation-recovery/build.py from content.py. Edit content.py, not this file.
// Body-first protocol for the invalidated → abandoned cluster.
// Run AFTER opposite-action-flow.cypher. Idempotent: MERGE + SET only,
// constraints IF NOT EXISTS. Links into existing Emotion, ActivationPattern,
// TherapyConcept and ClinicalSource nodes instead of duplicating them.
// App wording is original; see docs/design/recover-from-invalidation.md.
// ============================================================

CREATE CONSTRAINT invalidation_event_id IF NOT EXISTS
FOR (n:InvalidationEvent) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT recovery_protocol_id IF NOT EXISTS
FOR (n:RecoveryProtocol) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT unmet_need_id IF NOT EXISTS
FOR (n:UnmetNeed) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT social_need_id IF NOT EXISTS
FOR (n:SocialNeed) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT recovery_exit_id IF NOT EXISTS
FOR (n:RecoveryExit) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT practice_skill_id IF NOT EXISTS
FOR (n:PracticeSkill) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT invalidation_recovery_session_key IF NOT EXISTS
FOR (s:InvalidationRecoverySession) REQUIRE s.key IS UNIQUE;

// --- New therapy concepts (only those not already in knowledge-graph.cypher) ---
MERGE (c:TherapyConcept {id: "dbt_walking_middle_path"})
SET c.name = "Walking the Middle Path", c.description = "Dialectics, validating yourself and others, and strategies for changing behaviour", c.modality = "DBT", c.module = "Interpersonal Effectiveness";
MATCH (c:TherapyConcept {id: "dbt_walking_middle_path"}), (m:TherapyConcept {id: "dbt_interpersonal_effectiveness"})
MERGE (c)-[:PART_OF]->(m);
MERGE (c:TherapyConcept {id: "self_validation"})
SET c.name = "Self-Validation", c.description = "Acknowledging that your emotion is understandable given its causes, without endorsing every interpretation or urge", c.modality = "DBT", c.module = "Interpersonal Effectiveness";
MATCH (c:TherapyConcept {id: "self_validation"}), (m:TherapyConcept {id: "dbt_walking_middle_path"})
MERGE (c)-[:PART_OF]->(m);
MERGE (c:TherapyConcept {id: "affect_labeling"})
SET c.name = "Affect Labeling", c.description = "Putting a single word to a feeling; implicitly down-regulates the threat response", c.modality = "Cross-modal";
MATCH (c:TherapyConcept {id: "affect_labeling"}), (m:TherapyConcept {id: "dbt_describe"})
MERGE (c)-[:RELATED_TO]->(m);
MERGE (c:TherapyConcept {id: "distanced_self_talk"})
SET c.name = "Distanced Self-Talk", c.description = "Using your own name or 'you' instead of 'I' to gain psychological distance", c.modality = "Cross-modal";
MERGE (c:TherapyConcept {id: "self_compassion_break"})
SET c.name = "Self-Compassion Break", c.description = "Mindfulness of suffering, common humanity, and self-kindness, including a protective (fierce) line", c.modality = "Compassion-focused";
MERGE (c:TherapyConcept {id: "security_priming"})
SET c.name = "Security Priming", c.description = "Briefly imagining a secure attachment figure to lower threat and hostility", c.modality = "Attachment";
MERGE (c:TherapyConcept {id: "cyclic_sighing"})
SET c.name = "Cyclic Sighing", c.description = "Double inhale through the nose followed by a long exhale; fastest reliable breathing downshift", c.modality = "Physiological";
MATCH (c:TherapyConcept {id: "cyclic_sighing"}), (m:TherapyConcept {id: "dbt_tipp"})
MERGE (c)-[:RELATED_TO]->(m);
MERGE (c:TherapyConcept {id: "rumination_postponement"})
SET c.name = "Rumination Postponement", c.description = "Scheduling a set time for replay and using it for concrete next steps", c.modality = "CBT";
MERGE (c:TherapyConcept {id: "need_restoration"})
SET c.name = "Need Restoration", c.description = "Restoring the specific social need threatened by exclusion (belonging, worth, control, mattering) through a prosocial route", c.modality = "Social psychology";
MERGE (c:TherapyConcept {id: "dbt_recovering_from_invalidation"})
SET c.name = "Recovering from Invalidation", c.description = "Body-first sequence after someone dismisses, mocks, excludes or pulls away: settle, name it, self-validate, name the need, then ask (DEAR MAN), let it land, or act opposite", c.modality = "DBT", c.module = "Interpersonal Effectiveness";
MATCH (c:TherapyConcept {id: "dbt_recovering_from_invalidation"}), (m:TherapyConcept {id: "dbt_walking_middle_path"})
MERGE (c)-[:PART_OF]->(m);
MATCH (t:TherapyConcept {id: 'dbt_recovering_from_invalidation'})
SET t.whenToUse = 'When someone brushed you off, mocked you, left you out, or pulled away', t.dbtBasis = 'Walking the Middle Path (validation, recovering from invalidation) with STOP, TIPP, Opposite Action and Radical Acceptance; asking hands off to DEAR MAN';
// Recommended by getStateAndTools (normalizeToolId -> 'recovering-from-invalidation') for patterns associated with these emotions.
MATCH (:TherapyConcept {id: 'dbt_recovering_from_invalidation'})-[r:ADDRESSES]->() DELETE r;
UNWIND ["hurt", "humiliated", "rejected", "excluded", "abandoned", "rejection", "hot_shame"] AS eid
MATCH (t:TherapyConcept {id: 'dbt_recovering_from_invalidation'}), (e:Emotion {id: eid})
MERGE (t)-[:ADDRESSES]->(e);

// --- Clinical sources ---
MERGE (s:ClinicalSource {id: "linehan_skills_2015"})
SET s.title = "Marsha M. Linehan — DBT Skills Training Manual, 2nd ed. (2015): validation, STOP, TIPP, opposite action, DEAR MAN/GIVE/FAST, radical acceptance", s.url = "https://www.guilford.com/books/DBT-Skills-Training-Manual/Marsha-Linehan/9781462516995";
MERGE (s:ClinicalSource {id: "shenk_fruzzetti_2011"})
SET s.title = "Shenk & Fruzzetti (2011), J. Social and Clinical Psychology — invalidation raises negative affect and arousal; validation prevents the rise", s.url = "https://doi.org/10.1521/jscp.2011.30.2.163";
MERGE (s:ClinicalSource {id: "williams_2009"})
SET s.title = "Williams (2009), Advances in Experimental Social Psychology — temporal need-threat model of ostracism", s.url = "https://doi.org/10.1016/S0065-2601(08)00406-1";
MERGE (s:ClinicalSource {id: "kross_2014"})
SET s.title = "Kross et al. (2014), JPSP — self-talk as a regulatory mechanism (distanced self-talk)", s.url = "https://doi.org/10.1037/a0035173";
MERGE (s:ClinicalSource {id: "balban_2023"})
SET s.title = "Balban et al. (2023), Cell Reports Medicine — brief structured respiration (cyclic sighing) RCT", s.url = "https://doi.org/10.1016/j.xcrm.2022.100895";
MERGE (s:ClinicalSource {id: "pascual_leone_2007"})
SET s.title = "Pascual-Leone & Greenberg (2007), JCCP — emotional processing: grieving unmet needs", s.url = "https://doi.org/10.1037/0022-006X.75.6.875";
MERGE (s:ClinicalSource {id: "ferrari_2019"})
SET s.title = "Ferrari et al. (2019), Mindfulness — self-compassion interventions meta-analysis", s.url = "https://doi.org/10.1007/s12671-019-01134-6";
MERGE (s:ClinicalSource {id: "gillath_2022"})
SET s.title = "Gillath et al. (2022), Personality and Social Psychology Review — attachment security priming meta-analysis", s.url = "https://doi.org/10.1177/10888683211054592";
MERGE (s:ClinicalSource {id: "torre_lieberman_2018"})
SET s.title = "Torre & Lieberman (2018), Emotion Review — affect labeling as implicit emotion regulation", s.url = "https://doi.org/10.1177/1754073917742706";
MERGE (s:ClinicalSource {id: "watkins_2012"})
SET s.title = "Watkins et al. (2012), Psychological Medicine — guided self-help concreteness training for depression, Phase II RCT", s.url = "https://doi.org/10.1017/S0033291711002480";
MERGE (s:ClinicalSource {id: "mcgowan_behar_2013"})
SET s.title = "McGowan & Behar (2013), Behavior Modification — stimulus control training (worry postponement), preliminary RCT", s.url = "https://doi.org/10.1177/0145445512455661";

// --- Protocols A–D (validation lines; {N} = name or 'you', {phrase} = state phrase) ---
MATCH (:RecoveryProtocol)-[r:DRAWS_ON]->() DELETE r;
MERGE (p:RecoveryProtocol {id: "not_received"})
SET p.label = "Not received", p.validationLines = ["{N}, of course that stung. You were trying to be heard and got {phrase}.", "Anyone who wanted to be understood would feel this.", "{N}'s hurt makes sense. The story about it might not.", "{N} can know this hurt without needing them to be the villain."];
UNWIND ["self_validation", "affect_labeling", "distanced_self_talk", "dbt_dear_man"] AS cid
MATCH (p:RecoveryProtocol {id: "not_received"}), (c:TherapyConcept {id: cid})
MERGE (p)-[:DRAWS_ON]->(c);
MERGE (p:RecoveryProtocol {id: "diminished_self"})
SET p.label = "Diminished self", p.validationLines = ["{N}, this is a moment of hurt. Being {phrase} hurts anyone.", "{N}'s feeling is real. It isn't a verdict on {N}.", "Feeling small right now doesn't make {N} small.", "Both can be true: {N} is sensitive to this, and it hurt."];
UNWIND ["self_validation", "self_compassion_break", "act_values", "dbt_opposite_action"] AS cid
MATCH (p:RecoveryProtocol {id: "diminished_self"}), (c:TherapyConcept {id: cid})
MERGE (p)-[:DRAWS_ON]->(c);
MERGE (p:RecoveryProtocol {id: "blocked_wronged"})
SET p.label = "Blocked or wronged", p.validationLines = ["{N}, it makes sense you're furious. Something mattered and got {phrase}.", "{N} can know this was unfair without replaying it all night.", "It's understandable {N} is angry. {N} chooses the next move.", "Both can be true: this felt wrong, and {N} gets to decide what happens next."];
UNWIND ["self_validation", "dbt_stop", "cbt_should_statements", "rumination_postponement"] AS cid
MATCH (p:RecoveryProtocol {id: "blocked_wronged"}), (c:TherapyConcept {id: cid})
MERGE (p)-[:DRAWS_ON]->(c);
MERGE (p:RecoveryProtocol {id: "attachment_alarm"})
SET p.label = "Attachment alarm", p.validationLines = ["{N}, of course you're scared. Losing connection sets off a real alarm.", "This is real pain. Being pushed away hurts anyone.", "{N} can hold this fear without chasing.", "The alarm is loud. That doesn't mean the relationship is over."];
UNWIND ["self_validation", "security_priming", "dbt_opposite_action"] AS cid
MATCH (p:RecoveryProtocol {id: "attachment_alarm"}), (c:TherapyConcept {id: cid})
MERGE (p)-[:DRAWS_ON]->(c);

// --- Invalidation events (what the user taps, in their words) ---
// Clear outgoing edges first so shrinking a list on re-run leaves no stale links.
MATCH (:InvalidationEvent)-[r:HAS_PROTOCOL|OFTEN_FEELS|SIGNALS]->() DELETE r;
MERGE (w:InvalidationEvent {id: "brushed"})
SET w.label = "They brushed off what I said", w.covers = ["dismissed", "minimized", "invalidated"], w.phrase = "brushed off", w.highRisk = false, w.lowArousal = false, w.order = 0;
MATCH (w:InvalidationEvent {id: "brushed"}), (p:RecoveryProtocol {id: "not_received"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "hurt", rank: 0}, {id: "disrespected", rank: 1}, {id: "frustrated", rank: 2}, {id: "let_down", rank: 3}, {id: "lonely", rank: 4}] AS row
MATCH (w:InvalidationEvent {id: "brushed"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["social_threat_shame", "reactive_aggression"] AS pid
MATCH (w:InvalidationEvent {id: "brushed"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "unheard"})
SET w.label = "They didn't hear me or got me wrong", w.covers = ["unheard", "misunderstood"], w.phrase = "not heard", w.highRisk = false, w.lowArousal = false, w.order = 1;
MATCH (w:InvalidationEvent {id: "unheard"}), (p:RecoveryProtocol {id: "not_received"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "lonely", rank: 0}, {id: "hurt", rank: 1}, {id: "frustrated", rank: 2}, {id: "isolated", rank: 3}, {id: "let_down", rank: 4}] AS row
MATCH (w:InvalidationEvent {id: "unheard"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["social_threat_shame"] AS pid
MATCH (w:InvalidationEvent {id: "unheard"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "mocked"})
SET w.label = "They mocked me or twisted my words", w.covers = ["trivialized", "caricatured"], w.phrase = "made into a caricature", w.highRisk = true, w.lowArousal = false, w.order = 2;
MATCH (w:InvalidationEvent {id: "mocked"}), (p:RecoveryProtocol {id: "not_received"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
MATCH (w:InvalidationEvent {id: "mocked"}), (p:RecoveryProtocol {id: "blocked_wronged"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = false;
UNWIND [{id: "humiliated", rank: 0}, {id: "ridiculed", rank: 1}, {id: "furious", rank: 2}, {id: "embarrassed", rank: 3}, {id: "disrespected", rank: 4}] AS row
MATCH (w:InvalidationEvent {id: "mocked"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["reactive_aggression", "social_threat_shame"] AS pid
MATCH (w:InvalidationEvent {id: "mocked"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "small"})
SET w.label = "They made me feel small", w.covers = ["devalued", "deflated", "flawed", "insignificant"], w.phrase = "made to feel small", w.highRisk = false, w.lowArousal = true, w.order = 3;
MATCH (w:InvalidationEvent {id: "small"}), (p:RecoveryProtocol {id: "diminished_self"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "ashamed", rank: 0}, {id: "inadequate", rank: 1}, {id: "worthless", rank: 2}, {id: "insignificant", rank: 3}, {id: "powerless", rank: 4}, {id: "numb", rank: 5}] AS row
MATCH (w:InvalidationEvent {id: "small"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["social_threat_shame"] AS pid
MATCH (w:InvalidationEvent {id: "small"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "ignored"})
SET w.label = "I was ignored or left out", w.covers = ["invisible", "ostracized"], w.phrase = "left out", w.highRisk = false, w.lowArousal = true, w.order = 4;
MATCH (w:InvalidationEvent {id: "ignored"}), (p:RecoveryProtocol {id: "diminished_self"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
MATCH (w:InvalidationEvent {id: "ignored"}), (p:RecoveryProtocol {id: "attachment_alarm"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = false;
UNWIND [{id: "excluded", rank: 0}, {id: "rejected", rank: 1}, {id: "lonely", rank: 2}, {id: "isolated", rank: 3}, {id: "insignificant", rank: 4}, {id: "numb", rank: 5}] AS row
MATCH (w:InvalidationEvent {id: "ignored"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["social_threat_shame", "grief_yearning"] AS pid
MATCH (w:InvalidationEvent {id: "ignored"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "leaving"})
SET w.label = "They pulled away and I'm scared they'll leave", w.covers = ["abandoned"], w.phrase = "left hanging by someone who matters", w.highRisk = false, w.lowArousal = false, w.order = 5;
MATCH (w:InvalidationEvent {id: "leaving"}), (p:RecoveryProtocol {id: "attachment_alarm"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "abandoned", rank: 0}, {id: "scared", rank: 1}, {id: "rejected", rank: 2}, {id: "anxious", rank: 3}, {id: "lonely", rank: 4}, {id: "numb", rank: 5}] AS row
MATCH (w:InvalidationEvent {id: "leaving"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["acute_alarm", "grief_yearning"] AS pid
MATCH (w:InvalidationEvent {id: "leaving"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "blocked"})
SET w.label = "Something I need keeps getting blocked", w.covers = ["frustrated"], w.phrase = "blocked", w.highRisk = false, w.lowArousal = false, w.order = 6;
MATCH (w:InvalidationEvent {id: "blocked"}), (p:RecoveryProtocol {id: "blocked_wronged"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "frustrated", rank: 0}, {id: "furious", rank: 1}, {id: "powerless", rank: 2}, {id: "annoyed", rank: 3}, {id: "resentful", rank: 4}] AS row
MATCH (w:InvalidationEvent {id: "blocked"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["reactive_aggression"] AS pid
MATCH (w:InvalidationEvent {id: "blocked"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);
MERGE (w:InvalidationEvent {id: "stewing"})
SET w.label = "It keeps happening and I can't let it go", w.covers = ["resentful"], w.phrase = "wronged again", w.highRisk = false, w.lowArousal = false, w.order = 7;
MATCH (w:InvalidationEvent {id: "stewing"}), (p:RecoveryProtocol {id: "blocked_wronged"})
MERGE (w)-[r:HAS_PROTOCOL]->(p) SET r.primary = true;
UNWIND [{id: "resentful", rank: 0}, {id: "bitter", rank: 1}, {id: "betrayed", rank: 2}, {id: "furious", rank: 3}, {id: "hurt", rank: 4}] AS row
MATCH (w:InvalidationEvent {id: "stewing"}), (e:Emotion {id: row.id})
MERGE (w)-[r:OFTEN_FEELS]->(e) SET r.rank = row.rank;
UNWIND ["rumination_loop", "reactive_aggression"] AS pid
MATCH (w:InvalidationEvent {id: "stewing"}), (a:ActivationPattern {id: pid})
MERGE (w)-[:SIGNALS]->(a);

// --- Social needs (Williams) and unmet needs ---
MATCH (:SocialNeed)-[r:RESTORED_BY]->() DELETE r;
MATCH (:UnmetNeed)-[r:THREATENS]->() DELETE r;
MERGE (s:SocialNeed {id: "belonging"})
SET s.elsewhereTitle = "Borrow a safe person", s.elsewhereAct = "Send one person: \"Can I tell you something? No advice, just listen.\"", s.practiceSkill = "validating_other";
MATCH (s:SocialNeed {id: "belonging"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (s)-[:RESTORED_BY]->(c);
MERGE (s:SocialNeed {id: "worth"})
SET s.elsewhereTitle = "Remember what you stand for", s.elsewhereAct = "Pick your top value, then one time this week you lived it.", s.practiceSkill = "values";
MATCH (s:SocialNeed {id: "worth"}), (c:TherapyConcept {id: "act_values"})
MERGE (s)-[:RESTORED_BY]->(c);
MERGE (s:SocialNeed {id: "control"})
SET s.elsewhereTitle = "Take back one thing", s.elsewhereAct = "Choose one thing in the next hour that is fully yours to decide.", s.practiceSkill = "one_thing";
MATCH (s:SocialNeed {id: "control"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (s)-[:RESTORED_BY]->(c);
MERGE (s:SocialNeed {id: "mattering"})
SET s.elsewhereTitle = "Matter to someone", s.elsewhereAct = "Do one small useful thing for someone. Two minutes is enough.", s.practiceSkill = "mattering";
MATCH (s:SocialNeed {id: "mattering"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (s)-[:RESTORED_BY]->(c);
MERGE (n:UnmetNeed {id: "heard"})
SET n.label = "To be heard", n.order = 0;
MATCH (n:UnmetNeed {id: "heard"}), (s:SocialNeed {id: "mattering"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "respected"})
SET n.label = "To be respected", n.order = 1;
MATCH (n:UnmetNeed {id: "respected"}), (s:SocialNeed {id: "worth"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "included"})
SET n.label = "To be included", n.order = 2;
MATCH (n:UnmetNeed {id: "included"}), (s:SocialNeed {id: "belonging"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "matter"})
SET n.label = "To matter", n.order = 3;
MATCH (n:UnmetNeed {id: "matter"}), (s:SocialNeed {id: "mattering"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "safe"})
SET n.label = "To feel safe with them", n.order = 4;
MATCH (n:UnmetNeed {id: "safe"}), (s:SocialNeed {id: "belonging"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "fair"})
SET n.label = "Fairness", n.order = 5;
MATCH (n:UnmetNeed {id: "fair"}), (s:SocialNeed {id: "control"})
MERGE (n)-[:THREATENS]->(s);
MERGE (n:UnmetNeed {id: "say"})
SET n.label = "To have a say", n.order = 6;
MATCH (n:UnmetNeed {id: "say"}), (s:SocialNeed {id: "control"})
MERGE (n)-[:THREATENS]->(s);

// --- Exits ---
MATCH (:RecoveryExit)-[r:IMPLEMENTS]->() DELETE r;
MERGE (x:RecoveryExit {id: "ask"})
SET x.title = "Ask them to hear you", x.sub = "Take this into Ask for what you need. Your feeling and need come with you.", x.chaseSub = "One calm message. Only one.", x.order = 0;
UNWIND ["dbt_dear_man", "dbt_give", "dbt_fast"] AS cid
MATCH (x:RecoveryExit {id: "ask"}), (c:TherapyConcept {id: cid})
MERGE (x)-[:IMPLEMENTS]->(c);
MERGE (x:RecoveryExit {id: "land"})
SET x.title = "Let it land, meet the need elsewhere", x.sub = "Grieve what you didn't get, set a boundary if you need one, then get the need met another way.", x.chaseSub = null, x.order = 1;
UNWIND ["dbt_radical_acceptance", "dbt_fast", "need_restoration"] AS cid
MATCH (x:RecoveryExit {id: "land"}), (c:TherapyConcept {id: cid})
MERGE (x)-[:IMPLEMENTS]->(c);
MERGE (x:RecoveryExit {id: "opposite"})
SET x.title = "Do the opposite of the urge", x.sub = "One small step against the urge.", x.chaseSub = null, x.order = 2;
UNWIND ["dbt_opposite_action"] AS cid
MATCH (x:RecoveryExit {id: "opposite"}), (c:TherapyConcept {id: cid})
MERGE (x)-[:IMPLEMENTS]->(c);
MERGE (x:RecoveryExit {id: "park"})
SET x.title = "Park the replay", x.sub = "Give the replay a set time tonight. Until then, back to your day.", x.chaseSub = null, x.order = 3;
UNWIND ["rumination_postponement"] AS cid
MATCH (x:RecoveryExit {id: "park"}), (c:TherapyConcept {id: cid})
MERGE (x)-[:IMPLEMENTS]->(c);
MERGE (x:RecoveryExit {id: "prefer"})
SET x.title = "Loosen the \"must\"", x.sub = "Change the demand into a strong preference, then take one step.", x.chaseSub = null, x.order = 4;
UNWIND ["cbt_should_statements"] AS cid
MATCH (x:RecoveryExit {id: "prefer"}), (c:TherapyConcept {id: cid})
MERGE (x)-[:IMPLEMENTS]->(c);

// --- Practice skill deck (grades follow the project's Strong/Moderate/Preliminary scale;
// evidenceBasis says why a skill is Preliminary) ---
MATCH (k:PracticeSkill)-[r:PRACTICES|SUPPORTED_BY]->() WHERE k.id IN ["sigh", "stop", "cold", "orient", "label", "validate", "compassion", "secure", "need", "request", "wait_lock", "accept", "opposite", "park", "values", "validating_other", "one_thing", "mattering", "must_prefer"] DELETE r;
MERGE (k:PracticeSkill {id: "sigh"})
SET k.name = "Cyclic sigh", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "body", k.why = "A long exhale slows your breathing and your heart. Daily practice beat mindfulness on mood in a 28-day trial.", k.order = 0;
MATCH (k:PracticeSkill {id: "sigh"}), (c:TherapyConcept {id: "cyclic_sighing"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["balban_2023"] AS sid
MATCH (k:PracticeSkill {id: "sigh"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "stop"})
SET k.name = "Don't send yet", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Clinical consensus", k.family = "body", k.why = "A few seconds between urge and action prevents the costliest moves.", k.order = 1;
MATCH (k:PracticeSkill {id: "stop"}), (c:TherapyConcept {id: "dbt_stop"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "stop"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "cold"})
SET k.name = "Cold reset", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "body", k.why = "Cold on the face triggers the dive reflex and slows the heart. Brief, so it bridges to the next step.", k.order = 2;
MATCH (k:PracticeSkill {id: "cold"}), (c:TherapyConcept {id: "dbt_tipp"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "cold"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "orient"})
SET k.name = "Orient + move", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Clinical consensus", k.family = "body", k.why = "When you shut down, looking around and moving brings you back. Calming would deepen the slump.", k.order = 3;
MATCH (k:PracticeSkill {id: "orient"}), (c:TherapyConcept {id: "se_orienting"})
MERGE (k)-[:PRACTICES]->(c);
MERGE (k:PracticeSkill {id: "label"})
SET k.name = "Name it", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Putting a word on a feeling quiets the brain's alarm. A tap works; typing it out can lock it in.", k.order = 4;
MATCH (k:PracticeSkill {id: "label"}), (c:TherapyConcept {id: "affect_labeling"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["torre_lieberman_2018"] AS sid
MATCH (k:PracticeSkill {id: "label"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "validate"})
SET k.name = "Self-validation", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Validation stopped the rise in heart rate that invalidation caused. You can give yourself some of it.", k.order = 5;
MATCH (k:PracticeSkill {id: "validate"}), (c:TherapyConcept {id: "self_validation"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["shenk_fruzzetti_2011", "linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "validate"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "compassion"})
SET k.name = "Self-compassion break", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Across 27 trials it cut self-criticism and rumination.", k.order = 6;
MATCH (k:PracticeSkill {id: "compassion"}), (c:TherapyConcept {id: "self_compassion_break"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["ferrari_2019"] AS sid
MATCH (k:PracticeSkill {id: "compassion"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "secure"})
SET k.name = "Secure base", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "people", k.why = "Picturing someone who gets you lowers threat and hostility.", k.order = 7;
MATCH (k:PracticeSkill {id: "secure"}), (c:TherapyConcept {id: "security_priming"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["gillath_2022"] AS sid
MATCH (k:PracticeSkill {id: "secure"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "need"})
SET k.name = "Name the need", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Clinical consensus", k.family = "mind", k.why = "The need turns a feeling into a direction.", k.order = 8;
MATCH (k:PracticeSkill {id: "need"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["pascual_leone_2007"] AS sid
MATCH (k:PracticeSkill {id: "need"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "request"})
SET k.name = "Ask for it", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "people", k.why = "A calm, specific request makes it more likely you'll feel heard and keeps your self-respect.", k.order = 9;
MATCH (k:PracticeSkill {id: "request"}), (c:TherapyConcept {id: "dbt_dear_man"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "request"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "wait_lock"})
SET k.name = "Wait lock", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Clinical consensus", k.family = "people", k.why = "Messages sent at a 5 or under land better than ones sent at an 8.", k.order = 10;
MATCH (k:PracticeSkill {id: "wait_lock"}), (c:TherapyConcept {id: "dbt_stop"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "wait_lock"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "accept"})
SET k.name = "Let it land", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Clinical consensus", k.family = "mind", k.why = "Grieving an unmet need, then meeting it elsewhere, resolves distress better than more protest.", k.order = 11;
MATCH (k:PracticeSkill {id: "accept"}), (c:TherapyConcept {id: "dbt_radical_acceptance"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["pascual_leone_2007", "linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "accept"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "opposite"})
SET k.name = "Do the opposite", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "body", k.why = "Acting against the urge takes the fuel away from the emotion.", k.order = 12;
MATCH (k:PracticeSkill {id: "opposite"}), (c:TherapyConcept {id: "dbt_opposite_action"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS sid
MATCH (k:PracticeSkill {id: "opposite"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "park"})
SET k.name = "Park it", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Scheduling the replay for later teaches you rumination can be controlled.", k.order = 13;
MATCH (k:PracticeSkill {id: "park"}), (c:TherapyConcept {id: "rumination_postponement"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["mcgowan_behar_2013"] AS sid
MATCH (k:PracticeSkill {id: "park"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "values"})
SET k.name = "Values anchor", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Remembering what you stand for makes a threat to your self-image hurt less.", k.order = 14;
MATCH (k:PracticeSkill {id: "values"}), (c:TherapyConcept {id: "act_values"})
MERGE (k)-[:PRACTICES]->(c);
MERGE (k:PracticeSkill {id: "validating_other"})
SET k.name = "Borrow a safe person", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "people", k.why = "Connection regulates. Ask for listening, not a takedown.", k.order = 15;
MATCH (k:PracticeSkill {id: "validating_other"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["shenk_fruzzetti_2011"] AS sid
MATCH (k:PracticeSkill {id: "validating_other"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "one_thing"})
SET k.name = "Take back one thing", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Being excluded threatens control. Restoring a small bit of it helps.", k.order = 16;
MATCH (k:PracticeSkill {id: "one_thing"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["williams_2009"] AS sid
MATCH (k:PracticeSkill {id: "one_thing"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "mattering"})
SET k.name = "Matter to someone", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "people", k.why = "Doing something that matters to someone restores the sense that you exist to others.", k.order = 17;
MATCH (k:PracticeSkill {id: "mattering"}), (c:TherapyConcept {id: "need_restoration"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["williams_2009"] AS sid
MATCH (k:PracticeSkill {id: "mattering"}), (s:ClinicalSource {id: sid})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "must_prefer"})
SET k.name = "Must → prefer", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Changing a demand into a strong preference takes the heat out of frustration.", k.order = 18;
MATCH (k:PracticeSkill {id: "must_prefer"}), (c:TherapyConcept {id: "cbt_should_statements"})
MERGE (k)-[:PRACTICES]->(c);

// --- Flow document (copy + gate thresholds), versioned like OppositeActionFlow ---
MERGE (f:InvalidationRecoveryFlow {id: 'invalidation_recovery_flow'})
SET f.version = "recovery-v1", f.contentJson = "{\"version\": \"recovery-v1\", \"gates\": {\"downshiftAt\": 7, \"coldAt\": 9, \"askMax\": 5, \"waitMinutes\": 20, \"chaseWaitMinutes\": 60, \"validationMax\": 2, \"orientLowArousalAt\": 5, \"certaintyReal\": 80, \"certaintyBoth\": 40}, \"pulls\": [{\"id\": \"fight\", \"label\": \"Fight back\", \"sub\": \"retort, prove them wrong\", \"urgeLabel\": \"fight back\"}, {\"id\": \"chase\", \"label\": \"Chase them\", \"sub\": \"text, over-explain, fix it now\", \"urgeLabel\": \"chase them\"}, {\"id\": \"hide\", \"label\": \"Hide\", \"sub\": \"withdraw, cancel, disappear\", \"urgeLabel\": \"hide\"}, {\"id\": \"freeze\", \"label\": \"Shut down\", \"sub\": \"numb, blank, heavy\", \"urgeLabel\": \"shut down\"}], \"copy\": {\"hero\": {\"eyebrow\": \"90 seconds to 5 minutes\", \"title\": \"Recover from a hurtful moment\", \"body\": \"Brushed off, mocked, made small, left out, left hanging. Settle your body, then decide what to do about them.\"}, \"what\": {\"eyebrow\": \"Recover from a hurtful moment\", \"title\": \"What happened?\", \"sub\": \"Pick the closest one. You can change it later.\"}, \"loud\": {\"title\": \"How loud is it right now?\", \"sub\": \"Two quick taps, then we'll deal with it.\", \"pullPrompt\": \"It's pulling me to…\", \"intensityLabel\": \"How loud is it right now?\", \"urgeLabel\": \"How strong is the pull to {pull}?\", \"low\": \"Quiet\", \"high\": \"Too loud to think\"}, \"stop\": {\"title\": \"Don't send. Not yet.\", \"sub\": \"At this level, anything you send will be louder than you mean it. Lock it first. You can still write it later.\", \"hold\": \"Hold to lock sending\", \"held\": \"Locked. Nothing goes out right now.\", \"lockText\": \"Put the phone down. Nothing gets sent.\"}, \"cold\": {\"eyebrow\": \"Too hot to think\", \"title\": \"Cold reset\", \"sub\": \"Cold on your face slows your heart within seconds.\", \"steps\": [\"Cold water, ice pack, or a cold can.\", \"Press it on your eyes and cheeks.\", \"Hold your breath for 15 to 30 seconds.\"], \"seconds\": 30, \"caution\": \"Skip this if you have a heart condition, an arrhythmia, Raynaud's, or an eating disorder. The effect is brief, so the next step matters.\", \"start\": \"I've got something cold · start\", \"skip\": \"Breathe instead\", \"doneEarly\": \"Done early\"}, \"breathe\": {\"title\": \"Let the air out slowly\", \"sub\": \"Two breaths in through the nose, then a long exhale through the mouth. Three rounds.\", \"phases\": [{\"key\": \"in\", \"label\": \"In through your nose\", \"ms\": 2200}, {\"key\": \"sip\", \"label\": \"Sip a little more\", \"ms\": 900}, {\"key\": \"out\", \"label\": \"Long, slow exhale\", \"ms\": 5600}], \"cycles\": 3, \"start\": \"Start · about {seconds} seconds\", \"skip\": \"I'm calmer, skip ahead\", \"done\": \"Good.\"}, \"orient\": {\"title\": \"Come back into the room\", \"sub\": \"When you want to disappear, calming down makes it heavier. Come back into the room first.\", \"look\": \"Look around slowly. Each time something catches your eye, tap a circle.\", \"move\": \"Stand up and shake out your hands\", \"moveSeconds\": 20, \"startMove\": \"I'm standing · start\", \"seen\": \"{n} of 3 noticed\", \"skip\": \"I can't do this right now · skip\"}, \"rerate\": {\"title\": \"Quick check\", \"sub\": \"Just a number. No right answer.\", \"prompt\": \"How loud is it now?\"}, \"secure\": {\"title\": \"Before anything else\", \"sub\": \"When someone pulls away, the alarm says you're alone. You aren't. Borrow someone who gets you for 25 seconds.\", \"figures\": [\"A person who gets me\", \"A pet\", \"Someone from my past\", \"Future me, a year from now\", \"A spiritual figure\", \"A character I love\"], \"prompts\": [\"See their face.\", \"Hear them say your name.\", \"Notice what it's like to be understood by them.\", \"What would they say about today?\"], \"prompt\": \"Who gets you? It doesn't have to be a person.\", \"start\": \"Picture them · 25 seconds\", \"continue\": \"Continue\"}, \"label\": {\"title\": \"What hit hardest?\", \"sub\": \"One tap. Just a word, no explanation.\", \"other\": \"Another word\", \"pickerPrompt\": \"Which word fits best?\"}, \"validate\": {\"title\": \"This makes sense\", \"sub\": \"Pick one or two that feel true. The feeling makes sense even if the story needs a second look.\", \"stamp\": \"Read this once, out loud if you can\", \"done\": \"That's enough validating\", \"voice\": \"Speaking as {voice} · switch\"}, \"compassion\": {\"title\": \"Self-compassion break\", \"sub\": \"Ninety seconds. The self-critic can wait.\", \"steps\": [{\"line\": \"This is a moment of hurt.\", \"cue\": \"Just name it.\"}, {\"line\": \"Being hurt by people is part of being human. Other people feel this too.\", \"cue\": \"You're not the only one.\"}, {\"line\": \"Hand on your heart, or on your arm if that's easier.\", \"cue\": \"Feel the warmth for three breaths.\"}, {\"line\": \"May I be kind to myself right now.\", \"cue\": \"Say it the way a kind friend would.\"}, {\"line\": \"I won't abandon myself. I can protect this.\", \"cue\": \"The fierce part counts too.\"}], \"note\": \"If kindness toward yourself feels uncomfortable right now, that's common. Imagine saying it to a friend who went through this.\", \"next\": \"Next\", \"done\": \"Done\"}, \"need\": {\"title\": \"Under this, I needed…\", \"sub\": \"The need points to what helps.\"}, \"certainty\": {\"title\": \"Two quick questions about them\", \"sub\": \"This decides what fits next. It doesn't decide whether your hurt counts.\", \"sure\": \"How sure are you they meant it?\", \"pattern\": \"Has this happened before with them?\", \"zones\": {\"real\": {\"title\": \"Treat it as real.\", \"body\": \"It's a pattern and you're sure. No more second-guessing yourself. Go to a request or a boundary.\"}, \"both\": {\"title\": \"Hold both.\", \"body\": \"Maybe they dismissed you, maybe they were distracted. Either way your hurt makes sense. A clarifying question fits here.\"}, \"check\": {\"title\": \"Worth a second look.\", \"body\": \"Old wounds can turn up the volume, and those wounds are real too. A clarifying question costs little.\"}}, \"yes\": \"Yes, it's a pattern\", \"no\": \"Not really\", \"continue\": \"Continue\"}, \"them\": {\"title\": \"About this person\", \"sub\": \"This decides whether asking them is worth it.\", \"safe\": \"Is it safe to bring this up with them?\", \"asks\": \"Have you already asked them to hear you on this?\", \"safetyNote\": \"If someone is hurting or controlling you, safety comes before any of this. In the US you can call or text 988, or reach the Domestic Violence Hotline at 1-800-799-7233.\", \"safeYes\": \"Yes, mostly\", \"safeNo\": \"No, or I'm not sure\", \"asksOptions\": [\"Not yet\", \"Once\", \"Twice or more\"], \"cta\": \"Show my options\"}, \"route\": {\"title\": \"What now?\", \"best\": \"Best fit now\", \"unlockBreathe\": \"Breathe to unlock\", \"unlockOrient\": \"Move to unlock\", \"sub\": \"You're at {now}. The first one fits best right now.\"}, \"locks\": {\"tooHot\": \"Unlocks at {max} or under. You're at {now}.\", \"unsafe\": \"Not with someone who isn't safe to ask.\", \"refused\": \"You've asked twice. Asking again usually re-injures.\", \"deliberate\": \"They're doing this on purpose. Asking gives them another shot.\"}, \"land\": {\"title\": \"Let it land\", \"sub\": \"You don't need them to get it for the need to be met.\", \"grief\": [\"I wanted them to understand.\", \"They can't, or won't, right now.\", \"That's a real loss. It's okay to be sad about it.\", \"I can meet this need somewhere else.\"], \"boundaryIntro\": \"If you need to say something before you step away, a boundary says what you will do. It doesn't argue.\", \"boundary\": \"I've said how this lands. I won't argue about whether my feelings are real. I'm stepping away now.\", \"skipBoundary\": \"I don't need to say anything\", \"cueCalm\": \"Palms up on your lap. Unclench your jaw. Let your shoulders drop while you read.\", \"cueOrient\": \"Feet flat on the floor. Look around the room once while you read.\", \"values\": [\"Honesty\", \"Kindness\", \"Courage\", \"Loyalty\", \"Craft\", \"Fairness\", \"Curiosity\", \"Care for family\"], \"next\": \"Next\", \"continue\": \"Continue\", \"copy\": \"Copy\", \"copied\": \"Copied\", \"boundaryLocked\": \"Copying unlocks at {max} or under. You can still step away without saying anything.\", \"elsewhere\": \"Meet it elsewhere\", \"commit\": \"I'll do this\"}, \"opposite\": {\"title\": \"Do the opposite\", \"sub\": \"Acting against the urge takes away its fuel.\", \"fight\": {\"lead\": \"The urge says hit back. The opposite is to step back gently, and be a little kind if you can.\", \"options\": [\"Leave the conversation for 20 minutes and say when you'll be back\", \"Put the phone face down and do something with your hands\", \"Answer something neutral and kind, then stop\"], \"note\": \"Stepping back isn't giving in. You can still raise it later, at a 5 or under.\"}, \"chase\": {\"lead\": \"The urge says reach them now. The opposite is wait. After an hour, if you still want to, send one calm message.\"}, \"hide\": {\"lead\": \"The urge says disappear. The opposite is one small step where people can see you.\", \"options\": [{\"size\": \"Small\", \"text\": \"Send one friend a hello. No explanation needed.\"}, {\"size\": \"Medium\", \"text\": \"Show up to one thing you were about to cancel.\"}, {\"size\": \"Bigger\", \"text\": \"Say one sentence in the group chat or meeting.\"}], \"hold\": \"Hold to commit\"}, \"continue\": \"Continue\", \"commit\": \"I'll do this now\", \"freeze\": {\"lead\": \"The urge says go numb and stay there. The opposite is one small step back toward people.\"}}, \"park\": {\"title\": \"Park the replay\", \"sub\": \"You aren't dropping it. You're giving it a time.\", \"why\": \"Replaying feels like solving, but it usually isn't. Give it a set time. When that time comes, you'll use it for one concrete next step, not another replay.\", \"times\": [\"6:30 pm tonight\", \"8:00 pm tonight\", \"Tomorrow, 9 am\"], \"thought\": \"\\\"why did they say that…\\\"\", \"spot\": \"parking spot\", \"cta\": \"Park it\", \"back\": \"Back to my day\"}, \"prefer\": {\"title\": \"Loosen the must\", \"sub\": \"Frustration grows from \\\"must\\\".\", \"prompt\": \"Which \\\"must\\\" is running?\", \"musts\": [{\"must\": \"They must listen to me\", \"prefer\": \"I strongly prefer that they listen\"}, {\"must\": \"I must be understood\", \"prefer\": \"I strongly prefer to be understood\"}, {\"must\": \"This must go my way\", \"prefer\": \"I strongly prefer that this goes my way\"}, {\"must\": \"It must be fair\", \"prefer\": \"I strongly prefer that things are fair\"}], \"tail\": \", and I can stand it when that doesn't happen. It's hard, and I can stand it.\", \"note\": \"Your preference is valid. Only the \\\"must\\\" goes.\", \"tapToRewrite\": \"tap to rewrite\", \"continue\": \"Continue\"}, \"close\": {\"eyebrow\": \"Close\", \"title\": \"Where are you now?\", \"sub\": \"Two numbers, then you're done.\", \"down\": \"The urge peaked and came down while you did something else with it. That's the thing to notice.\", \"same\": \"Same number, and you didn't act on it. Holding steady at a high number is still practice.\", \"up\": \"The pull went up. That happens, especially when the wound is fresh. You still didn't act on it.\", \"reps\": \"Reps count whenever they happen. Missing a day costs nothing.\", \"intensityPrompt\": \"How loud is it now?\", \"urgePrompt\": \"How strong is the pull to {pull} now?\", \"reveal\": \"See what changed\", \"pullHeading\": \"Pull to {pull}\", \"waveCaption\": \"How loud it was, start to now\", \"waveStart\": \"Start\", \"waveNow\": \"Now\", \"skillsHeading\": \"Skills you used\", \"level\": \"Lv {level} · {toNext} more to Lv {next}\", \"locked\": \"Use once to unlock\", \"mastered\": \"Mastered\", \"repsLabel\": \"{reps} of {goal} practice reps this week\", \"repsMet\": \"Weekly practice goal met\", \"weeklyGoal\": 4, \"next\": \"Next\", \"signIn\": \"Sign in to keep your skill cards between sessions.\", \"saveError\": \"This session couldn't be saved. Your results are still here.\", \"retry\": \"Try again\", \"saving\": \"Saving…\", \"changedTitle\": \"What changed\"}, \"follow\": {\"title\": \"Keep it going\", \"sub\": \"Optional. Nothing is scheduled unless you pick it.\", \"options\": [{\"id\": \"tomorrow\", \"title\": \"Check in tomorrow\", \"sub\": \"A 5-minute look at what led up to this, once it's cooled down.\"}, {\"id\": \"rehearse\", \"title\": \"Rehearse the next time\", \"sub\": \"If this person does it again: their likely line, your body cue, your move.\"}, {\"id\": \"experiment\", \"title\": \"Log how it actually went\", \"sub\": \"Predict how they'll react, then log what happened. Evidence, not a verdict.\"}], \"submit\": \"Set these and finish\", \"finish\": \"Finish\"}, \"phases\": {\"settle\": \"Settle\", \"name\": \"Name\", \"validate\": \"Validate\", \"need\": \"Need\", \"move\": \"Move\", \"close\": \"Close\"}, \"common\": {\"continue\": \"Continue\", \"next\": \"Next\", \"done\": \"Done\", \"loading\": \"Loading…\"}, \"hold\": {\"hold\": \"Tap to start, or press and hold while you do it\", \"holding\": \"Keep holding while you do it\", \"countdown\": \"Do it now · {seconds}s · tap to stop\", \"srHint\": \"Tap once to start a {seconds}-second timer, or press and hold. Tap again to stop. Space or Enter works the same way.\", \"done\": \"Done\"}, \"wait\": {\"locked\": \"Your message is saved. It unlocks when the timer ends. Put the phone down, or do something with your hands.\", \"unlocked\": \"Unlocked. Re-read it once. If it still fits, send it.\", \"unlockedShort\": \"open\", \"waiting\": \"Phone down. The urge will peak and pass while this runs.\", \"done\": \"The wait is over. If you still want to, send one calm message.\", \"copy\": \"Copy message\", \"copied\": \"Copied\"}, \"loadError\": \"This tool couldn't load. Try again, or choose another tool.\", \"ask\": {\"title\": \"Ask them to hear you\", \"sub\": \"Asking is its own skill. We'll hand what you told us to Ask for what you need.\", \"carry\": [\"The feeling: {feeling}\", \"What you needed: {need}\"], \"carryHeading\": \"Coming with you\", \"cta\": \"Continue\", \"finish\": \"Continue to Ask for what you need\"}}, \"sourceIds\": [\"linehan_skills_2015\", \"shenk_fruzzetti_2011\", \"williams_2009\", \"kross_2014\", \"balban_2023\", \"pascual_leone_2007\", \"ferrari_2019\", \"gillath_2022\", \"torre_lieberman_2018\", \"watkins_2012\", \"mcgowan_behar_2013\"]}";
MATCH (f:InvalidationRecoveryFlow {id: 'invalidation_recovery_flow'}), (s:ClinicalSource)
WHERE s.id IN ["linehan_skills_2015", "shenk_fruzzetti_2011", "williams_2009", "kross_2014", "balban_2023", "pascual_leone_2007", "ferrari_2019", "gillath_2022", "torre_lieberman_2018", "watkins_2012", "mcgowan_behar_2013"]
MERGE (f)-[:GROUNDED_IN]->(s);
MATCH (f:InvalidationRecoveryFlow {id: 'invalidation_recovery_flow'}), (p:RecoveryProtocol)
MERGE (f)-[:INCLUDES_PROTOCOL]->(p);
MATCH (f:InvalidationRecoveryFlow {id: 'invalidation_recovery_flow'}), (t:TherapyConcept {id: 'dbt_recovering_from_invalidation'})
MERGE (t)-[:IMPLEMENTED_BY_FLOW]->(f);

CREATE INDEX invalidation_recovery_session_created IF NOT EXISTS
FOR (s:InvalidationRecoverySession) ON (s.createdAt);
