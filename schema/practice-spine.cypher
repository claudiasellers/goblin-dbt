SET t.ownerModule = "mf", t.hierarchyTier = "practice", t.resolveMode = "inline", t.deepLinkTemplate = null, t.staleAfterHours = 36, t.missedPath = "none", t.notifyPush = false, t.notifyInTab = false, t.notifyIcs = false, t.enabled = false, t.reserved = true, t.reviewStatus = "draft", t.version = "spine-v1", t.contentJson = "{\"choices\": [], \"copy\": {\"body\": \"\", \"title\": \"\"}, \"notification\": \"\", \"window\": {\"kind\": \"derived\"}}";

// --- Clinical sources for the new skills ---
MERGE (s:ClinicalSource {id: "bowen_marlatt_2009"})
SET s.title = "Bowen & Marlatt (2009), Psychology of Addictive Behaviors — surfing the urge: brief mindfulness-based intervention for college student smokers", s.url = "https://doi.org/10.1037/a0017127";

// --- PracticeSkill: fields on Recover's skills (their own content stays in invalidation-recovery.cypher) ---
MERGE (k:PracticeSkill {id: "cold"})
SET k.defaultFor = ["cool-down"], k.displayLabel = "Cold reset";
MERGE (k:PracticeSkill {id: "sigh"})
SET k.defaultFor = [], k.displayLabel = "Cyclic sigh";
MERGE (k:PracticeSkill {id: "stop"})
SET k.defaultFor = ["pause"], k.displayLabel = "Pause before acting";
MERGE (k:PracticeSkill {id: "orient"})
SET k.defaultFor = ["five-senses"], k.displayLabel = "Orient";
MERGE (k:PracticeSkill {id: "opposite"})
SET k.defaultFor = ["opposite-action"], k.displayLabel = "Opposite action";
MERGE (k:PracticeSkill {id: "request"})
SET k.defaultFor = ["dear-man"], k.displayLabel = "Ask for it";
MERGE (k:PracticeSkill {id: "label"})
SET k.defaultFor = ["find-the-feeling"], k.displayLabel = "Name it";

// --- New PracticeSkills (only their own links are refreshed) ---
MATCH (k:PracticeSkill)-[r:PRACTICES|SUPPORTED_BY]->() WHERE k.id IN ["urge_surf", "problem_solve", "wise_mind", "cope_ahead"] DELETE r;
MERGE (k:PracticeSkill {id: "urge_surf"})
SET k.name = "Ride the urge", k.displayLabel = "Ride the urge", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Watching an urge rise and fall without acting on it teaches that it passes on its own.", k.defaultFor = ["urge-surfing"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "urge_surf"}), (c:TherapyConcept {id: "urge_surfing"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["bowen_marlatt_2009"] AS srcId
MATCH (k:PracticeSkill {id: "urge_surf"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "problem_solve"})
SET k.name = "Solve the problem", k.displayLabel = "Solve the problem", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "When the facts are the problem, a small concrete step changes the situation that keeps the feeling going.", k.defaultFor = ["problem-solve"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "problem_solve"}), (c:TherapyConcept {id: "dbt_problem_solving"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "problem_solve"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "wise_mind"})
SET k.name = "Wise mind", k.displayLabel = "Wise mind", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Hearing what feeling and thinking each say, then pausing to listen, leaves room for a choice that fits both.", k.defaultFor = ["wise-mind"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "wise_mind"}), (c:TherapyConcept {id: "dbt_wise_mind"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "wise_mind"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "cope_ahead"})
SET k.name = "Cope Ahead", k.displayLabel = "Cope Ahead", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Deciding what you'll do at the hardest moment, and rehearsing it once in your mind, makes the plan easier to reach when it comes.", k.defaultFor = ["cope-ahead"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "cope_ahead"}), (c:TherapyConcept {id: "dbt_cope_ahead"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "cope_ahead"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
