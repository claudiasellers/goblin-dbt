SET t.ownerModule = "core", t.hierarchyTier = "quality", t.resolveMode = "inline", t.deepLinkTemplate = null, t.staleAfterHours = 36, t.missedPath = "none", t.notifyPush = false, t.notifyInTab = false, t.notifyIcs = false, t.enabled = false, t.reserved = true, t.reviewStatus = "draft", t.version = "spine-v1", t.contentJson = "{\"choices\": [], \"copy\": {\"body\": \"\", \"title\": \"\"}, \"notification\": \"\", \"window\": {\"kind\": \"derived\"}}";
MERGE (t:FollowUpType {id: "diary_daily"})
SET t.ownerModule = "core", t.hierarchyTier = "practice", t.resolveMode = "inline", t.deepLinkTemplate = null, t.staleAfterHours = 36, t.missedPath = "none", t.notifyPush = false, t.notifyInTab = false, t.notifyIcs = false, t.enabled = false, t.reserved = true, t.reviewStatus = "draft", t.version = "spine-v1", t.contentJson = "{\"choices\": [], \"copy\": {\"body\": \"\", \"title\": \"\"}, \"notification\": \"\", \"window\": {\"kind\": \"derived\"}}";
