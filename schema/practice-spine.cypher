// --- Clinical sources for the new skills ---
MERGE (s:ClinicalSource {id: "bowen_marlatt_2009"})
SET s.title = "Bowen & Marlatt (2009), Psychology of Addictive Behaviors — surfing the urge: brief mindfulness-based intervention for college student smokers", s.url = "https://doi.org/10.1037/a0017127";

// --- PracticeSkill: fields on Recover's skills (their own content stays in invalidation-recovery.cypher) ---
MERGE (k:PracticeSkill {id: "cold"})
SET k.defaultFor = ["cool-down"], k.displayLabel = "Cold reset";
MERGE (k:PracticeSkill {id: "sigh"})
SET k.defaultFor = [], k.displayLabel = "Cyclic sigh";
MERGE (k:PracticeSkill {id: "stop"})
SET k.defaultFor = ["pause"], k.displayLabel = "Pause before acting";
MERGE (k:PracticeSkill {id: "orient"})
SET k.defaultFor = ["five-senses"], k.displayLabel = "Orient";
MERGE (k:PracticeSkill {id: "opposite"})
SET k.defaultFor = ["opposite-action"], k.displayLabel = "Opposite action";
MERGE (k:PracticeSkill {id: "request"})
SET k.defaultFor = ["dear-man"], k.displayLabel = "Ask for it";
MERGE (k:PracticeSkill {id: "label"})
SET k.defaultFor = ["find-the-feeling"], k.displayLabel = "Name it";

// --- New PracticeSkills (only their own links are refreshed) ---
MATCH (k:PracticeSkill)-[r:PRACTICES|SUPPORTED_BY]->() WHERE k.id IN ["urge_surf", "problem_solve", "wise_mind", "cope_ahead", "observe", "describe", "nonjudge", "one_thing", "effectively"] DELETE r;
MERGE (k:PracticeSkill {id: "urge_surf"})
SET k.name = "Ride the urge", k.displayLabel = "Ride the urge", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Watching an urge rise and fall without acting on it teaches that it passes on its own.", k.defaultFor = ["urge-surfing"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "urge_surf"}), (c:TherapyConcept {id: "urge_surfing"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["bowen_marlatt_2009"] AS srcId
MATCH (k:PracticeSkill {id: "urge_surf"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "problem_solve"})
SET k.name = "Solve the problem", k.displayLabel = "Solve the problem", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "When the facts are the problem, a small concrete step changes the situation that keeps the feeling going.", k.defaultFor = ["problem-solve"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "problem_solve"}), (c:TherapyConcept {id: "dbt_problem_solving"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "problem_solve"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "wise_mind"})
SET k.name = "Wise mind", k.displayLabel = "Wise mind", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Hearing what feeling and thinking each say, then pausing to listen, leaves room for a choice that fits both.", k.defaultFor = ["wise-mind"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "wise_mind"}), (c:TherapyConcept {id: "dbt_wise_mind"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "wise_mind"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "cope_ahead"})
SET k.name = "Cope Ahead", k.displayLabel = "Cope Ahead", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Deciding what you'll do at the hardest moment, and rehearsing it once in your mind, makes the plan easier to reach when it comes.", k.defaultFor = ["cope-ahead"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "cope_ahead"}), (c:TherapyConcept {id: "dbt_cope_ahead"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "cope_ahead"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "observe"})
SET k.name = "Observe", k.displayLabel = "Observe", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Giving attention one small job, and coming back each time it wanders, can make noticing easier when it matters.", k.defaultFor = ["notice-and-name"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "observe"}), (c:TherapyConcept {id: "dbt_observe"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "observe"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "describe"})
SET k.name = "Describe", k.displayLabel = "Describe", k.evidenceGrade = "Moderate", k.evidenceBasis = null, k.family = "mind", k.why = "Putting a plain word on what you noticed, a guess is fine, can help separate what happened from the story about it.", k.defaultFor = ["notice-and-name"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "describe"}), (c:TherapyConcept {id: "dbt_describe"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "describe"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "nonjudge"})
SET k.name = "Nonjudgmentally", k.displayLabel = "Nonjudgmentally", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Taking a verdict apart into what happened, what you feel and what mattered can loosen its grip without arguing with it.", k.defaultFor = ["unpack-a-judgment"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "nonjudge"}), (c:TherapyConcept {id: "dbt_nonjudgmental"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "nonjudge"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "one_thing"})
SET k.name = "One-mindfully", k.displayLabel = "One-mindfully", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Giving one ordinary thing all of your attention, and coming back each time you drift, gives a looping head something else to hold.", k.defaultFor = ["one-thing"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "one_thing"}), (c:TherapyConcept {id: "dbt_one_mindfully"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "one_thing"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);
MERGE (k:PracticeSkill {id: "effectively"})
SET k.name = "Effectively", k.displayLabel = "Effectively", k.evidenceGrade = "Preliminary", k.evidenceBasis = "Limited trials", k.family = "mind", k.why = "Naming what you want out of a situation, and one move that works from how things are, can loosen the pull of being right.", k.defaultFor = ["effectiveness"], k.reviewStatus = "draft";
MATCH (k:PracticeSkill {id: "effectively"}), (c:TherapyConcept {id: "dbt_effectively"})
MERGE (k)-[:PRACTICES]->(c);
UNWIND ["linehan_skills_2015"] AS srcId
MATCH (k:PracticeSkill {id: "effectively"}), (s:ClinicalSource {id: srcId})
MERGE (k)-[:SUPPORTED_BY]->(s);

// --- The Practice home (MF-02): the MF sequence, the library's names, the other tools that practise each skill ---
MATCH (k:PracticeSkill {id: "observe"})
SET k.mfOrder = 1, k.practiceLabel = "Notice", k.defaultFor = ["notice-and-name", "five-senses"];
MATCH (k:PracticeSkill {id: "describe"})
SET k.mfOrder = 2, k.practiceLabel = "Name", k.defaultFor = ["find-the-feeling", "notice-and-name"];
MATCH (k:PracticeSkill {id: "nonjudge"})
SET k.mfOrder = 3, k.practiceLabel = "Without judging", k.defaultFor = ["unpack-a-judgment"];
MATCH (k:PracticeSkill {id: "one_thing"})
SET k.mfOrder = 4, k.practiceLabel = "One thing", k.defaultFor = ["one-thing"];
MATCH (k:PracticeSkill {id: "wise_mind"})
SET k.mfOrder = 5, k.practiceLabel = "Wise mind", k.defaultFor = ["wise-mind"];
MATCH (k:PracticeSkill {id: "effectively"})
SET k.mfOrder = 6, k.practiceLabel = "What works", k.defaultFor = ["effectiveness"];
