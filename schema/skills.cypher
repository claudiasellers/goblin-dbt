// --- let_it_be (lb-v1) ---
MERGE (s:Skill {id: "let_it_be"})
SET s += {toolId: "let-it-be", version: "lb-v1", contentVersion: "skills-v1", start: "checked", ownMax: 120, emotionFields: [], accepts: ["band", "enterAt", "frame"]}, s.inlineJson = "{\"ends\": {\"end\": \"finished\", \"settle\": \"body\", \"still_stop\": \"stopped\", \"too_much\": \"body\"}, \"enterAt\": [\"what\"], \"flags\": [{\"id\": \"unsafe\", \"when\": {\"in\": [\"$a.still\", [\"yes\", \"sometimes\", \"unsure\"]]}}, {\"id\": \"body\", \"when\": {\"eq\": [\"$a.close\", \"worse\"]}}], \"returns\": [\"close\"], \"thenVsNowFrom\": \"close\"}", s.runtimeJson = "{\"entries\": {\"turn\": \"what\", \"willingness\": \"what\"}}", s.copyJson = "{\"back_hint\": \"Turning your mind takes about a minute.\", \"back_title\": \"The fight with it might be back. Turn your mind for a minute?\", \"back_title_still\": \"The fight with what already happened might be back. Turn your mind for a minute?\", \"card_copied\": \"Copied\", \"card_copy\": \"Copy\", \"card_next\": \"Next\", \"card_selected\": \"The line is selected, ready to copy.\", \"card_title\": \"Read it once, slowly.\", \"check_first_hint\": \"Problem Solve does that sorting. You can come back here after.\", \"check_first_ps\": \"Look at it with Problem Solve\", \"check_first_title\": \"It can help to sort what might change from what can't, first.\", \"checked_hint\": \"Letting it be is for the part that can't change right now.\", \"checked_title\": \"Some things can change and some can't. Have you looked at which this is?\", \"close_title\": \"Compared to when you started, the fight with it is…\", \"cue_hint\": \"Knowing when helps you catch it. Skipping is fine.\", \"cue_title\": \"When does the fight with it tend to come back?\", \"done\": \"Done\", \"end_body\": \"Look after your body tonight: rest, water, being gentle with yourself.\", \"end_boundary\": \"One line to hold your ground, for the next time.\", \"end_line\": \"You let it be, for now. You can come back to this whenever the fight starts again.\", \"end_louder\": \"The fight's loud right now. That happens with hard things. You can come back to this anytime.\", \"end_need\": \"Your need is still real. It can be met somewhere else.\", \"end_nothing\": \"Doing nothing more today is okay. Letting it be was enough.\", \"end_small\": \"Pick one small thing that matters to you, and do it today.\", \"fight_hint\": \"Pick up to four.\", \"fight_title\": \"How does the fight with it show up?\", \"grief_hint\": \"Letting it be can make room for the sad part.\", \"grief_title\": \"If sadness comes, it's allowed. It isn't going backwards.\", \"hands_caution\": \"If it feels right, let your face soften too. You don't have to smile.\", \"hands_done\": \"That's it. Your hands did it.\", \"hands_running\": \"Hands open\", \"hands_start\": \"Start\", \"hands_step1\": \"Sit or stand, arms loose by your sides or in your lap.\", \"hands_step2\": \"Turn your palms up, or rest them however feels safe. Let your fingers relax.\", \"hands_step3\": \"Breathe however you breathe. Let your hands stay open.\", \"hands_still_hint\": \"One thing is plenty. None is okay too.\", \"hands_still_title\": \"What's still in your hands?\", \"hands_title\": \"Willing hands. Let your body practise letting it be.\", \"heads_up_hint\": \"You can settle your body first, or try it now.\", \"heads_up_title\": \"This works better once your body's quieter.\", \"heart_done\": \"That's it.\", \"heart_running\": \"Hand on heart\", \"heart_start\": \"Start\", \"heart_step1\": \"Rest one hand on your chest, over your heart.\", \"heart_step2\": \"Feel the warmth of your hand.\", \"heart_step3\": \"Stay as long as feels okay.\", \"heart_title\": \"Hand on your heart.\", \"inline_back\": \"Leave this for now\", \"later_line\": \"Another time, then.\", \"later_line_set\": \"Another time, then. The reminder is set.\", \"next\": \"Next\", \"remind_again_title\": \"Want another reminder?\", \"remind_hint\": \"It takes about a minute. The reminder never says what it's about.\", \"remind_title\": \"Want a reminder to turn your mind, around then?\", \"rest_line\": \"Then let it rest. Let it be is here whenever the fight comes back.\", \"safety_open\": \"Talk to someone now\", \"settle_first\": \"Settle my body first\", \"settle_line\": \"Body first. Let it be is here when you're ready.\", \"statement_hint\": \"Accepting isn't approving. It isn't giving up on what can change. One line is enough.\", \"statement_own\": \"In my words\", \"statement_title\": \"Pick the words that fit, or write your own.\", \"still_again_hint\": \"Things can change. Your safety comes before any of this.\", \"still_again_line\": \"Then turning your mind isn't the job right now. Your safety is. Someone can help you with that.\", \"still_again_title\": \"Before you turn it: is anyone still hurting you, or could this happen to you again?\", \"still_ending\": \"Ending a relationship that's hurting you\", \"still_hint\": \"Letting it be is never about staying somewhere you're being hurt.\", \"still_line_hint\": \"If you're not safe, the support is on this screen. If it's someone close to you, Ending a relationship that's hurting you can help you think it through.\", \"still_line_title\": \"Accepting that it happened isn't accepting you have to stay in it.\", \"still_stop_line\": \"Stopping here is okay. The support stays here for you.\", \"still_title\": \"Is anyone still hurting you, or could this happen to you again?\", \"threat_alone\": \"Of course that's scary. You can let this be and still reach for people.\", \"threat_hint\": \"Pick the closest.\", \"threat_line_hint\": \"Accepting isn't approving. It isn't giving up on what can change.\", \"threat_lose_myself\": \"That makes sense. Letting it be doesn't take away what you care about. That stays yours.\", \"threat_my_fault\": \"That fear makes sense. Accepting that it happened isn't taking the blame. Causes aren't the same as fault.\", \"threat_never_change\": \"That fear makes sense. Accepting what's true now leaves room for what can still change.\", \"threat_other\": \"That fear makes sense. Letting it be is something you do, and you can do it a little at a time.\", \"threat_they_win\": \"That makes sense. Letting it be isn't saying they were right. It's choosing where your energy goes.\", \"threat_title\": \"What feels like it would happen if you let this be?\", \"too_much_line\": \"That's a lot. Let's look after your body first.\", \"turn_again\": \"Turn it again\", \"turn_card_title\": \"Your words, once more.\", \"turn_done\": \"That's enough turns for now\", \"turn_end_line\": \"You turned your mind. When it drifts back, you can turn it again.\", \"turn_end_skipped\": \"Some days it won't turn. That's okay. It's here when you want it.\", \"turn_fight\": \"The fight\", \"turn_hands_title\": \"Willing hands, for a few breaths.\", \"turn_hint\": \"Each turn leaves a footprint. The mind turns back, and you turn it again.\", \"turn_let\": \"Letting it be\", \"turn_skip\": \"Go on without turning\", \"turn_sr\": \"Tap to turn the figure toward the path of letting it be. Each turn leaves a footprint.\", \"turn_title\": \"Turn your mind toward letting it be.\", \"turn_title_still\": \"Turn your mind toward letting what already happened be.\", \"turn_turn\": \"Turn toward letting it be\", \"turn_turned\": \"Turned. If it drifts back, turn it again.\", \"what_hint\": \"Pick the closest, or say it your way.\", \"what_own\": \"Say it my way\", \"what_title\": \"It makes sense you're fighting this. It matters to you. What is it you can't change?\", \"what_title_willing\": \"It makes sense to dig in when something matters. What are you pushing against?\", \"willing_hint\": \"Digging in makes sense. It's how we protect what matters.\", \"willing_title\": \"Right now, are you willing to let it be, or digging in against it?\"}", s.tablesJson = "{\"cueChip\": {\"night\": \"tonight\"}}", s.deriveJson = "[{\"from\": \"$a.cue\", \"name\": \"cueChip\", \"table\": \"cueChip\"}]";
