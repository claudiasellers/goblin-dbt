MERGE (s:Skill {id: "kind_wishes"})
SET s += {toolId: "kind-wishes", version: "kw-v1", contentVersion: "skills-v1", start: "who", ownMax: 40, emotionFields: [], accepts: ["band"]}, s.inlineJson = "null", s.runtimeJson = "{}", s.copyJson = "{\"backdraft_deserve\": \"You don't have to deserve it. Offering is the practice, not believing it.\", \"backdraft_line\": \"It's called backdraft, and it isn't failure.\", \"backdraft_title\": \"That's common. Warmth can wake old hurts.\", \"body_first\": \"My body first\", \"came_hint\": \"Any of these is fine.\", \"came_title\": \"What came up?\", \"check_hint\": \"Someone annoying or hard to be around is fine to pick. Kind wishes are never owed to someone who hurts or scares you.\", \"check_title\": \"Has this person ever threatened you, scared you or hurt you, or could they?\", \"done\": \"Done\", \"end_easy\": \"Next time, someone easy is a good place to begin.\", \"end_line\": \"Next time, try your own words, or someone a little less easy.\", \"end_own\": \"Next time, try them in your own words.\", \"end_stopped\": \"You stopped when it got heavy. That's looking after yourself.\", \"end_title\": \"You offered kind wishes. That's the practice.\", \"ending_careful\": \"Leaving someone who might hurt me\", \"hand_done\": \"That's enough for now.\", \"hand_offer\": \"A hand on my heart\", \"hand_running\": \"Resting here\", \"hand_start\": \"Start\", \"hand_step1\": \"One hand on your chest, or both hands around a warm mug.\", \"hand_step2\": \"Notice any warmth in your hand.\", \"hand_step3\": \"Let your breath move under it, slowly.\", \"hand_title\": \"A hand on your heart for a few breaths.\", \"heads_up_line\": \"Your body's loud right now. Settle it first, or offer them to someone easy.\", \"heads_up_title\": \"Kind wishes work best on a calmer day.\", \"line_all\": \"May everyone around me {wish}.\", \"line_me\": \"May I {wish}.\", \"line_you\": \"May you {wish}.\", \"next\": \"Next\", \"not_them_line\": \"Send the wishes somewhere else today, or stop here. Support is here if you want it.\", \"not_them_title\": \"Then not this one. Your safety comes first.\", \"offer_again_title\": \"Picture someone easy, and offer them the same wishes.\", \"offer_done\": \"All offered.\", \"offer_easy_title\": \"Picture someone easy, and offer them one at a time.\", \"offer_fallback\": \"Be at ease\", \"offer_hint\": \"The wishes don't need to feel true. Offering them is the practice.\", \"offer_ring_hint\": \"Tap to offer this wish. The ring fills slowly. Tap again to stop.\", \"offer_self_title\": \"Offer them to yourself, one at a time.\", \"offer_skip\": \"Move on\", \"offer_start\": \"Offer it\", \"offer_title\": \"Offer them one at a time.\", \"safety_open\": \"Talk to someone now\", \"skip_line\": \"The wishes will keep for another day.\", \"skip_title\": \"Not this time.\", \"stop_safe_line\": \"Support is here if you want it.\", \"stop_safe_title\": \"Stopping here is a real answer.\", \"twice_line\": \"That happens. It's worth talking through with someone you trust. Next time, a hand on your heart first, then someone easy.\", \"twice_title\": \"Warmth keeps stirring things up today.\", \"who_hint\": \"Someone easy is a good place to start.\", \"who_stirred\": \"With things stirred up, wishes for yourself or someone difficult can wait for a steadier day.\", \"who_title\": \"Who will you send kind wishes to?\", \"wish_own\": \"My own wish\", \"wishes_all\": \"Pick up to three wishes for everyone around you.\", \"wishes_all_line\": \"Leave out anyone who hurts or scares you. Kind wishes are never owed to them.\", \"wishes_easy\": \"Pick up to three wishes for someone easy.\", \"wishes_hint\": \"Pick the ones that sound kind. They don't need to feel true.\", \"wishes_other\": \"Pick up to three wishes for them.\", \"wishes_own_me\": \"Your own words finish the line \\\"May I…\\\"\", \"wishes_own_you\": \"Your own words finish the line \\\"May you…\\\"\", \"wishes_self\": \"Pick up to three wishes for yourself.\"}", s.tablesJson = "{}", s.deriveJson = "[]";
