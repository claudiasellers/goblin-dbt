// --- held (held-v1) ---
MERGE (s:Skill {id: "held"})
SET s += {toolId: "soothe", version: "held-v1", contentVersion: "skills-v1", start: "pick", ownMax: 72, emotionFields: [], accepts: ["band", "frame", "enterAt"]}, s.inlineJson = "null", s.runtimeJson = "{\"entries\": {\"hand\": \"where\", \"scan\": \"scan\"}}", s.copyJson = "{\"again_title\": \"And now?\", \"chest_step1\": \"One hand on your chest, over your heart.\", \"chest_step2\": \"Notice any warmth from your hand.\", \"chest_step3\": \"Let your breath move under it, slowly.\", \"close_title\": \"How is it now?\", \"deserve_card_title\": \"Thirty seconds.\", \"deserve_hint\": \"Try thirty seconds, as an experiment.\", \"deserve_step1\": \"A hand on your chest, or something warm.\", \"deserve_step2\": \"Nothing to feel or get right.\", \"deserve_step3\": \"Notice being looked after, for a moment.\", \"deserve_title\": \"You don't have to deserve it.\", \"done\": \"Done\", \"end_easier\": \"It eased. You stayed with it, gently.\", \"end_reach\": \"Even a short message counts. You could tell them it's been a hard day.\", \"end_same\": \"Sometimes it doesn't shift much. You still gave yourself a minute of care.\", \"end_warmer\": \"You looked after yourself for a minute. You can do that again, with or without the app.\", \"hold_done\": \"That's a minute.\", \"hold_title\": \"Stay here for a minute.\", \"land_step1\": \"A hand on your chest, or something warm.\", \"land_step2\": \"Say the words to yourself once more, slowly.\", \"land_step3\": \"Let them stay a while.\", \"land_title\": \"Let it land.\", \"light_done\": \"That's it.\", \"light_running\": \"Breathing\", \"light_step1\": \"Let your hands rest wherever they like.\", \"light_step2\": \"Breathe out longer than you breathe in.\", \"light_step3\": \"Stop whenever you like.\", \"light_title\": \"Only your breath.\", \"lighter_line\": \"Kindness can be hard to take in right now. That's common, and it can change.\", \"mug_step1\": \"Wrap both hands around the mug.\", \"mug_step2\": \"Notice the warmth in your palms.\", \"mug_step3\": \"Let your shoulders drop a little.\", \"next\": \"Next\", \"not_today_line\": \"That's okay. It's here for another time.\", \"notice_offer\": \"A minute noticing what's around you\", \"pick_hint\": \"Pick one. You can stop whenever you like.\", \"pick_title\": \"This deserves some care. How would you like to be looked after for a minute?\", \"practise_hint\": \"It comes more easily on a hard night if you've done it on an okay day.\", \"practise_title\": \"Want to practise this once when things are calmer?\", \"press_line\": \"First, the body has ways to press, cool down or move.\", \"reach_hint\": \"Only if you'd like to.\", \"reach_title\": \"Is there someone you could call or text?\", \"running\": \"Holding\", \"safety_open\": \"Talk to someone now\", \"scan_contact_step1\": \"Notice where your body meets it.\", \"scan_contact_step2\": \"Pressure, temperature, texture: whatever's there.\", \"scan_contact_step3\": \"Nothing to change.\", \"scan_contact_title\": \"Notice where you touch it.\", \"scan_done\": \"That's it.\", \"scan_far_line\": \"Far away is a sign to come back to the outside, not to go further in. Look around and name what you see.\", \"scan_hint\": \"Eyes open is fine. Pick one.\", \"scan_in_step1\": \"Your hands: warm, cool, tingling, or nothing much.\", \"scan_in_step2\": \"Your breath at the tip of your nose.\", \"scan_in_step3\": \"Back to the outside whenever you like.\", \"scan_in_title\": \"A little further in, if that's okay.\", \"scan_press_step1\": \"Press down through your heels.\", \"scan_press_step2\": \"Notice the floor pushing back.\", \"scan_press_step3\": \"Look at one thing in the room.\", \"scan_press_title\": \"Press your feet into the floor.\", \"scan_referral\": \"If you often feel far away, tell a doctor or therapist. It's common, and it can be helped.\", \"scan_running\": \"Noticing\", \"scan_skin_step1\": \"Your clothes against your skin.\", \"scan_skin_step2\": \"The air on your face and hands.\", \"scan_skin_step3\": \"Keep your eyes open if you like.\", \"scan_skin_title\": \"Now the outside of your body.\", \"scan_title\": \"Start with the outside. Where are you touching something solid?\", \"scan_title_flooded\": \"Your body's loud right now. A hand on your heart may be easier first.\", \"scan_where_hint\": \"Any answer is useful.\", \"scan_where_title\": \"Right now, how here are you?\", \"sense_card_title\": \"Give it a minute of your attention.\", \"sense_hint\": \"Whatever's close to hand.\", \"sense_own\": \"Something else that's kind to me\", \"sense_running\": \"With it\", \"sense_step1\": \"Give it all your attention.\", \"sense_step2\": \"Notice one small new thing about it.\", \"sense_step3\": \"When your mind wanders, come back to it.\", \"sense_title\": \"Pick one thing.\", \"soft_step1\": \"Hold it close, wherever feels right.\", \"soft_step2\": \"Notice how soft it is under your fingers.\", \"soft_step3\": \"Let it take some of the weight.\", \"start\": \"Start\", \"stirred_hint\": \"Any of these is fine.\", \"stirred_title\": \"That happens. Kindness can stir things up.\", \"stop_line\": \"You stopped when it got to be too much. That's looking after yourself too.\", \"talk_line\": \"Talking it through with someone can help: a friend, or someone who's trained to listen.\", \"thighs_step1\": \"Rest both hands flat on your thighs.\", \"thighs_step2\": \"Notice the weight of your hands.\", \"thighs_step3\": \"Let your breath slow down under them.\", \"warm_card_title\": \"Let the warmth in for a minute.\", \"warm_hint\": \"Warm, not hot.\", \"warm_running\": \"Warming\", \"warm_step1\": \"Bring it close, wherever it feels good.\", \"warm_step2\": \"Notice where the warmth reaches.\", \"warm_step3\": \"Let more warmth in on each breath out.\", \"warm_title\": \"What's warm nearby?\", \"way_hint\": \"Some days settling helps. Some days waking up a bit helps.\", \"way_title\": \"What would help more right now?\", \"where_hint\": \"If touch doesn't feel right, hold something instead.\", \"where_title\": \"Where would your hands like to rest?\", \"words_card_next\": \"Next\", \"words_card_title\": \"Read it slowly, as if it's meant for you.\", \"words_copied\": \"Copied\", \"words_copy\": \"Copy\", \"words_hint\": \"Pick one, or say it the way someone who cares about you would.\", \"words_own\": \"In my own words\", \"words_selected\": \"The words are selected, ready to copy.\", \"words_title\": \"What would you like to hear?\"}", s.tablesJson = "{}", s.deriveJson = "[]";
