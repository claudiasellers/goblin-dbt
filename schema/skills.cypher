MERGE (s:Skill {id: "say_no"})
SET s += {toolId: "say-no", version: "say-no-v1", contentVersion: "skills-v1", start: "ask", ownMax: 140, emotionFields: [], accepts: ["personId", "frame", "band"]}, s.inlineJson = "null", s.runtimeJson = "{}", s.copyJson = "{\"again_label\": \"Want me to ask how it went?\", \"alt_label\": \"Something else you could offer (optional)\", \"ask_hint\": \"You're allowed to say no. You don't owe anyone a script.\", \"ask_own\": \"Something else\", \"ask_title\": \"What are they asking for?\", \"compose_title\": \"Put your no together.\", \"compose_title_flooded\": \"Your body's running hot. Your no can still go, short and plain.\", \"compose_title_heads_up\": \"Keep it short, written, and about one thing.\", \"compose_title_self\": \"Put your no together. One reason at most, and no extra sorry.\", \"compose_title_warm\": \"Put your no together. A warm line first can help it land.\", \"cool_down\": \"Settle my body first\", \"copied\": \"Copied\", \"copy\": \"Copy\", \"done\": \"Done\", \"drop_sorry\": \"Take the sorry out\", \"enough_card_title\": \"Your line\", \"enough_hint\": \"You don't have to explain, or be nice about it. Pick the line you'd use.\", \"enough_line\": \"Your safety comes first. Somewhere safe, then your line. The people below can help, any time.\", \"enough_title\": \"No is enough.\", \"explain_line\": \"One reason is enough. A long one can sound like it's up for debate.\", \"f_cost_q\": \"Would saying yes cost you something you can't spare, like time, money or energy?\", \"f_fair_q\": \"Is it more than they have a right to ask of you?\", \"f_given_q\": \"Have you already given a lot in this relationship lately?\", \"f_later_q\": \"Would a yes now make things harder later, for you or for them?\", \"f_values_q\": \"Would saying yes go against what matters to you?\", \"firm_hint\": \"Yes, no or not sure. There's no right answer.\", \"firm_title\": \"A few questions to size it.\", \"gave_in_guilt\": \"If guilt is what pulled you back, checking the facts can help. Guilt about a fair no often doesn't fit.\", \"gave_in_line\": \"That happens. Your line is still here if you want it again.\", \"held_line\": \"You said no, and it held.\", \"held_line_proud\": \"You said no, and it held. That's the skill working.\", \"held_title\": \"Did it hold when they pushed?\", \"how_label\": \"How will you say it?\", \"level_firm\": \"Say no firmly, and hold it if they push.\", \"level_firm_hold\": \"Say no firmly, and don't reconsider.\", \"level_gentle\": \"Say no gently, or say not yet.\", \"level_hint\": \"From what you said.\", \"level_offer\": \"Say no, and offer something else if you want to.\", \"level_yes_part\": \"The facts lean toward yes, or yes to part of it. It's still your call.\", \"message_title\": \"Here's your no.\", \"next\": \"Next\", \"no_label\": \"Your no\", \"no_push_line\": \"You said no, and they took it. Not every no gets pushed on.\", \"not_said_line\": \"Not this time. Your line is still here when you want it.\", \"nudge_label\": \"Does that sit right?\", \"open_messages\": \"Open messages\", \"opener_label\": \"A warm line first (optional)\", \"own_line\": \"In my own words\", \"partly_line\": \"A maybe buys time. When you're ready, your no is still here.\", \"picker_personChanged\": \"Things changed with someone?\", \"picker_personChangedHint\": \"Pick who it is, and you'll be asked about them again.\", \"picker_personGoOn\": \"Go on\", \"picker_personKeepLine\": \"The app will remember {who} for next time: the name you gave, who they are to you, and your answer about safety. Nothing else.\", \"picker_personNameHint\": \"A nickname is fine. No real names needed.\", \"picker_personNameLabel\": \"What do you call them?\", \"picker_personNew\": \"Someone new\", \"picker_personNoNameLine\": \"Without a name, nothing about them is kept.\", \"picker_personRoleLabel\": \"Who are they to you?\", \"picker_personSignedOutLine\": \"This stays on this screen only.\", \"picker_personWhoSayNo\": \"Who's asking?\", \"picker_riskBadly\": \"It tends to go badly\", \"picker_riskHarm\": \"They might hurt or control me\", \"picker_riskQuestion\": \"Is it more that they might hurt or control you, or that it tends to go badly?\", \"picker_riskUnsaid\": \"I'd rather not say\", \"picker_safeNo\": \"No\", \"picker_safeQuestion\": \"Is it safe to bring hard things up with {who}?\", \"picker_safeUnsure\": \"Not sure\", \"picker_safeYes\": \"Yes, mostly\", \"picker_safetyRouteBack\": \"This is about someone else\", \"picker_safetyRouteBody\": \"The people below can help you think it through, any time, and you don't have to be sure.\", \"picker_safetyRouteEnding\": \"Thinking about ending the relationship\", \"picker_safetyRouteSayNoHeading\": \"With {who}, your safety comes first. Working out how to say no can wait.\", \"predict_title\": \"How do you think they'll take it?\", \"pressure_hint\": \"Pick any that fit.\", \"pressure_title\": \"What do you think happens if you say no?\", \"proud_hint\": \"However it went.\", \"proud_title\": \"Are you proud of how you handled it?\", \"reason_hint\": \"You don't have to justify it. One reason at most.\", \"reason_label\": \"One reason (optional)\", \"repeat_label\": \"If they push, say it again:\", \"said_title\": \"Did you say no?\", \"selected\": \"Selected. Copy it from here.\", \"sent_line\": \"Your no is ready. When you say it is up to you.\", \"sent_line_in_person\": \"Saying it out loud a couple of times first can help it come out steady.\", \"sent_line_push\": \"If they push, say the same line again. You don't need a new reason.\", \"sorry_line\": \"There's a sorry in there. You don't owe one for saying no.\", \"sure_label\": \"How sure are you?\", \"talk_now\": \"Talk to someone now\", \"why_hint\": \"Pick the one that matters most.\", \"why_title\": \"What matters most to you here?\"}", s.tablesJson = "{\"level\": {\"-1\": \"yes_part\", \"1.5\": \"gentle\", \"2.5\": \"offer\", \"3.5\": \"firm\", \"4.5\": \"firm_hold\"}}", s.deriveJson = "[{\"fields\": [\"f_cost\", \"f_values\", \"f_fair\", \"f_given\", \"f_later\"], \"kind\": \"count\", \"name\": \"level\", \"table\": \"level\", \"weights\": {\"firmer\": 1, \"no\": 0, \"not_sure\": 0.5, \"right\": 0, \"softer\": -1, \"yes\": 1}}, {\"fields\": [\"f_cost\", \"f_values\", \"f_fair\", \"f_given\", \"f_later\", \"nudge\"], \"kind\": \"count\", \"name\": \"final\", \"table\": \"level\", \"weights\": {\"firmer\": 1, \"no\": 0, \"not_sure\": 0.5, \"right\": 0, \"softer\": -1, \"yes\": 1}}]";
