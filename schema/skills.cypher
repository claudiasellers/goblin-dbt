// --- dear_man_prep (dm-prep-v1) ---
MERGE (s:Skill {id: "dear_man_prep"})
SET s += {toolId: "dear-man", version: "dm-prep-v1", contentVersion: "skills-v1", start: "situation", ownMax: 140, emotionFields: ["express"], accepts: ["personId", "frame", "band", "refused", "situationId", "feelingId"]}, s.inlineJson = "null", s.runtimeJson = "{}", s.copyJson = "{\"again_title\": \"Your plan, once more.\", \"ask_level_firm\": \"Ask firmly, and keep asking if they push back.\", \"ask_level_firm_heads_up\": \"Ask firmly once, and say it again calmly if you need to. With them, you don't have to keep pushing.\", \"ask_level_firm_hold\": \"Ask firmly, and keep coming back to it.\", \"ask_level_gentle\": \"Ask gently. If they say no, that can be okay for now.\", \"ask_level_hint\": \"From what you said, a light first mention may fit, or waiting. Asking is still okay, and it's your call.\", \"ask_level_plain\": \"Ask plainly, and listen to what they say.\", \"ask_middle_firm\": \"You meant to ask firmly. A middle ground can still be part of that.\", \"ask_middle_firm_heads_up\": \"With them, one clear ask is enough. A middle ground can help it land.\", \"ask_middle_firm_hold\": \"You meant to keep coming back to it. Is there any middle ground at all?\", \"ask_middle_gentle\": \"You meant to ask gently. Meeting in the middle fits that.\", \"ask_middle_hint\": \"You leaned toward a light first mention. A small step counts.\", \"ask_middle_plain\": \"You meant to ask plainly. A middle ground keeps it workable.\", \"assert_hint\": \"A clear ask is easier to say yes to.\", \"assert_title\": \"What are you asking for?\", \"assert_title_heads_up\": \"What's the one practical thing you're asking for?\", \"card_attack\": \"If they attack: you don't have to answer it. Come back to the ask.\", \"card_drift\": \"If it drifts: say the ask again, same words.\", \"card_felt\": \"I felt\", \"card_level\": \"How firmly\", \"card_level_firm\": \"Firmly, and keep asking\", \"card_level_firm_heads_up\": \"Firmly, once. Calmly again if needed\", \"card_level_firm_hold\": \"Firmly, and keep coming back to it\", \"card_level_gentle\": \"Gently. A no can be okay for now\", \"card_level_hint\": \"A light first mention is enough\", \"card_level_plain\": \"Plainly, and listen\", \"card_middle\": \"Middle ground I could live with\", \"card_next_card\": \"Next card\", \"card_prev\": \"Previous card\", \"card_push\": \"If they push back\", \"card_say\": \"Say it\", \"card_skip\": \"Done with the cards\", \"card_steady\": \"Stay steady\", \"card_title\": \"Your plan, on three cards.\", \"card_walk\": \"I won't accept\", \"coach_barrier_angry\": \"If they get defensive: that's their feeling, not proof you're wrong. You can name it and come back to what you need.\", \"coach_barrier_dont_know\": \"If you blank: you've built your plan, and it's fine to glance at it. You can say you wrote it down because it matters.\", \"coach_barrier_emotional\": \"If tears or a shaky voice come, take a breath. You can say this is hard to say and you want to get through it.\", \"coach_barrier_guilty\": \"If guilt shows up, it may tell you to back down or apologise for having needs. Notice it, and stay with your ask.\", \"coach_barrier_no_right\": \"If you start doubting yourself: you don't have to earn the right to need things. Asking clearly is respectful.\", \"coach_barrier_tried_before\": \"If your mind pulls you to the last five times, come back to this conversation, this ask, now.\", \"coach_default\": \"The hard part is staying with it when it gets uncomfortable. When your mind races or shuts down, come back to one line.\", \"coach_myth_alone\": \"Needing someone for this doesn't make you less.\", \"coach_myth_deserve\": \"Feeling undeserving makes sense. You can feel it and still ask, if you choose to.\", \"coach_myth_know\": \"Wanting them to know without asking is so human. People can care and still not guess.\", \"coach_myth_last\": \"Your needs can sit next to theirs. Asking is how they get a place.\", \"coach_myth_matter\": \"A no can be about this ask, on this day. It doesn't decide what you're worth.\", \"coach_myth_sure\": \"Nobody gets to know the answer first. You can ask and find out.\", \"coach_myth_weak\": \"Needing things is human. Saying it plainly takes steadiness.\", \"confident_hint\": \"Even when you don't feel confident.\", \"confident_title\": \"Your body can help. One thing to do before you start?\", \"cool_down\": \"Settle my body first\", \"copied\": \"Copied\", \"copy\": \"Copy\", \"debrief_link\": \"I've already had the conversation\", \"describe_hint\": \"Facts are harder to argue with than judgements.\", \"describe_title\": \"What happened? Say it the way a camera would see it.\", \"edge_dizzy\": \"Feeling dizzy? Stop and breathe normally.\", \"edge_done\": \"That's the edge off. Read your plan once more, out loud if you can.\", \"edge_in\": \"In\", \"edge_next\": \"Back to my plan\", \"edge_out\": \"Out, longer\", \"edge_start\": \"Start\", \"edge_step1\": \"Unclench your jaw and drop your shoulders while you read it through.\", \"express_hint\": \"Naming it helps them see this matters.\", \"express_title\": \"How does it feel?\", \"fill_ask_change_how\": \"What would you like to be different?\", \"fill_ask_flexibility\": \"What would that look like in practice?\", \"fill_ask_specific_help\": \"What kind of help, and by when?\", \"fill_bound_cant_do\": \"What aren't you able to do?\", \"fill_bound_need_space\": \"When do you need the space?\", \"fill_bound_respect_no\": \"Which decision?\", \"fill_bound_stop_behavior\": \"What do you need them to stop?\", \"fill_patt_more_effort\": \"What would more effort look like, plainly?\", \"fill_title\": \"Say it plainly.\", \"hard_hint\": \"Pick any that fit.\", \"hard_title\": \"What makes this hard?\", \"hot_hint\": \"When it's loud inside, even a good plan can come out sharper than you mean. Taking the edge off first can help it land.\", \"hot_title\": \"Your plan is ready. Heads up: it's still loud in there.\", \"let_go\": \"I've asked them to hear me before. Look at letting this one go\", \"level_hint\": \"From what you said.\", \"matters_hint\": \"If it gets tough, this is what you'll protect.\", \"matters_title\": \"What matters most to you here?\", \"middle_title\": \"If they push back, what middle ground could you live with?\", \"middle_title_objective\": \"Getting what you need comes first, so know the part you won't give on. If they push back, what middle ground could you live with?\", \"middle_title_relationship\": \"Keeping things good comes first, so you can give on details, as long as you feel heard. What middle ground could you live with?\", \"middle_title_self_respect\": \"Your self-respect comes first, so notice any pressure to agree to what doesn't sit right. What middle ground could you live with?\", \"mindful_title\": \"What do you need to hear in that moment?\", \"mirror_addr_broke_promise\": \"When someone doesn't follow through, disappointment often comes first, then frustration, sometimes hurt. Only keep what fits.\", \"mirror_addr_dismissed\": \"Opening up and being brushed aside often leaves people feeling unheard, hurt, then angry. Only keep what fits.\", \"mirror_addr_hurtful\": \"When a hurt goes unnoticed, the hurt is right there, often with feeling invisible, sometimes anger. Only keep what fits.\", \"mirror_addr_no_consult\": \"A decision made without you often leaves people feeling disrespected, invisible, a bit helpless. Only keep what fits.\", \"mirror_ask_need_help\": \"Needing help you haven't asked for often brings overwhelm, a worry about being a burden, and sometimes quiet resentment. Only keep what fits.\", \"mirror_ask_not_working\": \"When how you do things isn't working, people often feel frustrated, unheard, a bit trapped. Only keep what fits.\", \"mirror_ask_support\": \"Needing support through something hard often comes with loneliness, sadness, and a fear of pushing them away. Only keep what fits.\", \"mirror_ask_time_space\": \"Needing time or space you don't have tends to leave people worn out, often with some guilt about wanting it. Only keep what fits.\", \"mirror_bound_new_thing\": \"When something new isn't okay with you, hurt or feeling disrespected is common, and nerves about what to say. Only keep what fits.\", \"mirror_bound_overcommit\": \"Taking back a yes often brings guilt, worry about letting them down, and tiredness from carrying it. Only keep what fits.\", \"mirror_bound_pressure\": \"Being pressed to do something you don't want to do can feel like being cornered: frustrated, anxious, resentful. Only keep what fits.\", \"mirror_bound_unnamed_line\": \"When a line you haven't named keeps getting crossed, resentment tends to build quietly, along with feeling disrespected. Only keep what fits.\", \"mirror_patt_avoids\": \"When the conversation keeps getting avoided, people often feel unheard, invisible, lonely in it. Only keep what fits.\", \"mirror_patt_keeps_doing\": \"When it keeps happening after you've asked, frustration and resentment are very common. Only keep what fits.\", \"mirror_patt_one_sided\": \"When effort feels one-sided, resentment and tiredness tend to build, and sadness underneath. Only keep what fits.\", \"mirror_patt_shuts_down\": \"When it ends badly every time, people often feel helpless and worn out before they start. Only keep what fits.\", \"mirror_sit_address\": \"Bringing something up often has some hurt underneath, some frustration, and nerves about reopening it. Only keep what fits.\", \"mirror_sit_ask\": \"Asking for something often brings worry about how it'll land, and sometimes guilt for needing it. Only keep what fits.\", \"mirror_sit_boundary\": \"Setting a limit often comes with guilt and worry about their reaction, on top of what made it necessary. Only keep what fits.\", \"mirror_sit_pattern\": \"A pattern that keeps repeating often leaves people worn out, unheard, with resentment built up. Only keep what fits.\", \"next\": \"Next\", \"notice_them_offer\": \"Notice them next time, with curiosity\", \"nudge_label\": \"Does that sit right?\", \"own_line\": \"In my own words\", \"phrase_hint\": \"Short enough to fit in one breath.\", \"phrase_title\": \"Pick the line you'll say to yourself, or make it yours.\", \"picker_personChanged\": \"Things changed with someone?\", \"picker_personChangedHint\": \"Pick who it is, and you'll be asked about them again.\", \"picker_personGoOn\": \"Go on\", \"picker_personKeepLine\": \"The app will remember {who} for next time: the name you gave, who they are to you, and your answer about safety. Nothing else.\", \"picker_personNameHint\": \"A nickname is fine. No real names needed.\", \"picker_personNameLabel\": \"What do you call them?\", \"picker_personNew\": \"Someone new\", \"picker_personNoNameLine\": \"Without a name, nothing about them is kept.\", \"picker_personRoleLabel\": \"Who are they to you?\", \"picker_personSignedOutLine\": \"This stays on this screen only.\", \"picker_personWho\": \"Who is this conversation with?\", \"picker_riskBadly\": \"It tends to go badly\", \"picker_riskHarm\": \"They might hurt or control me\", \"picker_riskQuestion\": \"Is it more that they might hurt or control you, or that it tends to go badly?\", \"picker_riskUnsaid\": \"I'd rather not say\", \"picker_safeNo\": \"No\", \"picker_safeQuestion\": \"Is it safe to bring hard things up with {who}?\", \"picker_safeUnsure\": \"Not sure\", \"picker_safeYes\": \"Yes, mostly\", \"picker_safetyRouteBack\": \"This is about someone else\", \"picker_safetyRouteBody\": \"The people below can help you think it through, any time, and you don't have to be sure.\", \"picker_safetyRouteEnding\": \"Thinking about ending the relationship\", \"picker_safetyRouteHeading\": \"Planning a hard talk with {who} can wait. Your safety comes first.\", \"rehearse_offer\": \"Practise it out loud\", \"reinforce_hint\": \"This is the step most people skip. It helps them listen.\", \"reinforce_title\": \"What would be better for them, or for you both, if they said yes?\", \"s_able_q\": \"Can they actually give you this?\", \"s_matters_q\": \"Does it matter a lot to you right now?\", \"s_ready_q\": \"Do you know what you want, and have the facts straight?\", \"s_right_q\": \"Is it reasonable to ask this of them?\", \"s_timing_q\": \"Is this a good time to ask?\", \"scared_line\": \"Your safety comes first. You don't have to plan this conversation. The people below can help, any time.\", \"selected\": \"Selected. Copy it from here.\", \"situation_title\": \"What kind of conversation is this?\", \"situation_title_heads_up\": \"When talks with them tend to go badly, it can help to keep it short, about one thing, and in writing if that suits. What kind of conversation is this?\", \"size_hint\": \"Yes, no or not sure. There's no right answer.\", \"size_title\": \"How firmly to ask? A few questions to size it.\", \"thought_hint\": \"Pick up to two, or none.\", \"thought_title\": \"Do any of these thoughts show up too?\", \"walk_hint\": \"Knowing this ahead makes it easier to stop or step away.\", \"walk_title\": \"What won't you accept?\", \"when_label\": \"When is the conversation? I can ask how it went, after.\", \"when_line\": \"You've planned what to say, what matters most, and what you'll do if it gets hard.\", \"when_line_badly\": \"You're going in knowing it might not go well. Keep it short, about one thing, and look after yourself after.\", \"who_title\": \"Who might show up in this conversation?\"}", s.tablesJson = "{\"ask_down\": {\"firm\": \"plain\", \"firm_hold\": \"firm\", \"gentle\": \"hint\", \"hint\": \"hint\", \"plain\": \"gentle\"}, \"ask_level\": {\"0\": \"hint\", \"1.5\": \"gentle\", \"2.5\": \"plain\", \"3.5\": \"firm\", \"4.5\": \"firm_hold\"}, \"ask_up\": {\"firm\": \"firm_hold\", \"firm_hold\": \"firm_hold\", \"gentle\": \"plain\", \"hint\": \"gentle\", \"plain\": \"firm\"}}", s.deriveJson = "[{\"fields\": [\"s_able\", \"s_matters\", \"s_right\", \"s_timing\", \"s_ready\"], \"kind\": \"count\", \"name\": \"ask_level\", \"table\": \"ask_level\", \"weights\": {\"no\": 0, \"not_sure\": 0.5, \"yes\": 1}}, {\"from\": \"$d.ask_level\", \"name\": \"ask_softer\", \"table\": \"ask_down\"}, {\"from\": \"$d.ask_level\", \"name\": \"ask_firmer\", \"table\": \"ask_up\"}]";
