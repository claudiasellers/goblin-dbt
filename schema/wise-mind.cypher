SET n += {mind: "emotion", label: "This feeling is the truth", order: 0, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_trust_emotion_1"}), (w:WiseMindQuestion {id: "wm_q_trust"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_trust_emotion_2"})
