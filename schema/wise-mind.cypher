// --- The practices (screen 3), hung off the concept ---
MATCH (:TherapyConcept {id: 'dbt_wise_mind'})-[r:HAS_PRACTICE]->() DELETE r;
MERGE (n:WiseMindPractice {id: "wm_stone"})
SET n += {name: "Stone on the lake", sub: "A small stone drifts down through clear water and settles.", kind: "drift", lines: ["Picture a clear lake, and a small flat stone on the water.", "Let it go. It drifts down slowly through the clear water.", "It settles on the soft sand at the bottom. Rest there with it."], seconds: 40, order: 0, version: "wise-mind-v1"};
MATCH (t:TherapyConcept {id: 'dbt_wise_mind'}), (p:WiseMindPractice {id: "wm_stone"})
MERGE (t)-[:HAS_PRACTICE]->(p);
MERGE (n:WiseMindPractice {id: "wm_breath"})
SET n += {name: "Wise in, mind out", sub: "Five breaths. Hold as you breathe in, let go as you breathe out.", kind: "hold", lines: ["Breathing in: wise.", "Breathing out: mind."], breaths: 5, order: 1, version: "wise-mind-v1"};
MATCH (t:TherapyConcept {id: 'dbt_wise_mind'}), (p:WiseMindPractice {id: "wm_breath"})
MERGE (t)-[:HAS_PRACTICE]->(p);
MERGE (n:WiseMindPractice {id: "wm_ask"})
SET n += {name: "Ask and listen", sub: "Three breaths. Ask on the in-breath, listen on the out-breath.", kind: "ask", lines: ["Breathing in, ask.", "Listen."], breaths: 3, order: 2, version: "wise-mind-v1"};
MATCH (t:TherapyConcept {id: 'dbt_wise_mind'}), (p:WiseMindPractice {id: "wm_ask"})
MERGE (t)-[:HAS_PRACTICE]->(p);

// --- What wise mind says (screen 4) and where it can go next (screen 6) ---
MERGE (n:WiseMindAnswer {id: "wm_a_know"})
SET n += {label: "I already know what to do", order: 0, nextToolIds: ["problem-solve"], version: "wise-mind-v1"};
MERGE (n:WiseMindAnswer {id: "wm_a_wait"})
SET n += {label: "Wait, not now", order: 1, nextToolIds: ["pause"], version: "wise-mind-v1"};
MERGE (n:WiseMindAnswer {id: "wm_a_say"})
SET n += {label: "Say it, kindly", order: 2, nextToolIds: ["dear-man"], version: "wise-mind-v1"};
