SET n += {label: "Whether to trust this feeling", order: 4, defaultPracticeId: "wm_ask", version: "wise-mind-v1"};
MERGE (n:WiseMindQuestion {id: "wm_q_settle"})
SET n += {label: "Nothing in particular, I want to settle", order: 5, defaultPracticeId: "wm_stone", version: "wise-mind-v1"};

