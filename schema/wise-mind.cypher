// --- Flow document (every other line of screens 1-6) ---
MERGE (f:WiseMindFlow {id: 'wise_mind_flow'})
SET f += {version: "wise-mind-v1", contentJson: "{\"version\": \"wise-mind-v1\", \"ownMax\": 140, \"sourceIds\": [\"linehan_skills_2015\"], \"copy\": {\"chrome\": {\"back\": \"Back\", \"next\": \"Next\", \"skip\": \"Skip\"}, \"question\": {\"prompt\": \"What would you like wise mind's help with?\", \"own\": \"Something else\", \"ownLabel\": \"What would you like help with?\"}, \"minds\": {\"prompt\": \"Tap each side to hear what it says.\", \"emotion\": \"Emotion mind\", \"reason\": \"Reasonable mind\", \"emotionSays\": \"Emotion mind says…\", \"reasonSays\": \"Reasonable mind says…\", \"nothingComes\": \"Nothing comes\", \"own\": \"Something else\", \"ownLabel\": \"In your own words\", \"witness\": \"Both make sense from where they stand.\"}, \"dropIn\": {\"prompt\": \"Choose a way in.\", \"start\": \"Start\", \"here\": \"I'm here\", \"hold\": \"Hold as you breathe in\", \"letGo\": \"Let go as you breathe out\", \"holdHint\": \"Hold to fill it, or press once and wait.\", \"listen\": \"Listen.\"}, \"comes\": {\"prompt\": \"What does wise mind say?\", \"own\": \"Something else\", \"ownLabel\": \"What does it say?\", \"quiet\": \"Wise mind is often quiet. It can arrive later, on a walk or in the shower.\"}, \"feel\": {\"prompt\": \"How does it feel?\", \"options\": {\"calm\": \"Calm, settled\", \"pushed\": \"Pushed, urgent\", \"unsure\": \"Not sure\"}, \"lines\": {\"calm\": \"That sounds like wise mind.\", \"pushed\": \"That might be emotion mind talking.\", \"unsure\": \"Keep it and see how it sits.\"}, \"onceMore\": \"Drop in once more\", \"keepAnyway\": \"Keep it anyway\"}, \"next\": {\"prompt\": \"What's one thing you'll do with it?\", \"enough\": \"This is enough for now\", \"keep\": \"Keep what wise mind said\", \"kept\": \"Wise mind said: {answer}\", \"keptDone\": \"Kept in My words.\", \"done\": \"Done\"}}}"};
MATCH (f:WiseMindFlow {id: 'wise_mind_flow'}), (s:ClinicalSource)
WHERE s.id IN ["linehan_skills_2015"]
MERGE (f)-[:GROUNDED_IN]->(s);
MATCH (f:WiseMindFlow {id: 'wise_mind_flow'}), (t:TherapyConcept {id: 'dbt_wise_mind'})
MERGE (t)-[:IMPLEMENTED_BY_FLOW]->(f);
MATCH (t:TherapyConcept {id: 'dbt_wise_mind'})
SET t += {whenToUse: "When you're torn about what to do", dbtBasis: 'DBT Mindfulness: wise mind (states of mind; ideas for practising wise mind)'};

// --- The questions (screen 1) ---
MERGE (n:WiseMindQuestion {id: "wm_q_next"})
SET n += {label: "What to do next", order: 0, defaultPracticeId: "wm_ask", version: "wise-mind-v1"};
MERGE (n:WiseMindQuestion {id: "wm_q_say"})
SET n += {label: "Whether to say something", order: 1, defaultPracticeId: "wm_ask", version: "wise-mind-v1"};
MERGE (n:WiseMindQuestion {id: "wm_q_let_go"})
SET n += {label: "Whether to let it go", order: 2, defaultPracticeId: "wm_ask", version: "wise-mind-v1"};
