SET n += {mind: "reason", label: "Think about what holding on costs", order: 2, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_let_go_reason_3"}), (w:WiseMindQuestion {id: "wm_q_let_go"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_need_emotion_1"})
SET n += {mind: "emotion", label: "I need someone, right now", order: 0, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_need_emotion_1"}), (w:WiseMindQuestion {id: "wm_q_need"})
