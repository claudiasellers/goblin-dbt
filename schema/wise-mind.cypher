SET n += {mind: "emotion", label: "Don't, it'll go badly", order: 1, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_say_emotion_2"}), (w:WiseMindQuestion {id: "wm_q_say"})
MERGE (v)-[:VOICES]->(w);
