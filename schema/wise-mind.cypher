SET n += {mind: "reason", label: "Do the sensible thing", order: 1, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_next_reason_2"}), (w:WiseMindQuestion {id: "wm_q_next"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_next_reason_3"})
SET n += {mind: "reason", label: "Wait for more information", order: 2, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_next_reason_3"}), (w:WiseMindQuestion {id: "wm_q_next"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_say_emotion_1"})
SET n += {mind: "emotion", label: "Say it now", order: 0, version: "wise-mind-v1"};
