SET n += {mind: "reason", label: "It's not worth the fight", order: 1, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_say_reason_2"}), (w:WiseMindQuestion {id: "wm_q_say"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_say_reason_3"})
SET n += {mind: "reason", label: "Get the facts first", order: 2, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_say_reason_3"}), (w:WiseMindQuestion {id: "wm_q_say"})
MERGE (v)-[:VOICES]->(w);
MERGE (n:MindVoice {id: "wm_v_let_go_emotion_1"})
SET n += {mind: "emotion", label: "I can't let this go", order: 0, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_let_go_emotion_1"}), (w:WiseMindQuestion {id: "wm_q_let_go"})
