SET n += {mind: "emotion", label: "Fix it before it gets worse", order: 1, version: "wise-mind-v1"};
MATCH (v:MindVoice {id: "wm_v_next_emotion_2"}), (w:WiseMindQuestion {id: "wm_q_next"})
MERGE (v)-[:VOICES]->(w);
