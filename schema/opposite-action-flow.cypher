// Run after existing opposite-action-data.cypher. Idempotent, additive migration.
// Original app wording; conceptual grounding in Linehan, not a workbook reproduction.
CREATE CONSTRAINT opposite_action_session_key IF NOT EXISTS
FOR (s:OppositeActionSession) REQUIRE s.key IS UNIQUE;
MERGE (s:ClinicalSource {id: 'linehan_er_9_11'})
SET s.title = 'Marsha M. Linehan — DBT Skills Training Handouts and Worksheets, 2nd edition; Emotion Regulation Handouts 9–11',
    s.url = 'https://www.guilford.com/books/DBT-Skills-Training-Handouts-and-Worksheets/Marsha-Linehan/9781572307810';
MERGE (s:ClinicalSource {id: 'psychwire_oa_sadness'})
SET s.title = 'Jill Rathus — Opposite Action Steps For Sadness',
    s.url = 'https://psychwire.com/free-resources/therapy-demonstrations/resource-1y329mm/opposite-action-steps-for-sadness';
MERGE (p:OppositeActionFlow {id: 'opposite_action_flow'})
SET p.version = 'oa-guided-v1', p.contentJson = "{\"version\": \"oa-guided-v1\", \"copy\": {\"intro\": \"An emotion can make sense and still push you toward something that does not help. Start with one emotion and one urge. We will check the situation, choose a response, and see what you learn by trying it.\", \"context\": \"Choose the situation that is closest. You can add detail, but you do not have to write a full account.\", \"safety\": \"Before choosing an opposite: would acting against this urge put you or someone else at risk, cross a boundary, or ignore a real danger?\", \"support\": \"Protecting yourself comes first. Do not approach danger, unwanted contact, abuse, or unsafe exposure as an exercise. Create distance and contact someone you trust. If there is immediate danger, contact local emergency services. If you are unsure what is safe, pause and get support before proceeding.\", \"urge\": \"Pick the urge you want to work with first. Having an urge does not mean you have acted on it.\", \"facts\": \"Separate what you observed from what you fear or assume it means. These examples from the emotion guide are prompts to consider, not proof that they apply to you.\", \"factsQuestion\": \"After checking, how well do the emotion and its intensity or duration fit what is happening?\", \"effectiveness\": \"If you follow this urge, will it help you move toward your goal without creating a bigger problem?\", \"clarify\": \"You do not have to decide that an emotion is unjustified. Check one missing fact, consider another explanation, or talk it through with someone you trust. For now, postpone any irreversible action.\", \"problem\": \"Your answers suggest addressing the situation directly. You can acknowledge the emotion, protect your boundaries, and choose an effective response. Return to opposite action if an unhelpful urge remains.\", \"opposite\": \"Your answers suggest trying a safe opposite to this urge. This does not mean your feeling is wrong. You are experimenting with a different behavior.\", \"action\": \"Choose one action you can actually try. A smaller step is a starting point; the aim is to engage fully within that step, then repeat or expand when appropriate.\", \"customAction\": \"These are general examples for this emotion, not a personalized interpretation of your words. Check whether they truly oppose your particular urge. You can write a safer, more specific action.\", \"allTheWay\": \"Practice with your behavior, attention, posture, expression, and tone working in the same direction. You do not need to feel convinced first. Keep appropriate boundaries and reassess if new facts change what is safe.\", \"lowConfidence\": \"Make the action smaller or choose a specific backup. Preparation can count as preparation without pretending you have practiced the opposite yet.\", \"practice\": \"Try the action in your actual situation when it is safe and appropriate. There is no countdown to beat. You can stop, resize the step, or return later.\", \"reflect\": \"Notice what happened after you tried. A change in emotion is useful information, but doing something effective can matter even when the feeling stays.\", \"reflectionUnsafe\": \"Stop this exercise and prioritize safety. Recheck the situation with support before trying again. You do not need to push through danger to complete a skill.\", \"reflectionHigher\": \"The intensity rose. That is information, not a failed test. Pause, check for new facts or an oversized step, and consider support before repeating.\", \"reflectionSame\": \"The intensity stayed the same. One attempt does not settle whether the skill is useful. Notice whether your behavior served your goal; you can repeat a safe, manageable step or revise it.\", \"reflectionLower\": \"The intensity decreased during this attempt. Notice what you did and what else changed. One attempt cannot prove what caused the change; keep what seems useful and reassess next time.\", \"privacy\": \"Your answers stay in this open exercise unless you choose Save. Saving adds them to your account for future reflection. No AI service receives them in this version.\", \"guiltCheck\": \"Consider whether a specific action violated your own values or caused harm. If so, repair or problem-solving may be useful. Guilt alone is not proof that you did something wrong.\", \"shameCheck\": \"Consider both your values and the actual social context. Rejection or discrimination can be real. Opposite action does not require disclosure to someone unsafe or accepting mistreatment.\"}, \"choices\": {\"situation\": [{\"id\": \"relationship\", \"label\": \"A conversation or relationship\"}, {\"id\": \"work\", \"label\": \"Work, school, or a task\"}, {\"id\": \"change\", \"label\": \"A loss, change, or disappointment\"}, {\"id\": \"self\", \"label\": \"Something I did or think about myself\"}, {\"id\": \"other\", \"label\": \"Something else\"}], \"goal\": [{\"id\": \"connection\", \"label\": \"Stay connected\"}, {\"id\": \"boundary\", \"label\": \"Protect a boundary\"}, {\"id\": \"progress\", \"label\": \"Make progress on something\"}, {\"id\": \"repair\", \"label\": \"Repair harm\"}, {\"id\": \"self_respect\", \"label\": \"Act with self-respect\"}], \"safety\": [{\"id\": \"safe\", \"label\": \"I can explore a different response safely\"}, {\"id\": \"unsafe\", \"label\": \"There is danger or a boundary I need to protect\"}, {\"id\": \"unsure\", \"label\": \"I am not sure what is safe\"}], \"facts\": [{\"id\": \"fits\", \"label\": \"The emotion and its intensity fit\"}, {\"id\": \"excessive\", \"label\": \"The emotion fits, but the intensity or duration does not\"}, {\"id\": \"not_fit\", \"label\": \"The facts do not support this emotion\"}, {\"id\": \"unsure\", \"label\": \"I still do not know\"}], \"effectiveness\": [{\"id\": \"helpful\", \"label\": \"Yes, this urge would help my goal\"}, {\"id\": \"unhelpful\", \"label\": \"No, it would make things harder\"}, {\"id\": \"unsure\", \"label\": \"I cannot tell yet\"}], \"cue\": [{\"id\": \"now\", \"label\": \"Now, in this situation\"}, {\"id\": \"today\", \"label\": \"At the next opportunity today\"}, {\"id\": \"next_time\", \"label\": \"When this urge shows up again\"}, {\"id\": \"custom\", \"label\": \"Choose my own cue\"}], \"barrier\": [{\"id\": \"none\", \"label\": \"Nothing specific\"}, {\"id\": \"too_big\", \"label\": \"The step feels too big\"}, {\"id\": \"forget\", \"label\": \"I might forget in the moment\"}, {\"id\": \"emotion\", \"label\": \"The feeling might take over\"}, {\"id\": \"other\", \"label\": \"Something else\"}], \"willingness\": [{\"id\": \"ready\", \"label\": \"Doable enough to try\"}, {\"id\": \"smaller\", \"label\": \"I need to make it smaller\"}], \"outcome\": [{\"id\": \"toward_goal\", \"label\": \"I acted more in line with my goal\"}, {\"id\": \"partial\", \"label\": \"I tried part of the action\"}, {\"id\": \"unclear\", \"label\": \"I cannot tell what helped yet\"}, {\"id\": \"unsafe\", \"label\": \"It felt unsafe or crossed a boundary\"}]}, \"routes\": {\"fits:helpful\": \"problem\", \"fits:unhelpful\": \"opposite\", \"fits:unsure\": \"clarify\", \"excessive:helpful\": \"problem\", \"excessive:unhelpful\": \"opposite\", \"excessive:unsure\": \"clarify\", \"not_fit:helpful\": \"problem\", \"not_fit:unhelpful\": \"opposite\", \"not_fit:unsure\": \"clarify\", \"unsure:helpful\": \"clarify\", \"unsure:unhelpful\": \"clarify\", \"unsure:unsure\": \"clarify\"}, \"sourceIds\": [\"linehan_er_9_11\", \"psychwire_oa_sadness\"]}";
MATCH (p:OppositeActionFlow {id: 'opposite_action_flow'}), (s:ClinicalSource)
WHERE s.id IN ['linehan_er_9_11', 'psychwire_oa_sadness']
MERGE (p)-[:GROUNDED_IN]->(s);
MATCH (p:OppositeActionFlow {id: 'opposite_action_flow'}), (c:EmotionRegulationContent)
MERGE (p)-[:USES_PROTOCOL]->(c);
// Remove absolute outcome promises from the existing curated content.
MATCH (c:EmotionRegulationContent {dbtParent: 'fear'})
SET c.whyItWorks = 'Approaching a situation you have assessed as safe can help you learn whether a feared outcome occurs. Feelings may change gradually; relief is not guaranteed on any one attempt.',
    c.defaultOppositeBigger = 'Engage fully with the safe activity you chose while keeping appropriate boundaries';
MATCH (c:EmotionRegulationContent {dbtParent: 'anger'})
SET c.whyItWorks = 'A measured response can interrupt an attack urge and make room for an effective boundary or conversation. You do not have to approve of what happened.';
