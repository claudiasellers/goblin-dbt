// Run after existing opposite-action-data.cypher. Idempotent, additive migration.
// Original app wording; conceptual grounding in Linehan, not a workbook reproduction.
CREATE CONSTRAINT opposite_action_session_key IF NOT EXISTS
FOR (s:OppositeActionSession) REQUIRE s.key IS UNIQUE;
MERGE (s:ClinicalSource {id: 'linehan_er_9_11'})
SET s.title = 'Marsha M. Linehan — DBT Skills Training Handouts and Worksheets, 2nd edition; Emotion Regulation Handouts 9–11',
    s.url = 'https://www.guilford.com/books/DBT-Skills-Training-Handouts-and-Worksheets/Marsha-Linehan/9781572307810';
MERGE (s:ClinicalSource {id: 'psychwire_oa_sadness'})
SET s.title = 'Jill Rathus — Opposite Action Steps For Sadness',
    s.url = 'https://psychwire.com/free-resources/therapy-demonstrations/resource-1y329mm/opposite-action-steps-for-sadness';
MERGE (p:OppositeActionFlow {id: 'opposite_action_flow'})
SET p.version = 'oa-guided-v2', p.contentJson = "{\"version\": \"oa-guided-v2\", \"copy\": {\"intro\": \"One emotion, one urge. A few quick taps to check the situation, a short body reset, then one step you can try. The feeling can make sense and the urge can still push you somewhere unhelpful.\", \"context\": \"Choose the situation that is closest. You can add detail, but you do not have to write a full account.\", \"safety\": \"Before choosing an opposite: would acting against this urge put you or someone else at risk, cross a boundary, or ignore a real danger?\", \"support\": \"Protecting yourself comes first. Do not approach danger, unwanted contact, abuse, or unsafe exposure as an exercise. Create distance and contact someone you trust. If there is immediate danger, contact local emergency services. If you are unsure what is safe, pause and get support before proceeding.\", \"urge\": \"Pick the urge you want to work with first. Having an urge does not mean you have acted on it.\", \"facts\": \"Separate what you observed from what you fear or assume it means. These examples from the emotion guide are prompts to consider, not proof that they apply to you.\", \"factsQuestion\": \"After checking, how well do the emotion and its intensity or duration fit what is happening?\", \"effectiveness\": \"If you follow this urge, will it help you move toward your goal without creating a bigger problem?\", \"clarify\": \"You do not have to decide that an emotion is unjustified. Check one missing fact, consider another explanation, or talk it through with someone you trust. For now, postpone any irreversible action.\", \"problem\": \"Your answers suggest addressing the situation directly. You can acknowledge the emotion, protect your boundaries, and choose an effective response. Return to opposite action if an unhelpful urge remains.\", \"opposite\": \"Your answers suggest trying a safe opposite to this urge. This does not mean your feeling is wrong. You are experimenting with a different behavior.\", \"action\": \"Choose one action you can actually try. A smaller step is a starting point; the aim is to engage fully within that step, then repeat or expand when appropriate.\", \"customAction\": \"These are general examples for this emotion, not a personalized interpretation of your words. Check whether they truly oppose your particular urge. You can write a safer, more specific action.\", \"allTheWay\": \"Practice with your behavior, attention, posture, expression, and tone working in the same direction. You do not need to feel convinced first. Keep appropriate boundaries and reassess if new facts change what is safe.\", \"lowConfidence\": \"Make the action smaller or choose a specific backup. Preparation can count as preparation without pretending you have practiced the opposite yet.\", \"practice\": \"Try the action in your actual situation when it is safe and appropriate. There is no countdown to beat. You can stop, resize the step, or return later.\", \"reflect\": \"Notice what happened after you tried. A change in emotion is useful information, but doing something effective can matter even when the feeling stays.\", \"reflectionUnsafe\": \"Stop this exercise and prioritize safety. Recheck the situation with support before trying again. You do not need to push through danger to complete a skill.\", \"reflectionHigher\": \"The intensity rose. That is information, not a failed test. Pause, check for new facts or an oversized step, and consider support before repeating.\", \"reflectionSame\": \"The intensity stayed the same. One attempt does not settle whether the skill is useful. Notice whether your behavior served your goal; you can repeat a safe, manageable step or revise it.\", \"reflectionLower\": \"The intensity decreased during this attempt. Notice what you did and what else changed. One attempt cannot prove what caused the change; keep what seems useful and reassess next time.\", \"privacy\": \"Your answers stay in this exercise unless you choose Save. Saving adds them to your account so you can reflect later. No AI service receives them in this version.\", \"guiltCheck\": \"Consider whether a specific action violated your own values or caused harm. If so, repair or problem-solving may be useful. Guilt alone is not proof that you did something wrong.\", \"shameCheck\": \"Consider both your values and the actual social context. Rejection or discrimination can be real. Opposite action does not require disclosure to someone unsafe or accepting mistreatment.\", \"urgeStrength\": \"How strong is the pull to {urge} right now?\", \"urgeStrengthHint\": \"Rate the urge, not the feeling. This is the number we will watch.\", \"feelingOptional\": \"Also rate the feeling itself (optional)\", \"checkIntro\": \"Four quick taps. There are no wrong answers, and you can go back.\", \"goalQuestion\": \"What do you want this moment to help you do?\", \"factsDetailToggle\": \"Check the facts in more detail (optional)\", \"bodyIntro\": \"Before planning anything, shift your body a little. Tap a card, then do it for a few seconds.\", \"bodyHold\": \"Tap to start, or press and hold while you do it\", \"bodyDone\": \"Done\", \"bodyEscape\": \"That is too much right now\", \"bodyEscapeIntro\": \"Try this smaller one instead. It still counts.\", \"bodyRerate\": \"Now, how strong is the pull to {urge}?\", \"bodyNotice\": \"Whatever the number is, you just acted against the urge with your body. That is practice.\", \"stepIntro\": \"Pick one step. Engage fully within it, even if it is small.\", \"stepCapacity\": \"The pull is strong right now, so the small step is highlighted. Small and done beats big and skipped.\", \"stepMore\": \"Bigger steps, for when you have more room\", \"whenQuestion\": \"When will you try it?\", \"dueQuestion\": \"When is the next chance likely to come up?\", \"snagToggle\": \"Plan for a snag (optional)\", \"tryNow\": \"Try it now, in your actual situation, when it is safe. Keep the body cue going. Come back here when you have tried, even partly.\", \"reflectUrge\": \"When you did it, how strong was the pull to {urge}?\", \"reflectFeeling\": \"And the feeling itself (optional)\", \"readoutUrgeLower\": \"The pull to {urge} came down. Urges often shift before feelings do, so this is the number to watch. One attempt cannot prove what caused it; notice what you did.\", \"readoutUrgeSlight\": \"The pull to {urge} eased a little. Small shifts are worth noticing, and they can add up across repeats.\", \"readoutUrgeSame\": \"The pull stayed where it was, and you still acted against it. Doing the opposite while the urge is loud is the practice, not a failed test.\", \"readoutUrgeHigher\": \"The pull got louder. Urges often push back when you first go against them. Consider a smaller step or a skill that lowers intensity first, and check for new facts.\", \"readoutUnsafe\": \"Stop this exercise and prioritize safety. Recheck the situation with support before trying again. You do not need to push through danger to complete a skill.\", \"readoutEmotionLag\": \"Feelings often lag behind action and may shift later, or on a later repeat. A feeling that stays put does not cancel a change in the urge.\", \"readoutActed\": \"You acted against the urge while it was at {level}/10.\", \"readoutPlanned\": \"Your plan is ready. After the body reset, the pull went from {from} to {to}.\", \"readoutPlannedSame\": \"Your plan is ready. You practiced the body part already; the rest happens in your situation.\", \"followUpOffer\": \"Next time you open the app, you will see a check-in card for this plan. Add a calendar reminder if you want a nudge at the time.\", \"followUpSave\": \"Save my plan\", \"followUpCalendar\": \"Add a reminder to my calendar\", \"followUpCalendarNote\": \"The reminder says only \\\"Quick check-in\\\" so it stays private on a shared screen.\", \"calendarTitle\": \"Quick check-in\", \"calendarBody\": \"You made a plan earlier. Tap to tell yourself how it went.\", \"notificationBody\": \"You made a plan earlier. 20-second check-in?\", \"followUpCardDue\": \"Earlier you planned a step. How did it go?\", \"followUpCardUpcoming\": \"You have a step planned for later.\", \"followUpCardStale\": \"Didn't get to it? That is information too.\", \"followUpQuestion\": \"Did you get to it?\", \"missedQuestion\": \"What got in the way?\", \"missedTooStrong\": \"Next time, try a smaller step, or bring the intensity down first. Here is the small version of the same step.\", \"missedNoMoment\": \"That happens. Keep the same plan for the next chance.\", \"missedForgot\": \"Forgetting is common when a plan is not tied to a cue. A calendar reminder or a specific moment can help.\", \"missedChoseNot\": \"Okay. Choosing not to is information too. If you want, note what made it not worth it this time.\", \"notApplicableTitle\": \"A different starting point\", \"notApplicableFallback\": \"The guide does not recommend opposite action for this emotion.\", \"signedOutNote\": \"You can do this without an account. Signing in lets you save your plan and get a check-in card later.\", \"urgeCustom\": \"My urge is different\", \"urgeCustomPrompt\": \"What is the urge pushing you to do?\", \"feelingNow\": \"How strong is the feeling ({emotion}) right now?\", \"feelingAfter\": \"How strong is the feeling ({emotion}) now?\", \"scaleLow\": \"Not at all\", \"scaleHigh\": \"As strong as it gets\", \"factsFitsHeading\": \"When this feeling fits the facts\", \"factsObserve\": \"What did you observe? (optional)\", \"factsObservePlaceholder\": \"What could a camera or microphone capture?\", \"factsMeaning\": \"What meaning or prediction did you add? (optional)\", \"routeHeadingOpposite\": \"Try a different response to the urge\", \"routeHeadingProblem\": \"Address what is happening\", \"routeHeadingClarify\": \"Leave room for uncertainty\", \"routeHeadingSupport\": \"Safety comes first\", \"bodyHolding\": \"Keep holding while you do it\", \"bodyCountdown\": \"Do it now · {seconds}s · tap to stop\", \"bodyHoldHint\": \"Tap once to start a {seconds}-second timer and do the cue hands-free, or press and hold while you do it. Tap again to stop the timer. Space or Enter works the same way.\", \"bodyEscapeShow\": \"Show me a small body step\", \"bodyEscapeAnother\": \"Show me a different one\", \"bodyEscapeBack\": \"Back to the body cues\", \"sizeSmall\": \"A small start\", \"sizeMedium\": \"A little further\", \"sizeBigger\": \"Fuller practice\", \"stepOwn\": \"Write my own\", \"stepOwnPrompt\": \"What will you do differently, while keeping it safe?\", \"stepBodyLine\": \"Keep this going while you do it\", \"backupLabel\": \"If that happens, what smaller step or support will you use? (optional)\", \"tryBody\": \"Keep your body with you\", \"tryStuck\": \"If I get stuck:\", \"tryDone\": \"I tried it\", \"tryLater\": \"Not now, plan it for later\", \"outcomeQuestion\": \"What happened?\", \"noteToggle\": \"Add a note (optional)\", \"noteLabel\": \"What did you notice or learn?\", \"missedTrySmall\": \"Try the small version now\", \"missedKeepPlan\": \"Keep the plan for the next chance\", \"missedReminder\": \"Keep the plan and add a calendar reminder\", \"missedNoteToggle\": \"Add a note\", \"missedNoteLabel\": \"What made it not worth it this time? (optional)\", \"missedNoteSave\": \"Save note\", \"readoutPullTo\": \"Pull to {urge}\", \"readoutBefore\": \"Before\", \"readoutAfterTry\": \"After trying\", \"readoutAfterBody\": \"After the body reset\", \"readoutHigherTools\": \"If the pull stays loud, one of these can bring the intensity down first:\", \"saveReflection\": \"Save this reflection\", \"signedOutSave\": \"You can use this exercise without saving. Sign in before starting if you want to save it to your account and get a check-in card later.\"}, \"choices\": {\"situation\": [{\"id\": \"relationship\", \"label\": \"A conversation or relationship\"}, {\"id\": \"work\", \"label\": \"Work, school, or a task\"}, {\"id\": \"change\", \"label\": \"A loss, change, or disappointment\"}, {\"id\": \"self\", \"label\": \"Something I did or think about myself\"}, {\"id\": \"other\", \"label\": \"Something else\"}], \"goal\": [{\"id\": \"connection\", \"label\": \"Stay connected\"}, {\"id\": \"boundary\", \"label\": \"Protect a boundary\"}, {\"id\": \"progress\", \"label\": \"Make progress on something\"}, {\"id\": \"repair\", \"label\": \"Repair harm\"}, {\"id\": \"self_respect\", \"label\": \"Act with self-respect\"}], \"safety\": [{\"id\": \"safe\", \"label\": \"I can explore a different response safely\"}, {\"id\": \"unsafe\", \"label\": \"There is danger or a boundary I need to protect\"}, {\"id\": \"unsure\", \"label\": \"I am not sure what is safe\"}], \"facts\": [{\"id\": \"fits\", \"label\": \"The emotion and its intensity fit\"}, {\"id\": \"excessive\", \"label\": \"The emotion fits, but the intensity or duration does not\"}, {\"id\": \"not_fit\", \"label\": \"The facts do not support this emotion\"}, {\"id\": \"unsure\", \"label\": \"I still do not know\"}], \"effectiveness\": [{\"id\": \"helpful\", \"label\": \"Yes, this urge would help my goal\"}, {\"id\": \"unhelpful\", \"label\": \"No, it would make things harder\"}, {\"id\": \"unsure\", \"label\": \"I cannot tell yet\"}], \"cue\": [{\"id\": \"now\", \"label\": \"Now, in this situation\"}, {\"id\": \"today\", \"label\": \"At the next opportunity today\"}, {\"id\": \"next_time\", \"label\": \"When this urge shows up again\"}], \"barrier\": [{\"id\": \"none\", \"label\": \"Nothing specific\"}, {\"id\": \"too_big\", \"label\": \"The step feels too big\"}, {\"id\": \"forget\", \"label\": \"I might forget in the moment\"}, {\"id\": \"emotion\", \"label\": \"The feeling might take over\"}, {\"id\": \"other\", \"label\": \"Something else\"}], \"outcome\": [{\"id\": \"toward_goal\", \"label\": \"I acted more in line with my goal\"}, {\"id\": \"partial\", \"label\": \"I tried part of the action\"}, {\"id\": \"unclear\", \"label\": \"I cannot tell what helped yet\"}, {\"id\": \"unsafe\", \"label\": \"It felt unsafe or crossed a boundary\"}], \"dueWindow\": [{\"id\": \"hour\", \"label\": \"Within the hour\"}, {\"id\": \"afternoon\", \"label\": \"This afternoon\"}, {\"id\": \"evening\", \"label\": \"This evening\"}, {\"id\": \"unsure\", \"label\": \"Not sure\"}], \"followUp\": [{\"id\": \"did\", \"label\": \"I did it\"}, {\"id\": \"partly\", \"label\": \"Partly\"}, {\"id\": \"not_yet\", \"label\": \"I didn't get to it\"}], \"missedReason\": [{\"id\": \"too_strong\", \"label\": \"The urge was too strong\"}, {\"id\": \"no_moment\", \"label\": \"The moment didn't come\"}, {\"id\": \"forgot\", \"label\": \"I forgot\"}, {\"id\": \"chose_not\", \"label\": \"I decided not to\"}]}, \"routes\": {\"fits:helpful\": \"problem\", \"fits:unhelpful\": \"opposite\", \"fits:unsure\": \"clarify\", \"excessive:helpful\": \"problem\", \"excessive:unhelpful\": \"opposite\", \"excessive:unsure\": \"clarify\", \"not_fit:helpful\": \"clarify\", \"not_fit:unhelpful\": \"opposite\", \"not_fit:unsure\": \"clarify\", \"unsure:helpful\": \"clarify\", \"unsure:unhelpful\": \"clarify\", \"unsure:unsure\": \"clarify\"}, \"sourceIds\": [\"linehan_er_9_11\", \"psychwire_oa_sadness\"]}";
MATCH (p:OppositeActionFlow {id: 'opposite_action_flow'}), (s:ClinicalSource)
WHERE s.id IN ['linehan_er_9_11', 'psychwire_oa_sadness']
MERGE (p)-[:GROUNDED_IN]->(s);
MATCH (p:OppositeActionFlow {id: 'opposite_action_flow'}), (c:EmotionRegulationContent)
MERGE (p)-[:USES_PROTOCOL]->(c);
// Remove absolute outcome promises from the existing curated content.
MATCH (c:EmotionRegulationContent {dbtParent: 'fear'})
SET c.whyItWorks = 'Approaching a situation you have assessed as safe can help you learn whether a feared outcome occurs. Feelings may change gradually; relief is not guaranteed on any one attempt.',
    c.defaultOppositeBigger = 'Engage fully with the safe activity you chose while keeping appropriate boundaries';
MATCH (c:EmotionRegulationContent {dbtParent: 'anger'})
SET c.whyItWorks = 'A measured response can interrupt an attack urge and make room for an effective boundary or conversation. You do not have to approve of what happened.';

// ============================================================
// SOMATIC CIRCUIT-BREAKER CUES (oa-guided-v2)
// Atomic, do-it-now body cues: the posture / face / muscle-tension part of
// "opposite action all the way". Parent defaults plus urge-level overrides
// where the urge has its own posture (e.g. freeze needs up-regulation,
// not relaxation). Short imperatives, performed while holding a button.
// ============================================================
MATCH (c:EmotionRegulationContent {dbtParent: 'fear'})
SET c.somaticCues = ['Drop your shoulders away from your ears', 'Unclench your jaw and let your teeth part', 'Breathe out a little longer than you breathe in'];
MATCH (c:EmotionRegulationContent {dbtParent: 'anger'})
SET c.somaticCues = ['Open your hands, palms up', 'Unclench your jaw', 'Try a half-smile: just lift the corners of your lips'];
MATCH (c:EmotionRegulationContent {dbtParent: 'sadness'})
SET c.somaticCues = ['Sit or stand upright', 'Lift your eyes to the horizon', 'Try a half-smile: just lift the corners of your lips'];
MATCH (c:EmotionRegulationContent {dbtParent: 'disgust'})
SET c.somaticCues = ['Relax your nose and upper lip', 'Open your hands', 'Lean in slightly instead of back'];
MATCH (c:EmotionRegulationContent {dbtParent: 'shame'})
SET c.somaticCues = ['Roll your shoulders back and open your chest', 'Lift your chin and your eyes', 'Uncross your arms and take up your space'];
MATCH (c:EmotionRegulationContent {dbtParent: 'guilt'})
SET c.somaticCues = ['Lift your head', 'Let your hands rest still and open', 'Take one steady breath'];
MATCH (c:EmotionRegulationContent {dbtParent: 'jealousy'})
SET c.somaticCues = ['Loosen your grip and open your hands', 'Soften the muscles around your eyes', 'Breathe out slowly'];
MATCH (c:EmotionRegulationContent {dbtParent: 'envy'})
SET c.somaticCues = ['Soften the muscles around your eyes', 'Unclench your jaw', 'Try a half-smile: just lift the corners of your lips'];
MATCH (c:EmotionRegulationContent {dbtParent: 'love'})
SET c.somaticCues = ['Put your phone face-down and your hands in your lap', 'Turn your body away from the phone', 'Take one slow breath'];

// Urge-level cues. `replace: true` means ONLY these cues are shown: freeze and
// shutdown states need up-regulation, and the parent's relaxing cues (longer
// exhale, drop shoulders) would deepen the shutdown.
UNWIND [
  {id: 'fear-freeze',    replace: true,  cues: ['Press your feet into the floor and stand up', 'Shift your weight from foot to foot', 'Lift your eyes and look around the room']},
  {id: 'sad-bed',        replace: true,  cues: ['Sit all the way up', 'Put both feet on the floor', 'Lift your eyes toward the light']},
  {id: 'fear-escape',    replace: false, cues: ['Plant your feet and soften your knees']},
  {id: 'shame-hide',     replace: false, cues: ['Roll your shoulders back and lift your chin']},
  {id: 'shame-shrink',   replace: false, cues: ['Roll your shoulders back and lift your chin']},
  {id: 'anger-lash',     replace: false, cues: ['Open your hands, palms up']},
  {id: 'anger-destroy',  replace: false, cues: ['Open your hands, palms up']},
  {id: 'love-reach-out', replace: false, cues: ['Put your phone face-down and your hands in your lap']},
  {id: 'jealousy-check', replace: false, cues: ['Put your phone face-down and your hands in your lap']},
  {id: 'text-again',     replace: false, cues: ['Put your phone face-down and your hands in your lap']},
  {id: 'check-profile',  replace: false, cues: ['Put your phone face-down and your hands in your lap']},
  {id: 'pull-away',      replace: false, cues: ['Turn toward the room and lift your eyes']},
  {id: 'fire-back',      replace: false, cues: ['Open your hands, palms up']},
  {id: 'go-quiet',       replace: false, cues: ['Unclench your jaw and let your shoulders drop']}
] AS o
MATCH (u:ActionUrge {id: o.id})
SET u.somaticCues = o.cues, u.somaticReplace = o.replace
REMOVE u.somaticCue;

// Follow-up lookups for reminders (planned sessions with a due time).
CREATE INDEX opposite_action_session_due IF NOT EXISTS
FOR (s:OppositeActionSession) ON (s.dueAt);
