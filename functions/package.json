{
  "name": "functions",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/unit/*.test.cjs",
    "test:emulator": "npm run build && firebase emulators:exec --only auth,functions --project demo-goblindbt \"node --test test/emulator/*.test.cjs\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.0.5",
    "neo4j-driver": "^5.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "firebase-tools": "^15.32.0",
    "typescript": "^5.4.0"
  },
  "private": true
}
