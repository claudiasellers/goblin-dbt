# Firebase Configuration (frontend)
# These are safe to have in the frontend - Firebase security comes from Security Rules
# Copy this file to .env and fill in your Firebase project credentials
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================
# Neo4j credentials are NOT stored here!
# ============================================
# Neo4j credentials are securely stored as Firebase secrets.
# Set them using the Firebase CLI:
#
#   firebase functions:secrets:set NEO4J_URI
#   firebase functions:secrets:set NEO4J_USER
#   firebase functions:secrets:set NEO4J_PASSWORD
#
# These secrets are only accessible to Cloud Functions running on the server,
# never exposed to the browser.

# App Check (optional until enforced): reCAPTCHA Enterprise site key from Firebase console → App Check
VITE_APP_CHECK_SITE_KEY=

# Admin: Firebase uids (comma-separated) who see the "Official DBT names" switch on the Tools page.
# Labels only, not a security boundary. Dev builds always show it. Deploy: repository variable VITE_ADMIN_UIDS.
VITE_ADMIN_UIDS=
