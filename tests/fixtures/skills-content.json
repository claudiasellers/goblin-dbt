 "skills": [
  {
   "id": "check_the_facts",
   "toolId": "check-the-facts",
   "version": "cf-v1",
   "start": "feel",
   "accepts": [],
   "ownMax": 140,
   "emotionFields": [
    "feel"
   ],
   "copy": {
    "feel_title": "What's the feeling you want to check?",
    "feel_more": "Something else",
    "event_title": "What happened, as a camera would have caught it?",
    "event_own_hint": "Only what happened, no why.",
    "story_title": "What's the story you're telling yourself about it?",
    "story_hint": "Pick one or two.",
    "alt_title": "What else could explain it?",
    "alt_note": "You don't have to believe them. Notice that they're possible.",
    "threat_title": "What are you afraid will happen?",
    "likely_q": "How likely is it, really?",
    "through_q": "If it did happen, could you get through it?",
    "through_cope_ahead": "Plan for it with Cope Ahead",
    "fits_title": "Here's when feeling {feeling} fits the facts. Does one of these match what happened?",
    "fits_title_general": "Does feeling {feeling} fit what happened?",
    "next_fits": "When a feeling fits, the move is to work on the situation.",
    "next_partly": "The feeling makes sense, and it's turned up loud. Bring the volume down, then work on what's left.",
    "next_no": "The feeling is bigger than the facts. Acting opposite to its urge helps it settle.",
    "next_unsure": "That's all right. Sometimes the facts come later.",
    "own_hint": "Say it your way",
    "not_sure": "Not sure",
    "next": "Next",
    "done": "Done",
    "entry_oa": "Go through it slowly with Check the Facts"
   },
   "tables": {
    "storySetOf": {
     "fear": "fear",
     "anger": "anger",
     "sadness": "sadness",
     "shame": "shame",
     "guilt": "guilt"
    }
   },
   "derive": [
    {
     "name": "parent",
     "from": "$a.feel",
     "table": "parentOf"
    },
    {
     "name": "set",
     "from": "$d.parent",
     "table": "storySetOf",
     "default": "general"
    },
    {
     "name": "fitsParent",
     "from": "$d.parent",
     "table": "fitsWhen",
     "keep": "key"
    }
   ],
   "steps": [
    {
     "id": "feel",
     "kind": "ask",
     "title": "feel_title",
     "fields": [
      {
       "id": "feel",
       "options": {
        "emotions": [
         "anxious",
         "worried",
         "annoyed",
         "angry",
         "hurt",
         "guilty",
         "ashamed",
         "embarrassed"
        ],
        "carriedFirst": true,
        "moreKey": "feel_more"
       },
       "max": 1,
       "required": true,
       "emotion": true
      }
     ],
     "next": [
      {
       "to": "event",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "event",
     "kind": "ask",
     "title": "event_title",
     "fields": [
      {
       "id": "event",
       "options": {
        "list": "event"
       },
       "max": 1,
       "required": true,
       "own": {
        "hint": "event_own_hint",
        "countsAsPick": false,
        "open": true
       }
      }
     ],
     "next": [
      {
       "to": "story",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "story",
     "kind": "ask",
     "title": "story_title",
     "hint": "story_hint",
     "fields": [
      {
       "id": "story",
       "options": {
        "list": "story",
        "where": {
         "eq": [
          "$opt.set",
          "$d.set"
         ]
        }
       },
       "max": 2,
       "swap": true,
       "own": {
        "hint": "own_hint",
        "countsAsPick": true
       }
      }
     ],
     "slots": [
      {
       "after": "story",
       "embed": "partsLine",
       "props": {
        "promptId": "cf_unblend"
       },
       "showWhen": {
        "set": "$a.story"
       },
       "record": "unblend"
      }
     ],
     "next": [
      {
       "to": "alt",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "alt",
     "kind": "ask",
     "title": "alt_title",
     "note": "alt_note",
     "fields": [
      {
       "id": "alt",
       "options": {
        "list": "alt",
        "groupBy": "story",
        "ownGroup": "own_story"
       },
       "max": 9,
       "own": {
        "hint": "own_hint",
        "countsAsPick": false
       }
      }
     ],
     "next": [
      {
       "to": "threat",
       "when": {
        "any": [
         {
          "in": [
           "$d.set",
           [
            "fear",
            "anger",
            "shame"
           ]
          ]
         },
         {
          "some": [
           "story",
           {
            "eq": [
             "$opt.predicts",
             true
            ]
           }
          ]
         }
        ]
       }
      },
      {
       "to": "fits",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "threat",
     "kind": "ask",
     "title": "threat_title",
     "fields": [
      {
       "id": "threat",
       "max": 1,
       "own": {
        "hint": "own_hint",
        "countsAsPick": true
       },
       "options": {
        "list": "threat",
        "where": {
         "any": [
          {
           "has": [
            "$opt.parents",
            "$d.parent"
           ]
          },
          {
           "not": {
            "set": "$d.parent"
           }
          }
         ]
        }
       }
      },
      {
       "id": "likely",
       "label": "likely_q",
       "max": 1,
       "options": {
        "list": "likely"
       },
       "showWhen": {
        "all": [
         {
          "set": "$a.threat"
         },
         {
          "not": {
           "eq": [
            "$a.threat",
            "none"
           ]
          }
         }
        ]
       }
      },
      {
       "id": "through",
       "label": "through_q",
       "max": 1,
       "options": {
        "list": "through"
       },
       "showWhen": {
        "all": [
         {
          "all": [
           {
            "set": "$a.threat"
           },
           {
            "not": {
             "eq": [
              "$a.threat",
              "none"
             ]
            }
           }
          ]
         },
         {
          "set": "$a.likely"
         }
        ]
       },
       "links": [
        {
         "exit": "cope_ahead",
         "label": "through_cope_ahead",
         "when": {
          "set": "$a.through"
         }
        }
       ]
      }
     ],
     "next": [
      {
       "to": "fits",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "fits",
     "kind": "ask",
     "title": [
      {
       "when": {
        "set": "$d.fitsParent"
       },
       "key": "fits_title"
      },
      {
       "key": "fits_title_general"
      }
     ],
     "titleSlots": {
      "feeling": {
       "labelOf": "feel"
      }
     },
     "fields": [
      {
       "id": "fits",
       "options": {
        "list": "fits"
       },
       "max": 1,
       "required": true,
       "askFresh": "fitsFacts",
       "list": {
        "table": "fitsWhen",
        "key": "$d.fitsParent"
       }
      }
     ],
     "next": [
      {
       "to": "next",
       "when": null
      }
     ],
     "offers": []
    },
    {
     "id": "next",
     "kind": "handoff",
     "complete": true,
     "lines": [
      {
       "when": {
        "eq": [
         "$a.fits",
         "fits"
        ]
       },
       "key": "next_fits"
      },
      {
       "when": {
        "eq": [
         "$a.fits",
         "partly"
        ]
       },
       "key": "next_partly"
      },
      {
       "when": {
        "eq": [
         "$a.fits",
         "doesnt_fit"
        ]
       },
       "key": "next_no"
      },
      {
       "when": {
        "eq": [
         "$a.fits",
         "unsure"
        ]
       },
       "key": "next_unsure"
      }
     ],
     "done": "done",
     "next": [],
     "offers": [
      {
       "exit": "problem_solve",
       "when": {
        "eq": [
         "$a.fits",
         "fits"
        ]
       }
      },
      {
       "exit": "dear_man",
       "when": {
        "all": [
         {
          "eq": [
           "$a.fits",
           "fits"
          ]
         },
         {
          "in": [
           "$a.event",
           [
            "said",
            "didnt"
           ]
          ]
         }
        ]
       }
      },
      {
       "exit": "opposite_action",
       "when": {
        "in": [
         "$a.fits",
         [
          "partly",
          "doesnt_fit"
         ]
        ]
       }
      },
      {
       "exit": "problem_solve",
       "when": {
        "eq": [
         "$a.fits",
         "partly"
        ]
       }
      },
      {
       "exit": "wise_mind",
       "when": {
        "eq": [
         "$a.fits",
         "unsure"
        ]
       }
      }
     ]
    }
   ],
